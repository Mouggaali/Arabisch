  "grammatica": [
    {
      "titel": "Werkwoorden met een vast voorzetsel",
      "blokken": [
        {
          "type": "tekst",
          "md": [
            "Werkwoorden van beweging hebben in het Arabisch een **vast voorzetsel**, net als in het Nederlands (*gaan naar*, *komen uit*). Leer het werkwoord en het voorzetsel samen."
          ]
        },
        {
          "type": "tabel",
          "kop": [
            "Werkwoord + voorzetsel",
            "Betekenis",
            "Voorbeeld"
          ],
          "arKolommen": [
            0,
            2
          ],
          "rijen": [
            [
              "ذَهَبَ إِلى|ḏahaba ilā",
              "gaan naar",
              "ذَهَبْتُ إِلى المَطارِ|ḏahabtu ila l-maṭār"
            ],
            [
              "وَصَلَ إِلى|waṣala ilā",
              "aankomen in",
              "وَصَلْنا إِلى الرِّباطِ|waṣalnā ila r-ribāṭ"
            ],
            [
              "رَجَعَ مِنْ|rajaʿa min",
              "terugkomen uit",
              "رَجَعَتْ مِنْ مِصْرَ|rajaʿat min miṣr"
            ],
            [
              "خَرَجَ مِنْ|ḫaraja min",
              "weggaan uit",
              "خَرَجَ مِنَ المَحَطَّةِ|ḫaraja mina l-maḥaṭṭa"
            ],
            [
              "سافَرَ إِلى|sāfara ilā",
              "reizen naar",
              "سافَرُوا إِلى تونِسَ|sāfarū ilā tūnis"
            ],
            [
              "غادَرَ (zonder voorzetsel)|ġādara",
              "verlaten",
              "غادَرَتِ الطّائِرَةُ المَطارَ|ġādarati ṭ-ṭāʾiratu l-maṭār"
            ]
          ]
        },
        {
          "type": "waarom",
          "md": "{ar|غادَرَ} neemt een **lijdend voorwerp** (accusatief), net als het Nederlandse *verlaten*: {ar|غادَرَ المَدينَةَ} = *hij verliet de stad*. Andere bewegingswerkwoorden hebben een voorzetsel nodig."
        }
      ]
    },
    {
      "titel": "Met de trein: بِـ + vervoermiddel",
      "blokken": [
        {
          "type": "tekst",
          "md": [
            "Waarmee je reist, zeg je met **بِـ** + vervoermiddel (met ال, genitief): {ar|بِالقِطارِ} (*met de trein*), {ar|بِالطّائِرَةِ} (*met het vliegtuig*). Te voet is {ar|مَشْيًا}. Een route beschrijf je met {ar|مِنْ ... إِلى}."
          ]
        },
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "سافَرْنا مِنْ أَمْسْتِرْدام إِلى الدّارِ البَيْضاءِ بِالطّائِرَةِ.",
              "tr": "sāfarnā min Amstirdām ila d-Dāri l-Bayḍāʾ bi-ṭ-ṭāʾira.",
              "nl": "We vlogen van Amsterdam naar Casablanca.",
              "review": {
                "status": "onzeker",
                "note": "Stadsnamen أَمْسْتِرْدام en الدّارُ البَيْضاءُ (Casablanca) laten controleren."
              }
            },
            {
              "ar": "أَذْهَبُ إِلى العَمَلِ مَشْيًا لِأَنَّهُ قَريبٌ.",
              "tr": "aḏhabu ila l-ʿamali mašyan li-annahu qarīb.",
              "nl": "Ik ga te voet naar mijn werk, omdat het dichtbij is."
            },
            {
              "ar": "المَطارُ بَعيدٌ عَنِ المَدينَةِ.",
              "tr": "al-maṭāru baʿīdun ʿani l-madīna.",
              "nl": "Het vliegveld ligt ver van de stad."
            },
            {
              "ar": "هُناكَ تَأْخيرٌ، القِطارُ لَمْ يَصِلْ بَعْدُ.",
              "tr": "hunāka taʾḫīr, al-qiṭāru lam yaṣil baʿd.",
              "nl": "Er is vertraging, de trein is nog niet aangekomen.",
              "review": {
                "status": "onzeker",
                "note": "لَمْ يَصِلْ (les 51) als voorproefje; controleren."
              }
            }
          ]
        }
      ]
    }
  ],
