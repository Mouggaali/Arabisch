    {
      "titel": "Drie ontkenningen",
      "blokken": [
        {
          "type": "tabel",
          "kop": [
            "Woord",
            "Wanneer",
            "Voorbeeld"
          ],
          "arKolommen": [
            0,
            2
          ],
          "rijen": [
            [
              "لَيْسَ",
              "zin zonder werkwoord (nominaal), vervoegd",
              "لَسْتُ مُتْعَبًا.|lastu mutʿaban."
            ],
            [
              "لا",
              "+ muḍāriʿ (heden)",
              "لا أَعْرِفُ.|lā aʿrif."
            ],
            [
              "ما",
              "+ māḍī (verleden)",
              "ما فَهِمْتُ.|mā fahimtu."
            ]
          ]
        },
        {
          "type": "waarom",
          "md": "Welke ontkenning past, hangt af van de **soort zin**: zonder werkwoord {ar|لَيْسَ} (met accusatief erna), met een muḍāriʿ {ar|لا}, met een māḍī {ar|ما}. In les 51 komt er een vierde bij, {ar|لَمْ}, de gebruikelijke ontkenning van het verleden in geschreven Arabisch."
        },
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "وُلِدْتُ في طَنْجَةَ وَانْتَقَلْتُ إِلى هولَنْدا في طُفولَتي.",
              "tr": "wulidtu fī Ṭanjata wa-ntaqaltu ilā Hōlandā fī ṭufūlatī.",
              "nl": "Ik ben geboren in Tanger en als kind naar Nederland verhuisd."
            },
            {
              "ar": "تَخَرَّجْتُ مِنَ الجامِعَةِ قَبْلَ خَمْسِ سَنَواتٍ.",
              "tr": "taḫarrajtu mina l-jāmiʿati qabla ḫamsi sanawāt.",
              "nl": "Ik ben vijf jaar geleden afgestudeerd."
            },
            {
              "ar": "لَسْتُ مُتَزَوِّجًا، لٰكِنْ عِنْدي صَديقَةٌ.",
              "tr": "lastu mutazawwijan, lākin ʿindī ṣadīqa.",
              "nl": "Ik ben niet getrouwd, maar ik heb een vriendin."
            },
            {
              "ar": "حُلْمي أَنْ أَعيشَ في المَغْرِبِ في المُسْتَقْبَلِ.",
              "tr": "ḥulmī an aʿīša fi l-Maġribi fi l-mustaqbal.",
              "nl": "Mijn droom is om in de toekomst in Marokko te wonen."
            }
          ]
        }
      ]
    }
