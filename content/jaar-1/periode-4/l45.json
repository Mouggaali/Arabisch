  "grammatica": [
    {
      "titel": "De vergrotende trap: أَفْعَلُ مِنْ",
      "blokken": [
        {
          "type": "tekst",
          "md": [
            "Neem de drie wortelletters van het bijvoeglijk naamwoord en zet ze in het patroon **أَفْعَلُ**: {ar|كَبيرٌ} (k-b-r) → {ar|أَكْبَرُ}. *Dan* is {ar|مِنْ}.",
            "De vorm **verandert niet** voor vrouwelijk of meervoud: {ar|هُوَ أَكْبَرُ}، {ar|هِيَ أَكْبَرُ}، {ar|هُمْ أَكْبَرُ}. En hij krijgt geen tanwīn."
          ]
        },
        {
          "type": "tabel",
          "kop": [
            "Bijvoeglijk nw",
            "Wortel",
            "Vergrotende trap"
          ],
          "arKolommen": [
            0,
            1,
            2
          ],
          "rijen": [
            [
              "كَبيرٌ",
              "ك ب ر",
              "أَكْبَرُ|akbar"
            ],
            [
              "جَميلٌ",
              "ج م ل",
              "أَجْمَلُ|ajmal"
            ],
            [
              "واسِعٌ",
              "و س ع",
              "أَوْسَعُ|awsaʿ"
            ],
            [
              "غالٍ",
              "غ ل و",
              "أَغْلى|aġlā"
            ],
            [
              "قَليلٌ",
              "ق ل ل",
              "أَقَلُّ|aqall"
            ]
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom verandert {ar|أَكْبَرُ} niet mee? Het patroon أَفْعَلُ is van oorsprong een soort zelfstandig gebruikt woord (*een grotere*), en in de constructie met {ar|مِنْ} blijft het altijd in deze basisvorm. Dat maakt het makkelijk: één vorm voor iedereen."
        },
        {
          "type": "letop",
          "md": "Eindigt de wortel op و of ي, dan eindigt de vorm op **ى** ({ar|أَغْلى}). Zijn de laatste twee wortelletters gelijk, dan smelten ze samen met een shadda ({ar|أَقَلُّ}، {ar|أَشَدُّ})."
        }
      ]
    },
    {
      "titel": "Als het patroon niet past: أَكْثَرُ + accusatief",
      "blokken": [
        {
          "type": "tekst",
          "md": "Bijvoeglijke naamwoorden met meer dan drie wortelletters, zoals {ar|مُريحٌ} (comfortabel) of {ar|مُزْعِجٌ} (storend), passen niet in أَفْعَلُ. Dan gebruik je {ar|أَكْثَرُ} (*meer*) of {ar|أَقَلُّ} (*minder*) + het zelfstandig naamwoord in de **accusatief**: {ar|أَكْثَرُ راحَةً} (*comfortabeler*, letterlijk: meer qua comfort)."
        },
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "بَيْتُنا الجَديدُ أَكْبَرُ مِنْ بَيْتِنا القَديمِ.",
              "tr": "baytunā l-jadīdu akbaru min baytinā l-qadīm.",
              "nl": "Ons nieuwe huis is groter dan ons oude huis."
            },
            {
              "ar": "الإيجارُ في القَرْيَةِ أَرْخَصُ مِنْهُ في المَدينَةِ.",
              "tr": "al-ījāru fi l-qaryati arḫaṣu minhu fi l-madīna.",
              "nl": "De huur in het dorp is lager dan in de stad.",
              "review": {
                "status": "onzeker",
                "note": "Constructie مِنْهُ (dan die) controleren."
              }
            },
            {
              "ar": "هٰذا الحَيُّ أَهْدَأُ، لٰكِنَّهُ أَبْعَدُ مِنَ المَحَطَّةِ.",
              "tr": "hāḏa l-ḥayyu ahdaʾu, lākinnahu abʿadu mina l-maḥaṭṭa.",
              "nl": "Deze wijk is rustiger, maar hij ligt verder van het station."
            },
            {
              "ar": "الشَّقَّةُ الجَديدَةُ أَكْثَرُ راحَةً.",
              "tr": "aš-šaqqatu l-jadīdatu akṯaru rāḥa.",
              "nl": "Het nieuwe appartement is comfortabeler."
            },
            {
              "ar": "أُخْتي أَصْغَرُ مِنّي.",
              "tr": "uḫtī aṣġaru minnī.",
              "nl": "Mijn zus is jonger dan ik."
            }
          ]
        }
      ]
    }
  ],
