  "grammatica": [
    {
      "titel": "Voornaamwoorden als lijdend voorwerp",
      "blokken": [
        {
          "type": "tekst",
          "md": [
            "*Ik heb hem bedankt* zeg je met een achtervoegsel aan het werkwoord: {ar|شَكَرْتُهُ} (*šakartu-hu*). Het zijn dezelfde achtervoegsels als bij bezit ({ar|بَيْتُهُ}) en bij {ar|عِنْدَهُ}.",
            "Eén verschil: *mij* is bij een werkwoord **ـني** (niet ـي): {ar|يَسْأَلُني} (*hij vraagt mij*), {ar|شَكَرَني} (*hij bedankte mij*)."
          ]
        },
        {
          "type": "tabel",
          "kop": [
            "Lijdend voorwerp",
            "Achtervoegsel",
            "Voorbeeld",
            "Nederlands"
          ],
          "arKolommen": [
            1,
            2
          ],
          "rijen": [
            [
              "mij",
              "ـني|-nī",
              "يَسْأَلُني|yasʾalunī",
              "hij vraagt mij"
            ],
            [
              "jou (m)",
              "ـكَ|-ka",
              "أَنْتَظِرُكَ|antaẓiruka",
              "ik wacht op jou"
            ],
            [
              "jou (v)",
              "ـكِ|-ki",
              "أَعْرِفُكِ|aʿrifuki",
              "ik ken jou"
            ],
            [
              "hem / het",
              "ـهُ|-hu",
              "شَكَرْتُهُ|šakartuhu",
              "ik bedankte hem"
            ],
            [
              "haar",
              "ـها|-hā",
              "أُساعِدُها|usāʿiduhā",
              "ik help haar"
            ],
            [
              "ons",
              "ـنا|-nā",
              "يَفْهَمُنا|yafhamunā",
              "hij begrijpt ons"
            ],
            [
              "jullie",
              "ـكُمْ|-kum",
              "سَأَنْتَظِرُكُمْ|sa-antaẓirukum",
              "ik zal op jullie wachten"
            ],
            [
              "hen",
              "ـهُمْ|-hum",
              "سَمِعْناهُمْ|samiʿnāhum",
              "wij hoorden hen"
            ]
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom ـني in plaats van ـي? Een werkwoord eindigt meestal op een klinker ({ar|يَسْأَلُ}, *yasʾalu*). Met ـي direct erachter zou die klinker verdwijnen en de vorm onherkenbaar worden. De extra **n** (*nūn al-wiqāya*, de beschermende n) houdt de vorm van het werkwoord intact."
        },
        {
          "type": "letop",
          "md": "Het voornaamwoord *het* verwijst naar een ding: {ar|قَرَأْتُ التَّقْريرَ} → {ar|قَرَأْتُهُ} (*ik heb het gelezen*). Bij een vrouwelijk ding of een meervoud van dingen gebruik je ـها: {ar|كَتَبْتُ الرِّسالَةَ} → {ar|كَتَبْتُها}."
        }
      ]
    },
    {
      "titel": "Op het werk",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "يَبْدَأُ دَوامي في السّاعَةِ الثّامِنَةِ.",
              "tr": "yabdaʾu dawāmī fi s-sāʿati ṯ-ṯāmina.",
              "nl": "Mijn werkdag begint om acht uur."
            },
            {
              "ar": "سَأَلَني المُديرُ عَنِ التَّقْريرِ، فَأَرْسَلْتُهُ.",
              "tr": "saʾalanī l-mudīru ʿani t-taqrīri, fa-arsaltuh.",
              "nl": "De directeur vroeg me naar het rapport, dus ik heb het gestuurd.",
              "review": {
                "status": "onzeker",
                "note": "أَرْسَلَ (vorm IV) en فَـ (dus) zijn nieuw; controleren of dit voorbeeld niet te vroeg komt."
              }
            },
            {
              "ar": "زَميلَتي تُساعِدُني دائِمًا.",
              "tr": "zamīlatī tusāʿidunī dāʾiman.",
              "nl": "Mijn collega helpt mij altijd."
            },
            {
              "ar": "عِنْدي اِجْتِماعٌ مَعَ زَبونٍ مُهِمٍّ.",
              "tr": "ʿindī jtimāʿun maʿa zabūnin muhimm.",
              "nl": "Ik heb een vergadering met een belangrijke klant."
            },
            {
              "ar": "سَأَتَّصِلُ بِكَ بَعْدَ الاِجْتِماعِ.",
              "tr": "sa-attaṣilu bika baʿda l-ijtimāʿ.",
              "nl": "Ik bel je na de vergadering."
            }
          ]
        }
      ]
    }
