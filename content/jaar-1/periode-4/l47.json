  "grammatica": [
    {
      "titel": "De tekst: Een dag van Sāmī",
      "blokken": [
        {
          "type": "tekst",
          "md": "Lees de tekst eerst helemaal, zonder de vertaling. Speel dan elke zin af, en kijk pas daarna naar het Nederlands. Let vooral op de voegwoorden: {ar|وَ}, {ar|ثُمَّ}, {ar|فَـ}, {ar|لٰكِنَّ} en {ar|لِأَنَّ}."
        },
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "يَسْتَيْقِظُ سامي كُلَّ يَوْمٍ في السّاعَةِ السّادِسَةِ وَالنِّصْفِ.",
              "tr": "yastayqiẓu Sāmī kulla yawmin fi s-sāʿati s-sādisati wa-n-niṣf.",
              "nl": "Sāmī wordt elke dag om half zeven wakker."
            },
            {
              "ar": "يَغْسِلُ وَجْهَهُ، ثُمَّ يَشْرَبُ فِنْجانَ قَهْوَةٍ.",
              "tr": "yaġsilu wajhahu, ṯumma yašrabu finjāna qahwa.",
              "nl": "Hij wast zijn gezicht en drinkt daarna een kopje koffie."
            },
            {
              "ar": "لا يَأْكُلُ كَثيرًا في الصَّباحِ، لِأَنَّهُ لَيْسَ جائِعًا.",
              "tr": "lā yaʾkulu kaṯīran fi ṣ-ṣabāḥ, li-annahu laysa jāʾiʿan.",
              "nl": "Hij eet 's ochtends niet veel, omdat hij geen honger heeft."
            },
            {
              "ar": "يَخْرُجُ مِنَ البَيْتِ في السّاعَةِ السّابِعَةِ وَيَذْهَبُ إِلى المَحَطَّةِ مَشْيًا.",
              "tr": "yaḫruju mina l-bayti fi s-sāʿati s-sābiʿati wa-yaḏhabu ila l-maḥaṭṭati mašyan.",
              "nl": "Hij gaat om zeven uur de deur uit en loopt naar het station."
            },
            {
              "ar": "يَعْمَلُ سامي مُهَنْدِسًا في شَرِكَةٍ كَبيرَةٍ في وَسَطِ المَدينَةِ.",
              "tr": "yaʿmalu Sāmī muhandisan fī šarikatin kabīratin fī wasaṭi l-madīna.",
              "nl": "Sāmī werkt als ingenieur bij een groot bedrijf in het centrum.",
              "review": {
                "status": "onzeker",
                "note": "يَعْمَلُ مُهَنْدِسًا (ḥāl, accusatief) controleren."
              }
            },
            {
              "ar": "عَمَلُهُ مُمْتِعٌ، لٰكِنَّهُ مُتْعِبٌ أَحْيانًا.",
              "tr": "ʿamaluhu mumtiʿun, lākinnahu mutʿibun aḥyānan.",
              "nl": "Zijn werk is leuk, maar soms vermoeiend."
            },
            {
              "ar": "في الظُّهْرِ يَأْكُلُ مَعَ زُمَلائِهِ في مَطْعَمٍ صَغيرٍ.",
              "tr": "fi ẓ-ẓuhri yaʾkulu maʿa zumalāʾihi fī maṭʿamin ṣaġīr.",
              "nl": "Tussen de middag eet hij met zijn collega's in een klein restaurant."
            },
            {
              "ar": "يَعودُ إِلى البَيْتِ في السّاعَةِ الخامِسَةِ، فَيَطْبُخُ العَشاءَ.",
              "tr": "yaʿūdu ila l-bayti fi s-sāʿati l-ḫāmisa, fa-yaṭbuḫu l-ʿašāʾ.",
              "nl": "Om vijf uur komt hij thuis, en dan kookt hij meteen het avondeten."
            },
            {
              "ar": "بَعْدَ العَشاءِ يَتَّصِلُ بِأُمِّهِ، لِأَنَّها تَسْكُنُ وَحْدَها في طَنْجَةَ.",
              "tr": "baʿda l-ʿašāʾi yattaṣilu bi-ummih, li-annahā taskunu waḥdahā fī Ṭanja.",
              "nl": "Na het eten belt hij zijn moeder, omdat zij alleen in Tanger woont."
            },
            {
              "ar": "ثُمَّ يَقْرَأُ قَليلًا أَوْ يُشاهِدُ التِّلْفازَ.",
              "tr": "ṯumma yaqraʾu qalīlan aw yušāhidu t-tilfāz.",
              "nl": "Daarna leest hij wat of kijkt hij tv."
            },
            {
              "ar": "يُحِبُّ سامي يَوْمَ الجُمُعَةِ، لِأَنَّهُ يَلْعَبُ كُرَةَ القَدَمِ مَعَ أَصْدِقائِهِ.",
              "tr": "yuḥibbu Sāmī yawma l-jumuʿa, li-annahu yalʿabu kurata l-qadami maʿa aṣdiqāʾih.",
              "nl": "Sāmī houdt van vrijdag, omdat hij dan voetbalt met zijn vrienden."
            },
            {
              "ar": "أَمْسِ كانَ مُتْعَبًا جِدًّا، فَنامَ في السّاعَةِ التّاسِعَةِ.",
              "tr": "amsi kāna mutʿaban jiddan, fa-nāma fi s-sāʿati t-tāsiʿa.",
              "nl": "Gisteren was hij erg moe, dus ging hij om negen uur slapen."
            }
          ]
        }
      ]
    },
