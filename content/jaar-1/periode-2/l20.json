  "grammatica": [
    {
      "titel": "De muḍāriʿ in het meervoud",
      "blokken": [
        { "type": "tekst", "md": [
          "In het meervoud gebruik je dezelfde voorvoegsels (نَـ voor *wij*, تَـ voor *jullie*, يَـ voor *zij*). Twee nieuwe uitgangen geven aan of het om mannen of vrouwen gaat: **ـونَ** (mannelijk of gemengd) en **ـْنَ** (alleen vrouwen)."
        ] },
        { "type": "tabel", "kop": ["Persoon", "Vorm", "Nederlands"], "arKolommen": [0, 1], "rijen": [
          ["نَحْنُ", "نَكْتُبُ|naktubu", "wij schrijven"],
          ["أَنْتُمْ", "تَكْتُبونَ|taktubūna", "jullie (m) schrijven"],
          ["أَنْتُنَّ", "تَكْتُبْنَ|taktubna", "jullie (v) schrijven"],
          ["هُمْ", "يَكْتُبونَ|yaktubūna", "zij (m) schrijven"],
          ["هُنَّ", "يَكْتُبْنَ|yaktubna", "zij (v) schrijven"]
        ] },
        { "type": "tabel", "kop": ["Persoon", "Enkelvoud", "Meervoud"], "arKolommen": [1, 2], "rijen": [
          ["1e", "أَكْتُبُ|aktubu · ik", "نَكْتُبُ|naktubu · wij"],
          ["2e m", "تَكْتُبُ|taktubu · jij", "تَكْتُبونَ|taktubūna · jullie"],
          ["2e v", "تَكْتُبِينَ|taktubīna · jij", "تَكْتُبْنَ|taktubna · jullie"],
          ["3e m", "يَكْتُبُ|yaktubu · hij", "يَكْتُبونَ|yaktubūna · zij"],
          ["3e v", "تَكْتُبُ|taktubu · zij", "يَكْتُبْنَ|yaktubna · zij"]
        ] },
        { "type": "waarom", "md": "De uitgangen lijken op de voornaamwoorden: ـونَ heeft de *u* van {ar|هُمْ} en {ar|أَنْتُمْ}, ـْنَ heeft de *n* van {ar|هُنَّ} en {ar|أَنْتُنَّ}. Voor gemengde groepen gebruik je, net als bij de voornaamwoorden, de mannelijke vorm." },
        { "type": "letop", "md": "*Zij (v mv)* begint met يَـ, net als *hij*: {ar|يَكْتُبْنَ}. Het is dus niet تَـ zoals bij *zij (ev)*." }
      ]
    },
    {
      "titel": "Ontkennen met لا",
      "blokken": [
        { "type": "tekst", "md": [
          "Een werkwoord in de tegenwoordige tijd ontken je door **{ar|لا}** ervoor te zetten. Het werkwoord zelf verandert niet: {ar|أَفْهَمُ} → {ar|لا أَفْهَمُ} (*ik begrijp het niet*).",
          "{ar|لَيْسَ} (les 12) gebruik je bij een zin **zonder** werkwoord; {ar|لا} bij een zin **met** een werkwoord in de muḍāriʿ."
        ] },
        { "type": "voorbeelden", "items": [
          { "ar": "لا أَعْرِفُ.", "tr": "lā aʿrif.", "nl": "Ik weet het niet." },
          { "ar": "هِيَ لا تَعْمَلُ يَوْمَ الجُمُعَةِ.", "tr": "hiya lā taʿmalu yawma l-jumuʿa.", "nl": "Zij werkt niet op vrijdag." },
          { "ar": "نَحْنُ نَدْرُسُ العَرَبِيَّةَ مَعًا.", "tr": "naḥnu nadrusu l-ʿarabiyyata maʿan.", "nl": "Wij studeren samen Arabisch." },
          { "ar": "هَلْ تَرْكَبونَ الحافِلَةَ؟ — لا، نَرْكَبُ القِطارَ.", "tr": "hal tarkabūna l-ḥāfila? — lā, narkabu l-qiṭār.", "nl": "Nemen jullie de bus? — Nee, we nemen de trein." },
          { "ar": "البَناتُ يَلْعَبْنَ في الحَديقَةِ.", "tr": "al-banātu yalʿabna fi l-ḥadīqa.", "nl": "De meisjes spelen in de tuin.",
            "review": { "status": "onzeker", "note": "Onderwerp vóór het werkwoord met volledige congruentie (يَلْعَبْنَ). In een verbale zin (les 27) wordt dit تَلْعَبُ البَناتُ. Controleren of dit voorbeeld hier niet verwart." } },
          { "ar": "هُمْ لا يَقْرَؤونَ الصَّحيفَةَ، يَسْمَعونَ الأَخْبارَ.", "tr": "hum lā yaqraʾūna ṣ-ṣaḥīfa, yasmaʿūna l-aḫbār.", "nl": "Zij lezen de krant niet, ze luisteren naar het nieuws.",
            "review": { "status": "onzeker", "note": "يَقْرَؤونَ (hamza-werkwoord) is spellingtechnisch lastig; controleer de hamza-spelling (يَقْرَؤونَ / يَقْرَأونَ)." } }
        ] },
        { "type": "waarom", "md": "Het Arabisch heeft verschillende ontkenningswoorden voor verschillende tijden en zinssoorten. Dat lijkt veel, maar het maakt zinnen ook duidelijk: aan het ontkenningswoord zie je al welke tijd er komt. Later leer je {ar|ما} (verleden tijd), {ar|لَمْ} en {ar|لَنْ}." }
      ]
    }
  ],

