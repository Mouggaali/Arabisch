  "grammatica": [
    {
      "titel": "De māḍī in het meervoud",
      "blokken": [
        { "type": "tekst", "md": [
          "In het meervoud komen er vijf nieuwe uitgangen bij. Net als in het enkelvoud lijken ze op de voornaamwoorden: ـْنا (wij, vgl. {ar|نَحْنُ}), ـْتُمْ (jullie m, vgl. {ar|أَنْتُمْ}), ـْتُنَّ (jullie v, vgl. {ar|أَنْتُنَّ}), ـُوا (zij m), ـْنَ (zij v)."
        ] },
        { "type": "tabel", "kop": ["Persoon", "Enkelvoud", "Meervoud"], "arKolommen": [1, 2], "rijen": [
          ["1e", "كَتَبْتُ|katabtu · ik", "كَتَبْنا|katabnā · wij"],
          ["2e m", "كَتَبْتَ|katabta · jij", "كَتَبْتُمْ|katabtum · jullie"],
          ["2e v", "كَتَبْتِ|katabti · jij", "كَتَبْتُنَّ|katabtunna · jullie"],
          ["3e m", "كَتَبَ|kataba · hij", "كَتَبُوا|katabū · zij"],
          ["3e v", "كَتَبَتْ|katabat · zij", "كَتَبْنَ|katabna · zij"]
        ] },
        { "type": "letop", "md": "In {ar|كَتَبُوا} staat na de و een **alif die je niet uitspreekt**: *katabū*. Je schrijft hem wel altijd." },
        { "type": "waarom", "md": "Die stille alif (*alif al-fāriqa*, de onderscheidende alif) is een oude schrijfafspraak: hij laat zien dat de و hier de meervoudsuitgang is en niet bij de stam hoort. Hij heeft geen klank en geen grammaticale functie, maar zonder alif is het een spelfout." }
      ]
    },
    {
      "titel": "Vertellen over het weekend",
      "blokken": [
        { "type": "voorbeelden", "items": [
          { "ar": "يَوْمَ السَّبْتِ رَكِبْنا القِطارَ وَذَهَبْنا إِلى البَحْرِ.", "tr": "yawma s-sabti rakibnā l-qiṭāra wa-ḏahabnā ila l-baḥr.", "nl": "Op zaterdag namen we de trein en gingen we naar zee." },
          { "ar": "لَعِبَ الأَطْفالُ عَلى الشّاطِئِ.", "tr": "laʿiba l-aṭfālu ʿala š-šāṭiʾ.", "nl": "De kinderen speelden op het strand." },
          { "ar": "هَلْ ذَهَبْتُمْ إِلى المُتْحَفِ؟ — لا، ذَهَبْنا إِلى السّينَما.", "tr": "hal ḏahabtum ila l-mutḥaf? — lā, ḏahabnā ila s-sīnamā.", "nl": "Zijn jullie naar het museum gegaan? — Nee, we gingen naar de bioscoop." },
          { "ar": "هُمْ وَصَلُوا مُتَأَخِّرينَ.", "tr": "hum waṣalū mutaʾaḫḫirīn.", "nl": "Zij kwamen te laat aan." },
          { "ar": "البَناتُ رَسَمْنَ صُوَرًا جَميلَةً.", "tr": "al-banātu rasamna ṣuwaran jamīla.", "nl": "De meisjes tekenden mooie plaatjes.",
            "review": { "status": "onzeker", "note": "Onderwerp vóór het werkwoord (volledige congruentie رَسَمْنَ). Controleer; verbale zin met werkwoord eerst wordt in les 27 behandeld." } },
          { "ar": "كانَتِ الرِّحْلَةُ مُمْتِعَةً جِدًّا.", "tr": "kānati r-riḥlatu mumtiʿatan jiddan.", "nl": "Het uitstapje was heel leuk." }
        ] },
        { "type": "letop", "md": "In {ar|لَعِبَ الأَطْفالُ} staat het werkwoord vóór het onderwerp en blijft het **enkelvoud**, hoewel er meerdere kinderen zijn. Dat is de verbale zin, die je in les 27 leert." }
      ]
    }
