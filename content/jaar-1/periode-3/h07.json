        { "type": "luisteren", "tag": "madi-meervoud", "tekst": "هَلْ أَكَلْتُمْ؟", "vraag": "Wat wordt er gevraagd?", "opties": ["Hebben jullie gegeten?", "Eten jullie?", "Hebben zij gegeten?"], "juist": 0, "uitleg": "ـْتُمْ = jullie (m), verleden." }
      ]
    },
