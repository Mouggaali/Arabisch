      { "type": "meerkeuze", "tag": "kana-accusatief", "vraag": "'De les was moeilijk' is ...", "opties": ["كانَ الدَّرْسُ صَعْبًا.", "كانَ الدَّرْسُ صَعْبٌ.", "كانَ الدَّرْسَ صَعْبًا."], "juist": 0, "uitleg": "Onderwerp -u, gezegde -an." },
      { "type": "luisteren", "tag": "madi-enkelvoud", "tekst": "طَبَخْتُ العَشاءَ", "vraag": "Wat hoor je?", "opties": ["Ik kookte het avondeten.", "Zij kookte het avondeten.", "Ik kook het avondeten."], "juist": 0, "uitleg": "ـْتُ = ik." },
