        { "type": "invullen", "tag": "kana-accusatief", "zin": "كانَ الطَّعامُ ___.", "nl": "Het eten was lekker.", "woordbank": ["لَذيذًا", "لَذيذٌ", "اللَّذيذُ"], "antwoord": ["لَذيذًا"], "uitleg": "Na {ar|كانَ}: accusatief." },
        { "type": "invullen", "tag": "kana-hebben", "zin": "___ عِنْدي امْتِحانٌ أَمْسِ.", "nl": "Ik had gisteren een examen.", "woordbank": ["كانَ", "كُنْتُ", "كانَتْ"], "antwoord": ["كانَ"], "uitleg": "{ar|كانَ} past zich aan {ar|امْتِحانٌ} aan." },
        { "type": "ordenen", "tag": "madi-meervoud", "nl": "We namen de bus en gingen naar het strand.", "woorden": ["رَكِبْنا", "الحافِلَةَ", "وَذَهَبْنا", "إِلى", "الشّاطِئِ."], "uitleg": "Twee keer wij-vorm." },
        { "type": "ordenen", "tag": "kana", "nl": "We kwamen 's avonds terug en waren moe.", "woorden": ["رَجَعْنا", "مَساءً", "وَكُنّا", "مُتْعَبينَ."], "uitleg": "{ar|كُنّا} + accusatief meervoud." },
        { "type": "meerkeuze", "tag": "darija-fusha", "vraag": "Het Darija voor {ar|نَعَمْ} is ...", "opties": ["إيه", "واخا", "بزاف"], "juist": 0, "uitleg": "{ar|إيه} (*īh*)." }
      ]
    },
    {
