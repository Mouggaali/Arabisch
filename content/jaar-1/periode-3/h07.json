{
  "id": "j1-p3-h07",
  "code": "H07",
  "type": "herhaling",
  "titel": "Herhaling 3A",
  "thema": "De verleden tijd, de verbale zin en كانَ",
  "translitStandaard": false,
  "leerdoelen": [
    "de māḍī in alle tien personen vervoegen en ontkennen met ما.",
    "verbale en nominale zinnen correct laten congrueren.",
    "zijn en hebben in de verleden tijd gebruiken met كانَ.",
    "vertellen wat er gisteren of vorig weekend gebeurde."
  ],
  "woorden": [],
  "woordenUitleg": "Geen nieuwe woorden. Herhaal de werkwoorden van les 25 tot en met 28 steeds als paar: māḍī en muḍāriʿ.",

  "grammatica": [
    {
      "titel": "Muḍāriʿ en māḍī naast elkaar",
      "blokken": [
        { "type": "tabel", "kop": ["Persoon", "Muḍāriʿ", "Māḍī"], "arKolommen": [1, 2], "rijen": [
          ["ik", "أَكْتُبُ", "كَتَبْتُ"],
          ["jij (m)", "تَكْتُبُ", "كَتَبْتَ"],
          ["jij (v)", "تَكْتُبِينَ", "كَتَبْتِ"],
          ["hij", "يَكْتُبُ", "كَتَبَ"],
          ["zij", "تَكْتُبُ", "كَتَبَتْ"],
          ["wij", "نَكْتُبُ", "كَتَبْنا"],
          ["jullie (m)", "تَكْتُبونَ", "كَتَبْتُمْ"],
          ["jullie (v)", "تَكْتُبْنَ", "كَتَبْتُنَّ"],
          ["zij (m)", "يَكْتُبونَ", "كَتَبُوا"],
          ["zij (v)", "يَكْتُبْنَ", "كَتَبْنَ"]
        ] },
        { "type": "waarom", "md": "Muḍāriʿ: de persoon zit vooral **vooraan** (أَ، تَـ، يَـ، نَـ). Māḍī: de persoon zit **achteraan** (ـْتُ، ـْتَ، ـَتْ، ـْنا ...). Ontkennen: {ar|لا} + muḍāriʿ, {ar|ما} + māḍī. In de vervoegingstrainer kun je beide tijden voor 20 werkwoorden oefenen." }
      ]
    },
    {
      "titel": "Een verhaal in de verleden tijd",
      "blokken": [
        { "type": "voorbeelden", "items": [
          { "ar": "كانَ الجَوُّ جَميلًا يَوْمَ السَّبْتِ.", "tr": "kāna l-jawwu jamīlan yawma s-sabt.", "nl": "Het weer was mooi op zaterdag." },
          { "ar": "رَكِبْنا الحافِلَةَ وَذَهَبْنا إِلى الشّاطِئِ.", "tr": "rakibnā l-ḥāfilata wa-ḏahabnā ila š-šāṭiʾ.", "nl": "We namen de bus en gingen naar het strand." },
          { "ar": "لَعِبَ الأَطْفالُ وَشَرِبَتْ أُمّي الشّايَ.", "tr": "laʿiba l-aṭfālu wa-šaribat ummī š-šāy.", "nl": "De kinderen speelden en mijn moeder dronk thee." },
          { "ar": "ما كانَ عِنْدَنا وَقْتٌ لِلْمُتْحَفِ.", "tr": "mā kāna ʿindanā waqtun li-l-mutḥaf.", "nl": "We hadden geen tijd voor het museum." },
          { "ar": "رَجَعْنا مَساءً وَكُنّا مُتْعَبينَ.", "tr": "rajaʿnā masāʾan wa-kunnā mutʿabīn.", "nl": "We kwamen 's avonds terug en waren moe." }
        ] }
      ]
    }
  ],

  "oefeningen": [
    {
