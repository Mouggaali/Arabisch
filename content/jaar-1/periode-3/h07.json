        { "type": "vertalen", "richting": "nl-ar", "tag": "kana-accusatief", "bron": "Ik was student.", "antwoorden": ["كُنْتُ طالِبًا", "كُنْتُ طالِبَةً"], "uitleg": "{ar|كُنْتُ طالِبًا}" },
        { "type": "vertalen", "richting": "ar-nl", "tag": "verbale-zin", "bron": "دَخَلَتِ المُعَلِّمَةُ الصَّفَّ.", "antwoorden": ["de lerares kwam de klas binnen", "de lerares ging de klas binnen", "de lerares ging de klas in"], "uitleg": "Verbale zin." },
        { "type": "vertalen", "richting": "ar-nl", "tag": "madi-meervoud", "bron": "ما فَهِمُوا السُّؤالَ.", "antwoorden": ["zij begrepen de vraag niet", "ze begrepen de vraag niet", "zij hebben de vraag niet begrepen"], "uitleg": "{ar|ما} + māḍī." }
      ]
    }
  ],

