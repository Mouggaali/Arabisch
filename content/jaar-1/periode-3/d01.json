          { "ar": "منين نتا؟ — أنا من هولندا.", "tr": "mnīn nta? — āna mən hulanda.", "nl": "Waar kom je vandaan? — Ik kom uit Nederland.", "review": { "status": "onzeker", "note": "Darija-dialoog laten nakijken." } },
