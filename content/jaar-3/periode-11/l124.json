  "grammatica": [
    {
      "titel": "Dubbel zwakke werkwoorden",
      "blokken": [
        {
          "type": "tekst",
          "md": "Sommige veelgebruikte werkwoorden hebben **twee** zwakke plekken: een hamza én een ي/و. Daardoor verschuiven ze sterk. Leer ze als vaste rijtjes."
        },
        {
          "type": "tabel",
          "kop": [
            "Persoon",
            "رَأى (zien)",
            "أَتى (komen)",
            "جاءَ (komen)"
          ],
          "rijen": [
            [
              "أَنا (māḍī)",
              "رَأَيْتُ|raʾaytu",
              "أَتَيْتُ|ataytu",
              "جِئْتُ|jiʾtu"
            ],
            [
              "هُوَ (māḍī)",
              "رَأى|raʾā",
              "أَتى|atā",
              "جاءَ|jāʾa"
            ],
            [
              "هُمْ (māḍī)",
              "رَأَوْا|raʾaw",
              "أَتَوْا|ataw",
              "جاؤوا|jāʾū"
            ],
            [
              "أَنا (muḍāriʿ)",
              "أَرى|arā",
              "آتي|ātī",
              "أَجيءُ|ajīʾu"
            ],
            [
              "هُوَ (muḍāriʿ)",
              "يَرى|yarā",
              "يَأْتي|yaʾtī",
              "يَجيءُ|yajīʾu"
            ],
            [
              "هُمْ (muḍāriʿ)",
              "يَرَوْنَ|yarawna",
              "يَأْتونَ|yaʾtūna",
              "يَجيئونَ|yajīʾūna"
            ],
            [
              "لَمْ (majzūm)",
              "لَمْ يَرَ|lam yara",
              "لَمْ يَأْتِ|lam yaʾti",
              "لَمْ يَجِئْ|lam yajiʾ"
            ]
          ],
          "arKolommen": [
            1,
            2,
            3
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom {ar|يَرى} zonder hamza? In de muḍāriʿ van {ar|رَأى} is de hamza historisch weggevallen: {ar|يَرْأى → يَرى}. Daardoor bestaat de stam nog maar uit één letter + klinker, en in de majzūm blijft er heel weinig over: {ar|لَمْ يَرَ}. Dat korte vormpje is in teksten makkelijk te missen."
        },
        {
          "type": "letop",
          "md": "{ar|جاءَ} en {ar|أَتى} betekenen allebei *komen*; {ar|جاءَ} is in modern Arabisch gewoner. De gebiedende wijs van beide wordt bijna nooit gebruikt: je zegt {ar|تَعالَ} (kom!)."
        }
      ]
    },
    {
      "titel": "Over dromen",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "رَأَيْتُ حُلْمًا غَريبًا البارِحَةَ.",
              "tr": "raʾaytu ḥulman ġarīban al-bāriḥa.",
              "nl": "Ik had vannacht een vreemde droom."
            },
            {
              "ar": "هَلْ تَرى ذٰلِكَ الضَّوْءَ؟",
              "tr": "hal tarā ḏālika ḍ-ḍawʾ?",
              "nl": "Zie je dat licht?"
            },
            {
              "ar": "لَمْ أَرَ مِثْلَهُ في حَياتي.",
              "tr": "lam ara miṯlahu fī ḥayātī.",
              "nl": "Ik heb nog nooit zoiets gezien."
            },
            {
              "ar": "جاءَ صَديقي وَلَمْ يَأْتِ أَخوهُ.",
              "tr": "jāʾa ṣadīqī wa-lam yaʾti aḫūh.",
              "nl": "Mijn vriend kwam, maar zijn broer niet."
            },
            {
              "ar": "سَأَجيءُ غَدًا إِنْ شاءَ اللّٰهُ.",
              "tr": "sa-ajīʾu ġadan in šāʾa llāh.",
              "nl": "Ik kom morgen, als God het wil."
            },
            {
              "ar": "أَتَمَنّى أَنْ تَتَحَقَّقَ أَحْلامُكَ.",
              "tr": "atamannā an tataḥaqqaqa aḥlāmuk.",
              "nl": "Ik hoop dat je dromen uitkomen."
            }
          ]
        }
      ]
    }
  ],
