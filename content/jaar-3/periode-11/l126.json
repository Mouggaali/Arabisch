  "grammatica": [
    {
      "titel": "De vocatief: iemand aanspreken",
      "blokken": [
        {
          "type": "tabel",
          "kop": [
            "Situatie",
            "Vorm",
            "Voorbeeld"
          ],
          "rijen": [
            [
              "naam of bepaalde persoon",
              "يا + nominatief zonder tanwīn",
              "يا أَحْمَدُ! · يا مُعَلِّمُ!"
            ],
            [
              "met bezittelijk suffix",
              "يا + naamwoord + ـي",
              "يا صَديقي! · يا أُمّي!"
            ],
            [
              "iḍāfa",
              "يا + accusatief",
              "يا عَبْدَ اللّٰهِ! · يا أُسْتاذَ اللُّغَةِ!"
            ],
            [
              "naamwoord met ال (m)",
              "يا أَيُّها / أَيُّها + ال",
              "أَيُّها الطُّلّابُ!"
            ],
            [
              "naamwoord met ال (v)",
              "يا أَيَّتُها / أَيَّتُها + ال",
              "أَيَّتُها السَّيِّداتُ!"
            ]
          ],
          "arKolommen": [
            2
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom {ar|أَيُّها}? Na {ar|يا} mag geen {ar|ال} direct volgen. {ar|أَيُّها} is een tussenwoord dat die botsing oplost. In toespraken laat men {ar|يا} vaak weg: {ar|أَيُّها الحُضورُ الكِرامُ}."
        },
        {
          "type": "letop",
          "md": "{ar|يا أَحْمَدُ} krijgt een **ḍamma zonder tanwīn**, omdat je een specifiek persoon aanspreekt. In de spreektaal hoor je die uitgang nauwelijks."
        }
      ]
    },
    {
      "titel": "Een toespraak bij de diploma-uitreiking",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "سَيِّداتي سادَتي، أَيُّها الحُضورُ الكِرامُ،",
              "tr": "sayyidātī sādatī, ayyuha l-ḥuḍūru l-kirām,",
              "nl": "Dames en heren, geacht publiek,"
            },
            {
              "ar": "يُشَرِّفُني أَنْ أُلْقِيَ كَلِمَةً في حَفْلِ التَّخَرُّجِ هٰذا.",
              "tr": "yušarrifunī an ulqiya kalimatan fī ḥafli t-taḫarruji hāḏā.",
              "nl": "Het is mij een eer om op deze diploma-uitreiking het woord te voeren."
            },
            {
              "ar": "أَيُّها الخِرّيجونَ، أُهَنِّئُكُمْ مِنْ كُلِّ قَلْبي.",
              "tr": "ayyuha l-ḫirrījūn, uhanniʾukum min kulli qalbī.",
              "nl": "Afgestudeerden, ik feliciteer jullie van harte."
            },
            {
              "ar": "وَأَنْتُنَّ أَيَّتُها الخِرّيجاتُ، أَنْتُنَّ فَخْرٌ لَنا.",
              "tr": "wa-antunna ayyatuha l-ḫirrījāt, antunna faḫrun lanā.",
              "nl": "En jullie, afgestudeerde vrouwen, jullie zijn onze trots."
            },
            {
              "ar": "يا أُسْتاذَ أَحْمَدَ، شُكْرًا عَلى كُلِّ شَيْءٍ.",
              "tr": "yā ustāḏa aḥmada, šukran ʿalā kulli šayʾ.",
              "nl": "Meester Ahmed, bedankt voor alles."
            },
            {
              "ar": "ماذا سَيَحْمِلُ لَنا المُسْتَقْبَلُ يا تُرى؟",
              "tr": "māḏā sa-yaḥmilu lana l-mustaqbalu yā turā?",
              "nl": "Wat zal de toekomst ons brengen, vraag ik me af?"
            }
          ]
        }
      ]
    }
  ],
