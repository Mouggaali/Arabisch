        {
          "type": "waarom",
          "md": "Bij het luisteren naar Darija zijn deze kleine woordjes de sleutel: ze vertellen je de **toon** van het gesprek. Ze hebben vaak geen directe Fusha-vertaling. {ar|زعما} komt wel van Fusha {ar|زَعَمَ} (beweren), vandaar *zogenaamd*."
        },
        {
          "type": "letop",
          "md": "Darija-sprekers praten snel en laten klinkers weg. Concentreer je bij het luisteren op de **werkwoorden** en de **partikels**; de rest volgt uit de context."
        }
      ]
    },
    {
      "titel": "Dialoog: twee vrienden komen elkaar tegen",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "السلام، شحال هادي ما شفتك!",
              "tr": "ssalām, šḥāl hādi ma šəftək!",
              "nl": "Hoi, lang niet gezien!",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "إيوا، كنت مشغول بزاف بالخدمة.",
              "tr": "īwa, kunt məšġūl bəzzāf b-lxədma.",
              "nl": "Tja, ik had het erg druk met werk.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "ياك لاباس؟ مالك؟",
              "tr": "yāk lābās? mālək?",
              "nl": "Alles goed toch? Wat is er?",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "لاباس، غير عيان شوية.",
              "tr": "lābās, ġīr ʿyyān šwiya.",
              "nl": "Goed hoor, alleen een beetje moe.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "يالاه نشربو أتاي، بلا ما تقول لا!",
              "tr": "yaḷḷāh nšərbu atāy, bla ma tqūl la!",
              "nl": "Kom, we drinken thee, en zeg maar geen nee!",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "واخا، ولكن فيسع، عندي موعد.",
              "tr": "waxxa, walākin fīsaʿ, ʿəndi mawʿid.",
              "nl": "Oké, maar snel, ik heb een afspraak.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            }
          ]
        }
      ]
    }
  ],
