      ]
    },
    {
      "titel": "Samenhang (cohesie)",
      "blokken": [
        {
          "type": "tekst",
          "md": "Een tekst is {ar|مُتَماسِكٌ} als de zinnen naar elkaar verwijzen. Gebruik daarvoor **voornaamwoorden** in plaats van herhaling, en **verbindingswoorden** tussen de ideeën."
        },
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "يُعَدُّ التَّلَوُّثُ مِنْ أَهَمِّ المُشْكِلاتِ في المُدُنِ الكَبيرَةِ.",
