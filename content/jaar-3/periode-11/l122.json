  "grammatica": [
    {
      "titel": "Het voorzetsel hoort bij het werkwoord",
      "blokken": [
        {
          "type": "tekst",
          "md": "Veel werkwoorden hebben een **vast voorzetsel**, net als het Nederlandse *wachten op* of *denken aan*. Leer ze altijd samen. Soms verandert het voorzetsel zelfs de betekenis."
        },
        {
          "type": "tabel",
          "kop": [
            "Werkwoord",
            "Met voorzetsel A",
            "Met voorzetsel B"
          ],
          "rijen": [
            [
              "رَغِبَ",
              "رَغِبَ في: willen",
              "رَغِبَ عَنْ: niet willen"
            ],
            [
              "قَضى",
              "قَضى (+ acc.): doorbrengen",
              "قَضى عَلى: een einde maken aan"
            ],
            [
              "قامَ",
              "قامَ: opstaan",
              "قامَ بِـ: uitvoeren"
            ],
            [
              "بَحَثَ",
              "بَحَثَ عَنْ: zoeken",
              "بَحَثَ في: onderzoeken"
            ]
          ],
          "arKolommen": [
            0,
            1,
            2
          ]
        },
        {
          "type": "waarom",
          "md": "Het voorzetsel geeft de **richting** van de handeling: {ar|في} = erin, ernaartoe; {ar|عَنْ} = ervan weg. Daarom betekent {ar|رَغِبَ في} *verlangen naar* en {ar|رَغِبَ عَنْ} *zich afwenden van*."
        },
        {
          "type": "letop",
          "md": "Het voorzetsel blijft bij de maṣdar ({ar|الاِعْتِمادُ عَلى}، {ar|الرَّغْبَةُ في}) en komt in een betrekkelijke bijzin terug met een voornaamwoord: {ar|الكِتابُ الَّذي بَحَثْتُ عَنْهُ} = het boek dat ik zocht."
        }
      ]
    },
    {
      "titel": "Wennen in een nieuw land",
