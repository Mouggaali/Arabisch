  "grammatica": [
    {
      "titel": "Klassieke constructies in spreekwoorden",
      "blokken": [
        {
          "type": "tabel",
          "kop": [
            "Constructie",
            "Spreekwoord",
            "Betekenis"
          ],
          "rijen": [
            [
              "مَنْ + māḍī … māḍī (voorwaarde)",
              "مَنْ جَدَّ وَجَدَ",
              "wie zich inspant, vindt"
            ],
            [
              "رُبَّ + onbepaald genitief",
              "رُبَّ ضارَّةٍ نافِعَةٌ",
              "soms is iets slechts toch goed"
            ],
            [
              "إِنْ + majzūm … māḍī",
              "الوَقْتُ كَالسَّيْفِ إِنْ لَمْ تَقْطَعْهُ قَطَعَكَ",
              "tijd is als een zwaard: snijd je hem niet, dan snijdt hij jou"
            ],
            [
              "أَفْعَلُ + iḍāfa",
              "خَيْرُ الأُمورِ أَوْسَطُها",
              "het gematigde is het beste"
            ],
            [
              "naamwoord zonder werkwoord",
              "الصَّديقُ وَقْتَ الضّيقِ",
              "een vriend (toont zich) in nood"
            ]
          ],
          "arKolommen": [
            1
          ]
        },
        {
          "type": "waarom",
          "md": "Spreekwoorden zijn **kort en ritmisch**, daarom gebruiken ze klassieke middelen: een māḍī die algemeen geldt ({ar|مَنْ جَدَّ وَجَدَ}), weglating van het werkwoord, en klankherhaling ({ar|جَدَّ / وَجَدَ}، {ar|زَرَعَ / حَصَدَ}). Wie deze patronen herkent, begrijpt ook nieuwe spreekwoorden."
        },
        {
          "type": "letop",
          "md": "{ar|رُبَّ} komt bijna alleen nog in vaste uitdrukkingen voor. Het naamwoord erna staat in de **genitief** en is **onbepaald**."
        }
      ]
    },
    {
      "titel": "Poëzie",
      "blokken": [
        {
          "type": "tekst",
          "md": "Klassieke Arabische poëzie bestaat uit **versregels** ({ar|أَبْياتٌ}) met twee helften, een vast **metrum** en één **rijm** ({ar|قافِيَةٌ}) door het hele gedicht. Aan het eind van de regel wordt de laatste klinker vaak gerekt of valt weg ({ar|القَدَرْ})."
        },
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "مَنْ جَدَّ وَجَدَ، وَمَنْ زَرَعَ حَصَدَ.",
              "tr": "man jadda wajada, wa-man zaraʿa ḥaṣad.",
              "nl": "Wie zich inspant, vindt; wie zaait, oogst."
            },
            {
              "ar": "رُبَّ ضارَّةٍ نافِعَةٌ.",
              "tr": "rubba ḍārratin nāfiʿa.",
              "nl": "Soms is iets slechts toch ergens goed voor."
            },
            {
              "ar": "اُطْلُبوا العِلْمَ مِنَ المَهْدِ إِلى اللَّحْدِ.",
              "tr": "uṭlubu l-ʿilma mina l-mahdi ila l-laḥd.",
              "nl": "Zoek kennis van de wieg tot het graf. (bekend gezegde)"
            },
            {
              "ar": "إِذا الشَّعْبُ يَوْمًا أَرادَ الحَياةَ ... فَلا بُدَّ أَنْ يَسْتَجيبَ القَدَرْ",
              "tr": "iḏa š-šaʿbu yawman arāda l-ḥayāh ... fa-lā budda an yastajība l-qadar",
              "nl": "Als het volk op een dag het leven wil, dan moet het lot wel gehoor geven. (Abu al-Qasim al-Shabbi, 1933)"
            },
            {
              "ar": "الخَيْلُ وَاللَّيْلُ وَالبَيْداءُ تَعْرِفُني ... وَالسَّيْفُ وَالرُّمْحُ وَالقِرْطاسُ وَالقَلَمُ",
              "tr": "al-ḫaylu wa-l-laylu wa-l-baydāʾu taʿrifunī ... wa-s-sayfu wa-r-rumḥu wa-l-qirṭāsu wa-l-qalamu",
              "nl": "Het paard, de nacht en de woestijn kennen mij, en het zwaard, de lans, het papier en de pen. (al-Mutanabbi, 10e eeuw)"
            },
            {
              "ar": "وَإِنَّما الأُمَمُ الأَخْلاقُ ما بَقِيَتْ ... فَإِنْ هُمُ ذَهَبَتْ أَخْلاقُهُمْ ذَهَبوا",
              "tr": "wa-innama l-umamu l-aḫlāqu mā baqiyat ... fa-in humu ḏahabat aḫlāquhum ḏahabū",
              "nl": "Volken bestaan slechts zolang hun moraal blijft; verdwijnt hun moraal, dan verdwijnen zij. (Ahmad Shawqi)"
            }
          ]
        },
        {
          "type": "letop",
          "md": "In de regel van al-Shabbi volgt na {ar|إِذا} een **naamwoord** ({ar|الشَّعْبُ}) in plaats van een werkwoord. Dat mag in poëzie: het werkwoord ({ar|أَرادَ}) komt later. In proza zeg je {ar|إِذا أَرادَ الشَّعْبُ …}."
        }
      ]
    }
  ],
