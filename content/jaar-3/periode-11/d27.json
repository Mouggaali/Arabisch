  "grammatica": [
    {
      "titel": "Rollenspel: iets is kapot",
      "blokken": [
        {
          "type": "tekst",
          "md": "In dit rollenspel lekt de kraan en is de stroom uitgevallen. Bel de loodgieter of de elektricien, leg uit wat er kapot is, en vraag naar de prijs. Daarna bel je de huisbaas."
        },
        {
          "type": "tabel",
          "kop": [
            "Wat je wilt",
            "Darija",
            "Fusha"
          ],
          "rijen": [
            [
              "zeggen wat kapot is",
              "… خاسر|xāsər",
              "… مُعَطَّلٌ"
            ],
            [
              "om reparatie vragen",
              "واش تقدر تصاوب …؟|waš tqdər tṣāwəb",
              "هَلْ يُمْكِنُكَ أَنْ تُصْلِحَ …؟"
            ],
            [
              "naar de prijs vragen",
              "شحال غادي تاخد؟|šḥāl ġādi tāxud",
              "كَمْ سَتَأْخُذُ؟"
            ],
            [
              "de stroom is uitgevallen",
              "تقطع الضو|tqəṭṭəʿ ḍḍəw",
              "اِنْقَطَعَتِ الكَهْرَباءُ"
            ]
          ],
          "arKolommen": [
            1,
            2
          ]
        },
        {
          "type": "waarom",
          "md": "Bij technische zaken gebruikt het Darija veel **Franse leenwoorden** ({ar|البلومبي}، {ar|التريسيان}، {ar|الروبيني}). Het Fusha-woord ken je wel ({ar|سَبّاكٌ}، {ar|كَهْرَبائِيٌّ}), maar in Marokko hoor je het in dit soort gesprekken zelden."
        }
      ]
    },
    {
      "titel": "Dialoog met de loodgieter",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "ألو، الروبيني ديال الكوزينة كيقطر.",
              "tr": "alō, rrōbīni dyāl lkūzīna kayqəṭṭəṛ.",
              "nl": "Hallo, de kraan in de keuken lekt.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "واخا، دابا نجي نشوفو.",
              "tr": "waxxa, dāba nji nšūfu.",
              "nl": "Oké, ik kom zo kijken.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "واش تقدر تصاوب حتى القادوس؟",
              "tr": "waš tqdər tṣāwəb ḥtta lqādūs?",
              "nl": "Kun je ook de afvoer repareren?",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "إيه، ولكن خاصني نجيب واحد الطرف.",
              "tr": "īh, walākin xəṣṣni njīb wāḥəd ṭṭərf.",
              "nl": "Ja, maar ik moet een onderdeel halen.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "شحال غادي تاخد؟",
              "tr": "šḥāl ġādi tāxud?",
              "nl": "Hoeveel ga je rekenen?",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "ميتين درهم مع الطرف.",
              "tr": "mītīn dərhəm mʿa ṭṭərf.",
              "nl": "Tweehonderd dirham inclusief het onderdeel.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            }
          ]
        }
      ]
    }
  ],
