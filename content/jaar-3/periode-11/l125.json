  "grammatica": [
    {
      "titel": "Manieren om nadruk te leggen",
      "blokken": [
        {
          "type": "tabel",
          "kop": [
            "Middel",
            "Voorbeeld",
            "Betekenis"
          ],
          "rijen": [
            [
              "لَقَدْ + māḍī",
              "لَقَدْ نَجَحْتُ!",
              "ik ben echt geslaagd!"
            ],
            [
              "إِنَّ … لَـ",
              "إِنَّكَ لَطالِبٌ مُجْتَهِدٌ",
              "jij bent werkelijk een ijverige student"
            ],
            [
              "قَدْ + muḍāriʿ",
              "قَدْ يَتَأَخَّرُ",
              "hij komt misschien te laat"
            ],
            [
              "naamwoord + نَفْسُ + suffix",
              "جاءَ المُديرُ نَفْسُهُ",
              "de directeur kwam zelf"
            ],
            [
              "نَفْسُ / ذاتُ + naamwoord",
              "في نَفْسِ اليَوْمِ",
              "op dezelfde dag"
            ],
            [
              "كُلُّ + suffix",
              "جاءَ الطُّلّابُ كُلُّهُمْ",
              "alle studenten kwamen"
            ]
          ],
          "arKolommen": [
            1
          ]
        },
        {
          "type": "waarom",
          "md": "Het Arabisch heeft geen klemtoon-nadruk zoals het Nederlandse *hij kwam ZELF*. Nadruk zit in **woorden**: {ar|لَـ} en {ar|قَدْ} versterken de bewering, {ar|نَفْس} en {ar|ذات} benadrukken de persoon of zaak. Achter het naamwoord neemt {ar|نَفْسُ} dezelfde naamval: {ar|رَأَيْتُ المُديرَ نَفْسَهُ}."
        },
        {
          "type": "letop",
          "md": "{ar|قَدْ} betekent iets anders naargelang het werkwoord: + māḍī = **al, echt** ({ar|قَدْ وَصَلَ}), + muḍāriʿ = **soms, misschien** ({ar|قَدْ يَصِلُ})."
        }
      ]
    },
    {
      "titel": "Zelfvertrouwen",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "لَقَدْ نَجَحْتِ بِفَضْلِ عَزيمَتِكِ.",
              "tr": "laqad najaḥti bi-faḍli ʿazīmatik.",
              "nl": "Je bent echt geslaagd dankzij je vastberadenheid."
            },
            {
              "ar": "إِنَّ الثِّقَةَ بِالنَّفْسِ لَمُهِمَّةٌ جِدًّا.",
              "tr": "inna ṯ-ṯiqata bi-n-nafsi la-muhimmatun jiddan.",
              "nl": "Zelfvertrouwen is werkelijk heel belangrijk."
            },
            {
              "ar": "لا تَلُمْ نَفْسَكَ، فَالخَطَأُ بِحَدِّ ذاتِهِ لَيْسَ مُشْكِلَةً.",
              "tr": "lā talum nafsaka, fa-l-ḫaṭaʾu bi-ḥaddi ḏātihi laysa muškila.",
              "nl": "Verwijt het jezelf niet; een fout op zich is geen probleem."
            },
            {
              "ar": "قابَلْتُ الكاتِبَ نَفْسَهُ في المَعْرِضِ.",
              "tr": "qābaltu l-kātiba nafsahu fi l-maʿriḍ.",
              "nl": "Ik heb de schrijver zelf op de beurs ontmoet."
            },
            {
              "ar": "ما شَكَكْتُ في قُدْرَتِكَ قَطُّ.",
              "tr": "mā šakaktu fī qudratika qaṭṭu.",
              "nl": "Ik heb nooit aan je kunnen getwijfeld."
            },
            {
              "ar": "كانَ سَعيدًا وَحَزينًا في الوَقْتِ ذاتِهِ.",
              "tr": "kāna saʿīdan wa-ḥazīnan fi l-waqti ḏātih.",
              "nl": "Hij was blij en verdrietig tegelijk."
            }
          ]
        }
      ]
    }
