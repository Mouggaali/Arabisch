  "grammatica": [
    {
      "titel": "Werkwoorden met vier wortelletters",
      "blokken": [
        {
          "type": "tekst",
          "md": "Sommige werkwoorden hebben **vier** wortelletters: {ar|ت-ر-ج-م}، {ar|ز-ل-ز-ل}. Ze vervoegen zoals **vorm II**: de muḍāriʿ heeft het voorvoegsel met **u** en een **i** vóór de laatste letter."
        },
        {
          "type": "tabel",
          "kop": [
            "Persoon",
            "Māḍī",
            "Muḍāriʿ"
          ],
          "rijen": [
            [
              "أَنا",
              "تَرْجَمْتُ|tarjamtu",
              "أُتَرْجِمُ|utarjimu"
            ],
            [
              "أَنْتَ",
              "تَرْجَمْتَ|tarjamta",
              "تُتَرْجِمُ|tutarjimu"
            ],
            [
              "هُوَ",
              "تَرْجَمَ|tarjama",
              "يُتَرْجِمُ|yutarjimu"
            ],
            [
              "هِيَ",
              "تَرْجَمَتْ|tarjamat",
              "تُتَرْجِمُ|tutarjimu"
            ],
            [
              "نَحْنُ",
              "تَرْجَمْنا|tarjamnā",
              "نُتَرْجِمُ|nutarjimu"
            ],
            [
              "هُمْ",
              "تَرْجَموا|tarjamū",
              "يُتَرْجِمونَ|yutarjimūna"
            ]
          ],
          "arKolommen": [
            1,
            2
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom zoals vorm II? Vergelijk {ar|دَرَّسَ يُدَرِّسُ} met {ar|تَرْجَمَ يُتَرْجِمُ}: beide hebben vier medeklinkers in de stam (d-r-r-s, t-r-j-m). Daarom gedragen ze zich hetzelfde: maṣdar {ar|تَرْجَمَةٌ} (vgl. {ar|فَعْلَلَةٌ}), deelwoorden {ar|مُتَرْجِمٌ / مُتَرْجَمٌ}."
        },
        {
          "type": "letop",
          "md": "Met {ar|تَـ} ervoor ontstaat een wederkerende vorm, zoals vorm V: {ar|زَلْزَلَ} (doen beven) → {ar|تَزَلْزَلَ} (beven), {ar|دَحْرَجَ} (rollen, iets) → {ar|تَدَحْرَجَ} (rollen, zelf). Nieuwe leenwoorden volgen hetzelfde patroon: {ar|بَرْمَجَ} (programmeren), {ar|دَبْلَجَ} (nasynchroniseren), {ar|عَوْلَمَةٌ} (globalisering)."
        }
      ]
    },
    {
      "titel": "Vertalen",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "تُرْجِمَتْ رِواياتُ نَجيبِ مَحْفوظٍ إِلى لُغاتٍ كَثيرَةٍ.",
              "tr": "turjimat riwāyātu najībi maḥfūẓin ilā luġātin kaṯīra.",
              "nl": "De romans van Naguib Mahfouz zijn in veel talen vertaald."
            },
            {
              "ar": "أُفَضِّلُ الأَفْلامَ المُتَرْجَمَةَ عَلى الأَفْلامِ المُدَبْلَجَةِ.",
              "tr": "ufaḍḍilu l-aflāma l-mutarjamata ʿala l-aflāmi l-mudablaja.",
              "nl": "Ik heb liever ondertitelde films dan nagesynchroniseerde."
            },
            {
              "ar": "التَّرْجَمَةُ الحَرْفِيَّةُ لا تَنْجَحُ دائِمًا.",
              "tr": "at-tarjamatu l-ḥarfiyyatu lā tanjaḥu dāʾiman.",
              "nl": "Een letterlijke vertaling werkt niet altijd."
            },
            {
              "ar": "ضَرَبَ زِلْزالٌ قَوِيٌّ مِنْطَقَةَ الحَوْزِ سَنَةَ ٢٠٢٣.",
              "tr": "ḍaraba zilzālun qawiyyun minṭaqata l-ḥawzi sanata 2023.",
              "nl": "In 2023 trof een zware aardbeving de regio Al Haouz."
            },
            {
              "ar": "تَدَحْرَجَتِ الكُرَةُ إِلى الشّارِعِ.",
              "tr": "tadaḥrajati l-kuratu ila š-šāriʿ.",
              "nl": "De bal rolde de straat op."
            },
            {
              "ar": "يُبَرْمِجُ أَخي تَطْبيقاتٍ لِلْهاتِفِ.",
              "tr": "yubarmiju aḫī taṭbīqātin li-l-hātif.",
              "nl": "Mijn broer programmeert apps voor de telefoon."
            }
          ]
        }
      ]
    }
