  "grammatica": [
    {
      "titel": "Rollenspel: in de hammam",
      "blokken": [
        {
          "type": "tekst",
          "md": "In dit rollenspel ga je naar een openbare hammam. Speel de rol van de klant: vraag naar de prijs, wat je moet meenemen en hoe je gescrubd wilt worden."
        },
        {
          "type": "tabel",
          "kop": [
            "Wat je wilt",
            "Darija",
            "Fusha"
          ],
          "rijen": [
            [
              "vragen hoeveel",
              "بشحال …؟|b-šḥāl",
              "بِكَمْ …؟"
            ],
            [
              "iets laten geven",
              "عطيني …|ʿṭīni",
              "أَعْطِني …"
            ],
            [
              "vragen om voorzichtigheid",
              "بالشوية|b-šwiya",
              "بِلُطْفٍ / بِهُدوءٍ"
            ],
            [
              "iemand iets laten meenemen",
              "جيب معاك …|jīb mʿāk",
              "أَحْضِرْ مَعَكَ …"
            ]
          ],
          "arKolommen": [
            1,
            2
          ]
        },
        {
          "type": "waarom",
          "md": "De hammam is in Marokko een sociale plek, niet alleen om je te wassen. Na afloop wens je elkaar {ar|بالصحة والراحة} (gezondheid en rust): een vaste formule, zoals {ar|بالصحة} na het eten."
        }
      ]
    },
    {
      "titel": "Dialoog",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "بشحال الحمام والكسال؟",
              "tr": "b-šḥāl lḥəmmām w-lkəssāl?",
              "nl": "Hoeveel kosten de hammam en de badmeester?",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "الحمام عشرين درهم، والكسال خمسين.",
              "tr": "lḥəmmām ʿəšrīn dərhəm, w-lkəssāl xəmsīn.",
              "nl": "De hammam twintig dirham, de badmeester vijftig.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "جيب معاك الصابون البلدي والكيس.",
              "tr": "jīb mʿāk ṣṣābūn lbəldi w-lkīs.",
              "nl": "Neem zwarte zeep en een scrubhandschoen mee.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "حك ليا بالشوية عافاك.",
              "tr": "ḥəkk līya b-šwiya ʿāfāk.",
              "nl": "Scrub alsjeblieft zachtjes.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "عطيني سطل ديال الما سخون.",
              "tr": "ʿṭīni sṭəl dyāl lma sxūn.",
              "nl": "Geef me een emmer warm water.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "بالصحة والراحة!",
              "tr": "b-ṣṣəḥḥa w-rrāḥa!",
              "nl": "Wel bekome het je!",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            }
          ]
        }
      ]
    }
  ],
