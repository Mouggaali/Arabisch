  "grammatica": [
    {
      "titel": "Oorzaak en gevolg",
      "blokken": [
        {
          "type": "tabel",
          "kop": [
            "Uitdrukking",
            "Wat volgt",
            "Voorbeeld"
          ],
          "rijen": [
            [
              "نَتيجَةً لِـ (als gevolg van)",
              "naamwoord (gen.)",
              "نَتيجَةً لِلْجَفافِ"
            ],
            [
              "بِسَبَبِ (vanwege)",
              "naamwoord (gen.)",
              "بِسَبَبِ التَّلَوُّثِ"
            ],
            [
              "مِمّا أَدّى إِلى (wat leidde tot)",
              "maṣdar (gen.)",
              "مِمّا أَدّى إِلى ذَوَبانِ الجَليدِ"
            ],
            [
              "وَبِالتّالي (bijgevolg)",
              "hele zin",
              "وَبِالتّالي قَلَّ المَحْصولُ"
            ],
            [
              "نَتَجَ / يَنْتُجُ عَنْ (voortkomen uit)",
              "oorzaak (gen.)",
              "يَنْتُجُ التَّلَوُّثُ عَنْ …"
            ]
          ],
          "arKolommen": [
            0,
            2
          ]
        },
        {
          "type": "waarom",
          "md": "{ar|مِمّا} = {ar|مِنْ} + {ar|ما}: *waardoor, wat*. Het verwijst naar de **hele vorige zin** als oorzaak, zoals het Nederlandse *wat ertoe leidde dat*. Daarom staat er altijd een komma voor."
        },
        {
          "type": "letop",
          "md": "{ar|أَدّى} is een zwak werkwoord (vorm II van أ-د-ي): muḍāriʿ {ar|يُؤَدّي}, maṣdar {ar|تَأْدِيَةٌ}. Gebruik na {ar|أَدّى إِلى} bij voorkeur een **maṣdar**: {ar|أَدّى إِلى اِرْتِفاعِ الأَسْعارِ}."
        }
      ]
    },
    {
      "titel": "Het klimaat",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "اِرْتَفَعَتْ دَرَجاتُ الحَرارَةِ، مِمّا أَدّى إِلى ذَوَبانِ الجَليدِ.",
              "tr": "irtafaʿat darajātu l-ḥarārati, mimmā addā ilā ḏawabāni l-jalīd.",
              "nl": "De temperaturen stegen, wat leidde tot het smelten van het ijs."
            },
            {
              "ar": "نَتيجَةً لِلْجَفافِ، اِرْتَفَعَتْ أَسْعارُ الخُضَرِ.",
              "tr": "natījatan li-l-jafāfi rtafaʿat asʿāru l-ḫuḍar.",
              "nl": "Als gevolg van de droogte stegen de groenteprijzen."
            },
            {
              "ar": "يَنْتُجُ التَّلَوُّثُ عَنْ حَرْقِ الوَقودِ.",
              "tr": "yantuju t-talawwuṯu ʿan ḥarqi l-waqūd.",
              "nl": "Vervuiling komt voort uit het verbranden van brandstof."
            },
            {
              "ar": "قَلَّتِ الأَمْطارُ، وَبِالتّالي قَلَّ المَحْصولُ.",
              "tr": "qallati l-amṭāru, wa-bi-t-tālī qalla l-maḥṣūl.",
              "nl": "Er viel minder regen, en dus was de oogst kleiner."
            },
            {
              "ar": "يُؤَدّي التَّصَحُّرُ إِلى هِجْرَةِ السُّكّانِ.",
              "tr": "yuʾaddī t-taṣaḥḥuru ilā hijrati s-sukkān.",
              "nl": "Woestijnvorming leidt tot migratie van de bevolking."
            }
          ]
        }
      ]
    }
