  "grammatica": [
    {
      "titel": "Beperking met لا/ما … إِلّا",
      "blokken": [
        {
          "type": "tekst",
          "md": [
            "Een ontkenning gevolgd door {ar|إِلّا} betekent **alleen, slechts, pas**: {ar|ما رَأَيْتُ إِلّا طَبيبًا واحِدًا} = ik heb maar één arts gezien (letterlijk: ik zag niemand behalve één arts).",
            "Het woord na {ar|إِلّا} krijgt de naamval die het **zonder de ontkenning** zou hebben: lijdend voorwerp → accusatief, onderwerp → nominatief."
          ]
        },
        {
          "type": "tabel",
          "kop": [
            "Zin",
            "Functie na إِلّا",
            "Betekenis"
          ],
          "rijen": [
            [
              "ما رَأَيْتُ إِلّا طَبيبًا",
              "lijdend voorwerp (acc.)",
              "ik zag alleen een arts"
            ],
            [
              "لا يَدْخُلُ إِلّا الأَطِبّاءُ",
              "onderwerp (nom.)",
              "alleen artsen mogen naar binnen"
            ],
            [
              "لا يُصْرَفُ الدَّواءُ إِلّا بِوَصْفَةٍ",
              "voorzetsel + gen.",
              "het medicijn wordt alleen op recept verstrekt"
            ],
            [
              "لَمْ أَنَمْ إِلّا ساعَتَيْنِ",
              "tijdsbepaling (acc.)",
              "ik heb maar twee uur geslapen"
            ]
          ],
          "arKolommen": [
            0
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom zo omslachtig? Een ontkenning met uitzondering is **sterker** dan {ar|فَقَطْ}: *ik zag niemand behalve …*. Daarom is dit in formele teksten de gewone manier om *alleen* te zeggen."
        }
      ]
    },
    {
      "titel": "إِنَّما",
      "blokken": [
        {
          "type": "tekst",
          "md": "{ar|إِنَّما} = {ar|إِنَّ} + {ar|ما}. Het betekent *slechts, alleen maar* of, na een ontkenning, *maar (eerder)*. Anders dan {ar|إِنَّ} heeft het **geen invloed op de naamval**: na {ar|إِنَّما} volgt een gewone zin met nominatief."
        },
        {
          "type": "letop",
          "md": "Vergelijk: {ar|إِنَّ العِلاجَ مُكْلِفٌ} (accusatief na inna) maar {ar|إِنَّما العِلاجُ مُكْلِفٌ} (nominatief: de ما *blokkeert* inna)."
        },
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "الوِقايَةُ لَيْسَتْ صَعْبَةً، إِنَّما تَحْتاجُ إِلى وَعْيٍ.",
              "tr": "al-wiqāyatu laysat ṣaʿbatan, innamā taḥtāju ilā waʿy.",
              "nl": "Preventie is niet moeilijk, ze vraagt alleen bewustzijn."
            },
            {
              "ar": "إِنَّما الأَعْمالُ بِالنِّيّاتِ.",
              "tr": "innama l-aʿmālu bi-n-niyyāt.",
              "nl": "Daden worden alleen naar de bedoelingen beoordeeld (bekende hadith)."
            },
            {
              "ar": "ما زُرْتُ الطَّبيبَ إِلّا مَرَّةً واحِدَةً هٰذا العامَ.",
              "tr": "mā zurtu ṭ-ṭabība illā marratan wāḥidatan hāḏa l-ʿām.",
              "nl": "Ik ben dit jaar maar één keer naar de dokter geweest."
            },
            {
              "ar": "لا يُصْرَفُ هٰذا الدَّواءُ إِلّا بِوَصْفَةٍ طِبِّيَّةٍ.",
              "tr": "lā yuṣrafu hāḏa d-dawāʾu illā bi-waṣfatin ṭibbiyya.",
              "nl": "Dit medicijn wordt alleen op recept verstrekt."
            },
            {
              "ar": "لا يَدْخُلُ قِسْمَ الطَّوارِئِ إِلّا الحالاتُ العاجِلَةُ.",
              "tr": "lā yadḫulu qisma ṭ-ṭawāriʾi illa l-ḥālātu l-ʿājila.",
              "nl": "Op de spoedeisende hulp worden alleen spoedgevallen opgenomen."
            }
          ]
        }
      ]
    }
  ],
