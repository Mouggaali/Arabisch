  "grammatica": [
    {
      "titel": "Intentie: أَنْوي أَنْ",
      "blokken": [
        {
          "type": "tekst",
          "md": "{ar|نَوى يَنْوي} (*van plan zijn*) is een **defectief** werkwoord (laatste wortelletter ي). Erna volgt {ar|أَنْ} + manṣūb of een maṣdar: {ar|أَنْوي أَنْ أَدْرُسَ} = {ar|أَنْوي الدِّراسَةَ}."
        },
        {
          "type": "tabel",
          "kop": [
            "Persoon",
            "Muḍāriʿ",
            "Māḍī"
          ],
          "rijen": [
            [
              "أَنا",
              "أَنْوي|anwī",
              "نَوَيْتُ|nawaytu"
            ],
            [
              "أَنْتَ",
              "تَنْوي|tanwī",
              "نَوَيْتَ|nawayta"
            ],
            [
              "هُوَ",
              "يَنْوي|yanwī",
              "نَوى|nawā"
            ],
            [
              "هِيَ",
              "تَنْوي|tanwī",
              "نَوَتْ|nawat"
            ],
            [
              "نَحْنُ",
              "نَنْوي|nanwī",
              "نَوَيْنا|nawaynā"
            ],
            [
              "هُمْ",
              "يَنْوونَ|yanwūna",
              "نَوَوْا|nawaw"
            ]
          ],
          "arKolommen": [
            1,
            2
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom {ar|نَوَتْ} en niet {ar|نَوَيَتْ}? Bij defectieve werkwoorden op -ā valt de ي weg voor uitgangen die met een klinker of {ar|تْ} beginnen; vergelijk {ar|مَشى → مَشَتْ}."
        }
      ]
    },
    {
      "titel": "Nabije toekomst en 'bijna'",
      "blokken": [
        {
          "type": "tabel",
          "kop": [
            "Uitdrukking",
            "Constructie",
            "Voorbeeld"
          ],
          "rijen": [
            [
              "عَلى وَشْكِ",
              "+ maṣdar of أَنْ + manṣūb",
              "أَنا عَلى وَشْكِ التَّخَرُّجِ"
            ],
            [
              "أَوْشَكَ",
              "+ أَنْ + manṣūb",
              "أَوْشَكَ أَنْ يَنْجَحَ"
            ],
            [
              "كادَ",
              "+ muḍāriʿ (zonder أَنْ)",
              "كادَ يَسْقُطُ"
            ]
          ],
          "arKolommen": [
            2
          ]
        },
        {
          "type": "letop",
          "md": "{ar|كادَ} is hol: {ar|كِدْتُ أَنْسى} = ik was het bijna vergeten. Ontkend betekent het *nauwelijks*: {ar|لَمْ أَكَدْ أَفْهَمُ} = ik begreep het nauwelijks."
        },
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "أَنْوي أَنْ أَدْرُسَ الطِّبَّ في الخارِجِ.",
              "tr": "anwī an adrusa ṭ-ṭibba fi l-ḫārij.",
              "nl": "Ik ben van plan geneeskunde in het buitenland te studeren."
            },
            {
              "ar": "أَنا عَلى وَشْكِ التَّخَرُّجِ.",
              "tr": "anā ʿalā waški t-taḫarruj.",
              "nl": "Ik sta op het punt af te studeren."
            },
            {
              "ar": "كانَ القِطارُ عَلى وَشْكِ أَنْ يَنْطَلِقَ.",
              "tr": "kāna l-qiṭāru ʿalā waški an yanṭaliqa.",
              "nl": "De trein stond op het punt te vertrekken."
            },
            {
              "ar": "كادَ يَنْسى مَوْعِدَ الاِمْتِحانِ.",
              "tr": "kāda yansā mawʿida l-imtiḥān.",
              "nl": "Hij was bijna de examendatum vergeten."
            },
            {
              "ar": "قَدَّمْتُ طَلَبًا لِلْحُصولِ عَلى مِنْحَةٍ دِراسِيَّةٍ.",
              "tr": "qaddamtu ṭalaban li-l-ḥuṣūli ʿalā minḥatin dirāsiyya.",
              "nl": "Ik heb een aanvraag ingediend voor een studiebeurs."
            },
            {
              "ar": "هِيَ عازِمَةٌ عَلى إِكْمالِ دِراسَتِها.",
              "tr": "hiya ʿāzimatun ʿalā ikmāli dirāsatihā.",
              "nl": "Zij is vastbesloten haar studie af te maken."
            }
          ]
        }
      ]
    }
  ],
