  "grammatica": [
    {
      "titel": "Hoe luister je naar nieuws?",
      "blokken": [
        {
          "type": "tekst",
          "md": "Nieuws gaat snel. Je hoeft niet elk woord te verstaan: let op de **vaste formules** die zeggen *wie* iets zegt, *wat* er gebeurde en *volgens wie*."
        },
        {
          "type": "tabel",
          "kop": [
            "Formule",
            "Betekenis",
            "Waar let je op?"
          ],
          "rijen": [
            [
              "أَفادَ مُراسِلُنا أَنَّ …",
              "onze correspondent meldt dat …",
              "wat volgt na أَنَّ"
            ],
            [
              "وَفْقًا لِـ … / حَسَبَ …",
              "volgens …",
              "de bron"
            ],
            [
              "نَقَلَتْ وَكالَةُ الأَنْباءِ عَنْ …",
              "het persbureau citeerde …",
              "wie er gesproken heeft"
            ],
            [
              "مِنَ المُتَوَقَّعِ أَنْ …",
              "naar verwachting zal …",
              "de toekomst"
            ],
            [
              "أَسْفَرَ عَنْ …",
              "resulteerde in …",
              "het gevolg, vaak met getallen"
            ]
          ],
          "arKolommen": [
            0
          ]
        },
        {
          "type": "waarom",
          "md": "Nieuwsberichten volgen bijna altijd dezelfde volgorde: **wat – waar – wanneer – wie zegt het – gevolg**. Als je die structuur kent, kun je de ontbrekende woorden vaak raden."
        },
        {
          "type": "letop",
          "md": "Getallen worden in het nieuws vaak in de **spreektaal-uitspraak** gezegd (zonder naamvalsuitgangen). Luister naar het getal zelf, niet naar de uitgang."
        }
      ]
    },
    {
      "titel": "Fragmenten",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "أَفادَ مُراسِلُنا أَنَّ حَرَكَةَ السَّيْرِ مُتَوَقِّفَةٌ عَلى الطَّريقِ السَّيّارِ.",
              "tr": "afāda murāsilunā anna ḥarakata s-sayri mutawaqqifatun ʿala ṭ-ṭarīqi s-sayyār.",
              "nl": "Onze correspondent meldt dat het verkeer op de snelweg stilstaat."
            },
            {
              "ar": "وَفْقًا لِلْأَرْصادِ الجَوِّيَّةِ، مِنَ المُتَوَقَّعِ سُقوطُ أَمْطارٍ غَزيرَةٍ غَدًا.",
              "tr": "wafqan li-l-arṣādi l-jawwiyyati, mina l-mutawaqqaʿi suqūṭu amṭārin ġazīratin ġadan.",
              "nl": "Volgens het weerinstituut wordt morgen hevige regen verwacht."
            },
            {
              "ar": "سَجَّلَ اللّاعِبُ هَدَفَيْنِ في الدَّقائِقِ الأَخيرَةِ.",
              "tr": "sajjala l-lāʿibu hadafayni fi d-daqāʾiqi l-aḫīra.",
              "nl": "De speler maakte twee doelpunten in de laatste minuten."
            },
            {
              "ar": "أَسْفَرَ اِنْقِطاعُ الكَهْرَباءِ عَنْ تَوَقُّفِ القِطاراتِ لِمُدَّةِ ساعَتَيْنِ.",
              "tr": "asfara nqiṭāʿu l-kahrabāʾi ʿan tawaqqufi l-qiṭārāti li-muddati sāʿatayn.",
              "nl": "De stroomstoring zorgde ervoor dat de treinen twee uur stillagen."
            },
            {
              "ar": "نَقَلَتْ وَكالَةُ الأَنْباءِ عَنِ الوَزيرِ قَوْلَهُ إِنَّ الوَضْعَ تَحْتَ السَّيْطَرَةِ.",
              "tr": "naqalat wakālatu l-anbāʾi ʿani l-wazīri qawlahu inna l-waḍʿa taḥta s-sayṭara.",
              "nl": "Het persbureau citeerde de minister, die zei dat de situatie onder controle is."
            }
          ]
        }
      ]
    }
