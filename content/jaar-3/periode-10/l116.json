  "grammatica": [
    {
      "titel": "Deelwoorden van de afgeleide vormen",
      "blokken": [
        {
          "type": "tekst",
          "md": "Alle deelwoorden van vorm II–X beginnen met **مُـ**. Het verschil tussen actief en passief zit in de klinker vóór de laatste wortelletter: **i** = actief (wie het doet), **a** = passief (wat ondergaan wordt)."
        },
        {
          "type": "tabel",
          "kop": [
            "Vorm",
            "Actief (-i-)",
            "Passief (-a-)"
          ],
          "rijen": [
            [
              "II",
              "مُدَرِّسٌ|mudarris (leraar)",
              "مُدَرَّسٌ|mudarras (onderwezen)"
            ],
            [
              "III",
              "مُشاهِدٌ|mušāhid (kijker)",
              "مُشاهَدٌ|mušāhad (bekeken)"
            ],
            [
              "IV",
              "مُرْسِلٌ|mursil (afzender)",
              "مُرْسَلٌ|mursal (verzonden)"
            ],
            [
              "V",
              "مُتَخَصِّصٌ|mutaḫaṣṣiṣ (specialist)",
              "–"
            ],
            [
              "VIII",
              "مُخْتَرِعٌ|muḫtariʿ (uitvinder)",
              "مُخْتَبَرٌ|muḫtabar (laboratorium)"
            ],
            [
              "X",
              "مُسْتَخْدِمٌ|mustaḫdim (gebruiker)",
              "مُسْتَخْدَمٌ|mustaḫdam (gebruikt)"
            ]
          ],
          "arKolommen": [
            1,
            2
          ]
        },
        {
          "type": "waarom",
          "md": "Eén klinker maakt het verschil tussen *gebruiker* en *gebruikt*. Daarom zijn harakat hier belangrijk, ook in teksten die verder zonder klinkers zijn. Het passieve deelwoord dient vaak ook als **plaats**: {ar|مُخْتَبَرٌ} (waar getest wordt), {ar|مُؤْتَمَرٌ} (waar overlegd wordt), {ar|مُجْتَمَعٌ} (waar men samenkomt: samenleving)."
        },
        {
          "type": "letop",
          "md": "Vorm V, VI en VII hebben meestal geen passief deelwoord, omdat ze geen lijdend voorwerp nemen."
        }
      ]
    },
    {
      "titel": "Wetenschap",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "يَعْمَلُ الباحِثونَ في المُخْتَبَرِ لَيْلًا وَنَهارًا.",
              "tr": "yaʿmalu l-bāḥiṯūna fi l-muḫtabari laylan wa-nahāran.",
              "nl": "De onderzoekers werken dag en nacht in het laboratorium."
            },
            {
              "ar": "نَشَرَتِ الباحِثَةُ نَتائِجَ بَحْثِها في مُؤْتَمَرٍ دَوْلِيٍّ.",
              "tr": "našarati l-bāḥiṯatu natāʾija baḥṯihā fī muʾtamarin dawliyy.",
              "nl": "De onderzoekster publiceerde de resultaten van haar onderzoek op een internationaal congres."
            },
            {
              "ar": "هٰذا الجِهازُ مُسْتَخْدَمٌ في المُسْتَشْفَياتِ.",
              "tr": "hāḏa l-jihāzu mustaḫdamun fi l-mustašfayāt.",
              "nl": "Dit apparaat wordt in ziekenhuizen gebruikt."
            },
            {
              "ar": "يَشْتَكي المُسْتَخْدِمونَ مِنْ أَنَّ البَرْنامَجَ مُعَقَّدٌ.",
              "tr": "yaštakī l-mustaḫdimūna min anna l-barnāmaja muʿaqqad.",
              "nl": "De gebruikers klagen dat het programma ingewikkeld is."
            },
            {
              "ar": "هَلْ هُناكَ حَياةٌ عَلى كَواكِبَ أُخْرى؟",
              "tr": "hal hunāka ḥayātun ʿalā kawākiba uḫrā?",
              "nl": "Is er leven op andere planeten?"
            }
          ]
        }
      ]
    }
  ],
