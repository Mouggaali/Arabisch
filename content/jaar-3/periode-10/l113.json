  "grammatica": [
    {
      "titel": "Het voltooid verleden: كانَ قَدْ + māḍī",
      "blokken": [
        {
          "type": "tekst",
          "md": [
            "Om te zeggen dat iets **vóór** een ander moment in het verleden al gebeurd was, gebruik je {ar|كانَ} (vervoegd) + {ar|قَدْ} + māḍī: {ar|كانَ القِطارُ قَدْ غادَرَ} = de trein was al vertrokken.",
            "Beide werkwoorden worden vervoegd: {ar|كُنْتُ قَدْ أَكَلْتُ} (ik had gegeten), {ar|كانَتْ قَدْ نامَتْ} (zij was gaan slapen), {ar|كُنّا قَدْ وَصَلْنا} (wij waren aangekomen)."
          ]
        },
        {
          "type": "tabel",
          "kop": [
            "Tijd",
            "Constructie",
            "Voorbeeld",
            "Betekenis"
          ],
          "rijen": [
            [
              "verleden",
              "māḍī",
              "غادَرَ القِطارُ",
              "de trein vertrok"
            ],
            [
              "voltooid verleden",
              "كانَ (قَدْ) + māḍī",
              "كانَ القِطارُ قَدْ غادَرَ",
              "de trein was vertrokken"
            ],
            [
              "voltooid toekomend",
              "سَيَكونُ قَدْ + māḍī",
              "سَيَكونُ القِطارُ قَدْ غادَرَ",
              "de trein zal vertrokken zijn"
            ],
            [
              "duur in het verleden",
              "كانَ + muḍāriʿ",
              "كانَ يُغادِرُ",
              "hij vertrok (altijd)"
            ]
          ],
          "arKolommen": [
            2
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom {ar|قَدْ}? Na een māḍī benadrukt {ar|قَدْ} dat de handeling **afgerond** is (les 78). Met {ar|كانَ} ervoor schuif je dat afgeronde moment naar het verleden. {ar|قَدْ} mag soms wegvallen ({ar|كانَ غادَرَ}), maar in nette teksten staat het er bijna altijd."
        },
        {
          "type": "letop",
          "md": "Verwar het niet met {ar|كانَ} + muḍāriʿ (gewoonte in het verleden): {ar|كانَ يَقْرَأُ} = hij las (altijd), {ar|كانَ قَدْ قَرَأَ} = hij had gelezen."
        }
      ]
    },
    {
      "titel": "Uit de geschiedenis van Marokko",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "عِنْدَما وَصَلْنا إِلى المَحَطَّةِ، كانَ القِطارُ قَدْ غادَرَ.",
              "tr": "ʿindamā waṣalnā ila l-maḥaṭṭati, kāna l-qiṭāru qad ġādar.",
              "nl": "Toen we bij het station aankwamen, was de trein al vertrokken."
            },
            {
              "ar": "حَصَلَ المَغْرِبُ عَلى اِسْتِقْلالِهِ سَنَةَ ١٩٥٦، بَعْدَ أَنْ كانَ قَدْ خَضَعَ لِلْحِمايَةِ مُنْذُ ١٩١٢.",
              "tr": "ḥaṣala l-maġribu ʿalā stiqlālihi sanata 1956, baʿda an kāna qad ḫaḍaʿa li-l-ḥimāyati munḏu 1912.",
              "nl": "Marokko werd in 1956 onafhankelijk, nadat het sinds 1912 onder het protectoraat had gestaan."
            },
            {
              "ar": "كانَ اِبْنُ بَطّوطَةَ قَدْ زارَ بُلْدانًا كَثيرَةً قَبْلَ أَنْ يَرْجِعَ إِلى المَغْرِبِ.",
              "tr": "kāna bnu baṭṭūṭata qad zāra buldānan kaṯīratan qabla an yarjiʿa ila l-maġrib.",
              "nl": "Ibn Battuta had veel landen bezocht voordat hij naar Marokko terugkeerde."
            },
            {
              "ar": "كُنْتُ قَدْ قَرَأْتُ الكِتابَ قَبْلَ أَنْ أُشاهِدَ الفيلْمَ.",
              "tr": "kuntu qad qaraʾtu l-kitāba qabla an ušāhida l-film.",
              "nl": "Ik had het boek gelezen voordat ik de film zag."
            },
            {
              "ar": "سَيَكونُ العُمّالُ قَدْ أَنْهَوُا البِناءَ قَبْلَ الصَّيْفِ.",
              "tr": "sa-yakūnu l-ʿummālu qad anhawu l-bināʾa qabla ṣ-ṣayf.",
              "nl": "De arbeiders zullen de bouw vóór de zomer hebben afgerond."
            }
          ]
        }
      ]
    }
  ],
