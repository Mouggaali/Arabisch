  "grammatica": [
    {
      "titel": "Darija en Fusha naast elkaar",
      "blokken": [
        {
          "type": "tabel",
          "kop": [
            "Kenmerk",
            "Fusha",
            "Darija"
          ],
          "rijen": [
            [
              "korte klinkers",
              "كَتَبَ|kataba",
              "كتب|ktəb"
            ],
            [
              "ik (muḍāriʿ)",
              "أَكْتُبُ|aktubu",
              "كنكتب|kanəktəb"
            ],
            [
              "wij (muḍāriʿ)",
              "نَكْتُبُ|naktubu",
              "كنكتبو|kanəktbu"
            ],
            [
              "ontkenning",
              "لا أَكْتُبُ / لَمْ أَكْتُبْ",
              "ما كنكتبش|ma kanəktəbš"
            ],
            [
              "toekomst",
              "سَأَكْتُبُ|sa-aktubu",
              "غادي نكتب|ġādi nəktəb"
            ],
            [
              "bezit",
              "كِتابُ أَحْمَدَ",
              "الكتاب ديال أحمد|lktāb dyāl aḥməd"
            ],
            [
              "ث → ت, ذ → د",
              "ثَلاثَةٌ، هٰذا",
              "تلاتة، هادا|tlāta, hāda"
            ],
            [
              "dualis",
              "كِتابانِ",
              "جوج كتوبا|žūž ktūba"
            ]
          ],
          "arKolommen": [
            1,
            2
          ]
        },
        {
          "type": "waarom",
          "md": "Darija is geen *verkeerd Fusha*: het is een eigen systeem met **vaste regels**. Wie de regels kent, ziet dat veel Darija-woorden gewoon Fusha-wortels zijn met een andere klank. De grootste verschillen zitten in de **dagelijkse werkwoorden**: die komen vaak van een andere wortel ({ar|شاف} i.p.v. {ar|رَأى})."
        },
        {
          "type": "letop",
          "md": "De 1e persoon enkelvoud begint in het Darija met **ن** ({ar|نكتب} = ik schrijf), terwijl dat in het Fusha *wij* is. Het meervoud krijgt dan **ـو** erachter ({ar|نكتبو} = wij schrijven)."
        }
      ]
    },
    {
      "titel": "Zelfde zin, twee registers",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "شفت صاحبي البارح ف السوق.",
              "tr": "šəft ṣāḥbi lbāṛəḥ f-ssūq.",
              "nl": "Ik zag mijn vriend gisteren op de markt. (Fusha: رَأَيْتُ صَديقي أَمْسِ في السّوقِ.)",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "جيب ليا الخبز عافاك.",
              "tr": "jīb līya lxubz ʿāfāk.",
              "nl": "Breng het brood voor me mee, alsjeblieft. (Fusha: أَحْضِرْ لي الخُبْزَ مِنْ فَضْلِكَ.)",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
