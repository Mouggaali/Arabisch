  "grammatica": [
    {
      "titel": "Overtreffende trap: drie constructies",
      "blokken": [
        {
          "type": "tabel",
          "kop": [
            "Constructie",
            "Voorbeeld",
            "Betekenis"
          ],
          "rijen": [
            [
              "أَفْعَلُ + onbepaald enkelvoud (gen.)",
              "أَجْمَلُ مَدينَةٍ",
              "de mooiste stad"
            ],
            [
              "أَفْعَلُ + bepaald meervoud (gen.)",
              "أَجْمَلُ المُدُنِ",
              "de mooiste (van de) steden"
            ],
            [
              "أَحَدُ / إِحْدى + أَفْعَلِ + meervoud",
              "أَحَدُ أَشْهَرِ المُغَنّينَ",
              "een van de bekendste zangers"
            ],
            [
              "أَكْثَرُ + tamyīz (acc.)",
              "أَكْثَرُ إِبْداعًا",
              "creatiever / het creatiefst"
            ]
          ],
          "arKolommen": [
            1
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom {ar|أَكْثَرُ إِبْداعًا}? Niet elk bijvoeglijk naamwoord past in het patroon {ar|أَفْعَلُ}: woorden als {ar|مُبْدِعٌ} (creatief) of kleuren hebben geen eigen trap. Je gebruikt dan {ar|أَكْثَرُ / أَشَدُّ} + een maṣdar in de accusatief (tamyīz, les 81)."
        },
        {
          "type": "letop",
          "md": "{ar|أَحَدُ} (m) / {ar|إِحْدى} (v) volgt het geslacht van het zelfstandig naamwoord: {ar|إِحْدى أَشْهَرِ المُغَنِّياتِ} = een van de bekendste zangeressen."
        }
      ]
    },
    {
      "titel": "Bewondering: ما أَفْعَلَ!",
      "blokken": [
        {
          "type": "tekst",
          "md": "De uitroep van bewondering kende je al (les 92): {ar|ما أَجْمَلَ صَوْتَها!} = wat een mooie stem heeft zij! Het object staat in de **accusatief**. Bij woorden zonder {ar|أَفْعَلَ}-vorm: {ar|ما أَكْثَرَ إِبْداعَهُ!}"
        },
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "أُمُّ كُلْثومٍ إِحْدى أَشْهَرِ المُغَنِّياتِ العَرَبِيّاتِ.",
              "tr": "ummu kulṯūmin iḥdā ašhari l-muġanniyāti l-ʿarabiyyāt.",
              "nl": "Umm Kulthum is een van de beroemdste Arabische zangeressen."
            },
            {
              "ar": "هٰذِهِ أَجْمَلُ أُغْنِيَةٍ سَمِعْتُها.",
              "tr": "hāḏihi ajmalu uġniyatin samiʿtuhā.",
              "nl": "Dit is het mooiste lied dat ik ooit gehoord heb."
            },
            {
              "ar": "يَعْزِفُ عَلى العودِ مُنْذُ صِغَرِهِ.",
              "tr": "yaʿzifu ʿala l-ʿūdi munḏu ṣiġarih.",
              "nl": "Hij speelt al sinds zijn jeugd oed."
            },
            {
              "ar": "ما أَرْوَعَ هٰذِهِ الزَّخْرَفَةَ!",
              "tr": "mā arwaʿa hāḏihi z-zaḫrafa!",
              "nl": "Wat is dit ornament prachtig!"
            },
            {
              "ar": "الخَطُّ المَغْرِبِيُّ أَكْثَرُ اسْتِدارَةً مِنَ الخَطِّ الكوفِيِّ.",
              "tr": "al-ḫaṭṭu l-maġribiyyu akṯaru stidāratan mina l-ḫaṭṭi l-kūfiyy.",
              "nl": "Het Maghrebijnse schrift is ronder dan het Kufische schrift."
            }
          ]
        }
      ]
    }
  ],
