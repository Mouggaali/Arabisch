  "grammatica": [
    {
      "titel": "Abstracte zelfstandige naamwoorden op ـِيَّة",
      "blokken": [
        {
          "type": "tekst",
          "md": "Plak je **ـِيَّة** achter een woord, dan krijg je een **abstract begrip** (het Nederlandse *-heid*, *-isme*, *-iteit*). Vaak gaat het via de nisba: {ar|إِنْسانٌ} (mens) → {ar|إِنْسانِيٌّ} (menselijk) → {ar|إِنْسانِيَّةٌ} (menselijkheid)."
        },
        {
          "type": "tabel",
          "kop": [
            "Basis",
            "Abstract",
            "Betekenis"
          ],
          "rijen": [
            [
              "حُرٌّ (vrij)",
              "حُرِّيَّةٌ",
              "vrijheid"
            ],
            [
              "مَسْؤولٌ (verantwoordelijk)",
              "مَسْؤولِيَّةٌ",
              "verantwoordelijkheid"
            ],
            [
              "أَهَمُّ (belangrijker)",
              "أَهَمِّيَّةٌ",
              "belang"
            ],
            [
              "إِمْكانٌ (mogelijkheid)",
              "إِمْكانِيَّةٌ",
              "mogelijkheid"
            ],
            [
              "عُنْصُرٌ (ras, element)",
              "عُنْصُرِيَّةٌ",
              "racisme"
            ],
            [
              "هُوَ (hij)",
              "هُوِيَّةٌ",
              "identiteit"
            ]
          ],
          "arKolommen": [
            0,
            1
          ]
        },
        {
          "type": "waarom",
          "md": "{ar|هُوِيَّةٌ} komt letterlijk van {ar|هُوَ} (*hij*): *het hij-zijn*, wat iemand is. De klassieke filosofen vormden zo nieuwe begrippen, en het Arabisch doet dat nog steeds: {ar|رَقْمِيَّةٌ}, {ar|عَوْلَمِيَّةٌ}. Deze woorden zijn altijd **vrouwelijk**."
        },
        {
          "type": "letop",
          "md": "Het meervoud gaat op {ar|ـِيّاتٌ}: {ar|مَسْؤولِيّاتٌ} (verantwoordelijkheden), {ar|إِمْكانِيّاتٌ} (mogelijkheden)."
        }
      ]
    },
    {
      "titel": "Tussen twee culturen",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "وُلِدْتُ في هولَنْدا، لٰكِنَّ هُوِيَّتي مَغْرِبِيَّةٌ وَهولَنْدِيَّةٌ مَعًا.",
              "tr": "wulidtu fī hūlandā, lākinna huwiyyatī maġribiyyatun wa-hūlandiyyatun maʿan.",
              "nl": "Ik ben in Nederland geboren, maar mijn identiteit is Marokkaans en Nederlands tegelijk."
            },
            {
              "ar": "يُعاني بَعْضُ المُهاجِرينَ مِنَ الغُرْبَةِ.",
              "tr": "yuʿānī baʿḍu l-muhājirīna mina l-ġurba.",
              "nl": "Sommige migranten lijden onder het leven ver van huis."
            },
            {
              "ar": "لِلُّغَةِ أَهَمِّيَّةٌ كَبيرَةٌ في الاِنْدِماجِ.",
              "tr": "li-l-luġati ahammiyyatun kabīratun fi l-indimāj.",
              "nl": "Taal is van groot belang voor integratie."
            },
            {
              "ar": "أَبْناءُ الجيلِ الثّاني غالِبًا ثُنائِيّو اللُّغَةِ.",
              "tr": "abnāʾu l-jīli ṯ-ṯānī ġāliban ṯunāʾiyyu l-luġa.",
              "nl": "Kinderen van de tweede generatie zijn vaak tweetalig.",
              "review": {
                "status": "onzeker",
                "note": "ثُنائِيّو (mv, iḍāfa: ـونَ valt weg) laten controleren; in pausa uitgesproken als ṯunāʾiyyu l-luġa."
              }
            },
            {
              "ar": "التَّعَدُّدِيَّةُ غِنًى لِلْمُجْتَمَعِ.",
              "tr": "at-taʿaddudiyyatu ġinan li-l-mujtamaʿ.",
              "nl": "Diversiteit is een rijkdom voor de samenleving."
            }
          ]
        }
      ]
    }
