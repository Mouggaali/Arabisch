  "grammatica": [
    {
      "titel": "Familiefeesten in het Darija",
      "blokken": [
        {
          "type": "tabel",
          "kop": [
            "",
            "Fusha",
            "Darija"
          ],
          "rijen": [
            [
              "verloving",
