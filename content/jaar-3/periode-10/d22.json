              "الهدية|lhdiyya"
            ],
            [
              "uitnodigen",
              "دَعا",
              "عرض|ʿṛəḍ"
            ]
          ],
          "arKolommen": [
            1,
            2
          ]
        },
        {
          "type": "waarom",
          "md": "Bij een Marokkaans feest hoort een vast ritueel van wensen: je feliciteert ({ar|مبروك عليك}), wenst dat alles goed afloopt ({ar|الله يكمل بالخير}) en bedankt de gastheer bij het weggaan met {ar|الله يخلف}. Wie die formules kent, valt meteen positief op."
        },
        {
          "type": "letop",
          "md": "Darija {ar|عرض} betekent *uitnodigen*, terwijl Fusha {ar|عَرَضَ} *tonen, aanbieden* betekent. Zo'n *valse vriend* tussen Fusha en Darija komt vaak voor."
        }
      ]
    },
    {
      "titel": "Op het feest",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "عرضونا للخطوبة ديال بنت خالتي.",
              "tr": "ʿṛḍūna l-lxṭūba dyāl bənt xāləti.",
              "nl": "We zijn uitgenodigd voor de verloving van mijn nicht.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "الدفوع جاو بالسكر والحليب والتمر.",
              "tr": "ddfūʿ jāw b-ssukkāṛ w-lḥlīb w-ttməṛ.",
              "nl": "De geschenken kwamen met suiker, melk en dadels.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken; inhoud van de dfouʿ verschilt per regio."
              }
            },
            {
              "ar": "خويا تزاد ليه ولد، السبوع نهار الجمعة.",
              "tr": "xūya tzād līh wəld, ssbūʿ nhāṛ ljəmʿa.",
              "nl": "Mijn broer heeft een zoon gekregen; het naamfeest is vrijdag.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "مبروك عليكم! الله يكمل بالخير.",
              "tr": "mbrūk ʿlīkum! ļļāh ikəmməl b-lxīr.",
              "nl": "Gefeliciteerd! Moge alles goed aflopen.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            }
          ]
        }
      ]
    }
  ],
