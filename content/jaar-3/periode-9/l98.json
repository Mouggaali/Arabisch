              "أُرْسِلَ",
              "يُرْسَلُ"
            ],
            [
              "اِسْتَخْدَمَ (X)",
              "اُسْتُخْدِمَ",
              "يُسْتَخْدَمُ"
            ],
            [
              "قالَ (hol)",
              "قيلَ",
              "يُقالُ"
            ],
            [
              "بَنى (defectief)",
              "بُنِيَ",
              "يُبْنى"
            ]
          ],
          "arKolommen": [
            0,
            1,
            2
          ]
        },
        {
          "type": "waarom",
          "md": "De regel blijft: **u** op alle klinkers vóór de laatste stamklinker, **i** op de laatste (māḍī); in de muḍāriʿ **yu** + **a**. Bij holle werkwoorden wordt de lange ā een ī ({ar|قيلَ}) of ā ({ar|يُقالُ})."
        },
        {
          "type": "letop",
          "md": "Moderne alternatieven voor de lijdende vorm: **vorm VII** ({ar|اِنْكَسَرَ} = brak) en **تَمَّ + maṣdar**: {ar|تَمَّ بِناءُ المَسْجِدِ} (de moskee werd gebouwd, letterlijk: het bouwen werd voltooid). Kranten gebruiken {ar|تَمَّ} heel vaak."
        }
      ]
    },
    {
      "titel": "Geschiedenis",
      "blokken": [
