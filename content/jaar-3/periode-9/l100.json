  "grammatica": [
    {
      "titel": "Irreële voorwaarde: لَوْ … لَـ",
      "blokken": [
        {
          "type": "tekst",
          "md": [
            "{ar|لَوْ} gebruik je voor iets wat **niet waar is** of **niet gebeurd is**: {ar|لَوْ كُنْتُ غَنِيًّا لَسافَرْتُ حَوْلَ العالَمِ} (als ik rijk was, zou ik de wereld rondreizen).",
            "Beide delen staan in de **māḍī**; het gevolg begint vaak met {ar|لَـ}. Of het over het heden of het verleden gaat, blijkt uit de context."
          ]
        },
        {
          "type": "tabel",
          "kop": [
            "Type",
            "Voorbeeld",
            "Betekenis"
          ],
          "rijen": [
            [
              "reëel (إِذا)",
              "إِذا دَرَسْتَ نَجَحْتَ",
              "als je studeert, slaag je"
            ],
            [
              "mogelijk (إِنْ)",
              "إِنْ تَدْرُسْ تَنْجَحْ",
              "indien je studeert, slaag je"
            ],
            [
              "irreëel (لَوْ)",
              "لَوْ دَرَسْتَ لَنَجَحْتَ",
              "als je gestudeerd had, was je geslaagd"
            ]
          ],
          "arKolommen": [
            1
          ]
        },
        {
          "type": "waarom",
          "md": "Drie voorwaardewoorden, drie graden van werkelijkheid: {ar|إِذا} (verwacht), {ar|إِنْ} (mogelijk), {ar|لَوْ} (onwerkelijk). Het Nederlands doet hetzelfde met de werkwoordstijd (*als … dan*, *als … zou*, *als … had*). Het Arabisch doet het met het voegwoord."
        },
        {
          "type": "letop",
          "md": "Ontkenning in het gevolg: {ar|لَما} + māḍī: {ar|لَوْ عَرَفْتُ لَما جِئْتُ} (als ik het had geweten, was ik niet gekomen)."
        }
      ]
    },
    {
      "titel": "لَوْلا: als … er niet was geweest",
      "blokken": [
        {
          "type": "tekst",
          "md": "{ar|لَوْلا} + **naamwoord (nominatief)** + {ar|لَـ} + māḍī: {ar|لَوْلا مُساعَدَتُكَ لَفَشِلْتُ} (zonder jouw hulp was ik mislukt)."
        },
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "لَوْ كُنْتُ مَليونيرًا لَاشْتَرَيْتُ جَزيرَةً.",
              "tr": "law kuntu malyūnīran la-štaraytu jazīra.",
              "nl": "Als ik miljonair was, zou ik een eiland kopen."
