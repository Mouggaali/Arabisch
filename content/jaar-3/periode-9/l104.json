  "grammatica": [
    {
      "titel": "Indirecte rede",
      "blokken": [
        {
          "type": "tabel",
          "kop": [
            "Direct",
            "Indirect",
            "Regel"
          ],
          "rijen": [
            [
              "قالَ: «أَنا مَريضٌ.»",
              "قالَ إِنَّهُ مَريضٌ.",
              "na قالَ: إِنَّ + accusatief"
            ],
            [
              "ذَكَرَ: «الخُطَّةُ جاهِزَةٌ.»",
              "ذَكَرَ أَنَّ الخُطَّةَ جاهِزَةٌ.",
              "na andere werkwoorden: أَنَّ"
            ],
            [
              "سَأَلَ: «هَلْ أَنْتَ مُسْتَعِدٌّ؟»",
              "سَأَلَهُ هَلْ هُوَ مُسْتَعِدٌّ.",
              "ja/nee-vraag: هَلْ of إِنْ كانَ"
            ],
            [
              "سَأَلَ: «ماذا تُريدُ؟»",
              "سَأَلَهُ عَمّا يُريدُ.",
              "open vraag: vraagwoord blijft"
            ],
            [
              "قالَ لَهُ: «اُكْتُبْ!»",
              "طَلَبَ مِنْهُ أَنْ يَكْتُبَ.",
              "opdracht: أَنْ + manṣūb"
            ]
          ],
          "arKolommen": [
            0,
            1
          ]
        },
        {
          "type": "waarom",
          "md": "De twee aandachtspunten: (1) **personen verschuiven** ({ar|أَنا} → {ar|هُوَ}), net als in het Nederlands; (2) de **tijd blijft meestal staan** – Arabisch past de werkwoordstijd niet aan zoals het Nederlands soms doet."
        },
        {
          "type": "letop",
          "md": "Alleen na {ar|قالَ} gebruik je {ar|إِنَّ}. Na {ar|ذَكَرَ}، {ar|أَوْضَحَ}، {ar|أَشارَ إِلى}، {ar|أَعْلَنَ} gebruik je {ar|أَنَّ}."
        }
      ]
    },
    {
      "titel": "Een interview navertellen",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "قالَ الوَزيرُ إِنَّ الحُكومَةَ سَتَبْني مَدارِسَ جَديدَةً.",
              "tr": "qāla l-wazīru inna l-ḥukūmata sa-tabnī madārisa jadīda.",
              "nl": "De minister zei dat de regering nieuwe scholen gaat bouwen."
            },
            {
              "ar": "وَأَوْضَحَ أَنَّ المَشْروعَ سَيَبْدَأُ العامَ القادِمَ.",
              "tr": "wa-awḍaḥa anna l-mašrūʿa sa-yabdaʾu l-ʿāma l-qādim.",
              "nl": "En hij legde uit dat het project volgend jaar begint."
            },
            {
              "ar": "سَأَلَهُ المُحاوِرُ عَمّا سَيَحْدُثُ لِلْمُعَلِّمينَ.",
              "tr": "saʾalahu l-muḥāwiru ʿammā sa-yaḥduṯu li-l-muʿallimīn.",
              "nl": "De interviewer vroeg hem wat er met de leraren zal gebeuren."
            },
            {
              "ar": "وَسَأَلَهُ إِنْ كانَتِ المِيزانِيَّةُ كافِيَةً.",
              "tr": "wa-saʾalahu in kānati l-mīzāniyyatu kāfiya.",
              "nl": "En hij vroeg hem of het budget voldoende was."
            },
            {
              "ar": "أَعْرَبَ الضَّيْفُ عَنْ تَفاؤُلِهِ.",
              "tr": "aʿraba ḍ-ḍayfu ʿan tafāʾulih.",
              "nl": "De gast gaf blijk van zijn optimisme."
            }
          ]
        }
      ]
    }
  ],
