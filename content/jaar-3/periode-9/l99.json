  "grammatica": [
    {
      "titel": "Voorwaarde met إِنْ",
      "blokken": [
        {
          "type": "tekst",
          "md": [
            "{ar|إِنْ} (*als, indien*) is formeler dan {ar|إِذا}. Beide zinsdelen staan in de **majzūm** (of in de māḍī): {ar|إِنْ تَدْرُسْ تَنْجَحْ} (als je studeert, slaag je).",
            "Ook voorwaardelijke woorden als {ar|مَنْ} (wie ook), {ar|مَهْما} (wat ook) en {ar|أَيْنَما} (waar ook) werken zo: {ar|مَنْ يَجْتَهِدْ يَنْجَحْ} (wie zich inspant, slaagt)."
          ]
        },
        {
          "type": "tabel",
          "kop": [
            "",
            "إِذا",
            "إِنْ"
          ],
          "rijen": [
            [
              "register",
              "algemeen, ook gesproken",
              "formeel, schrijftaal, spreekwoorden"
            ],
            [
              "werkwoord",
              "māḍī",
              "majzūm (of māḍī)"
            ],
            [
              "betekenis",
              "als (verwacht)",
              "als, indien (mogelijk, minder zeker)"
            ]
          ],
          "arKolommen": []
        },
        {
          "type": "waarom",
          "md": "Waarom majzūm? {ar|إِنْ} is een 'majzūm-maker' zoals {ar|لَمْ}: het zet zowel de voorwaarde als het gevolg in de verkorte wijs. Daardoor hoor je die korte uitgang vooral in spreekwoorden en formele teksten: {ar|إِنْ تَزْرَعْ تَحْصُدْ} (wie zaait, zal oogsten)."
        },
        {
          "type": "letop",
          "md": "Begint het gevolg niet met een werkwoord in de majzūm (bijv. gebiedende wijs, سَـ, nominale zin), dan komt er {ar|فَـ} voor: {ar|إِنْ أَرَدْتَ النَّجاحَ فَاجْتَهِدْ}."
        }
      ]
    },
    {
      "titel": "Adviezen voor de toekomst",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "إِنْ تَجْتَهِدْ تُحَقِّقْ أَحْلامَكَ.",
              "tr": "in tajtahid tuḥaqqiq aḥlāmak.",
              "nl": "Als je je inspant, maak je je dromen waar."
            },
            {
              "ar": "مَنْ يَسْتَغِلَّ الفُرْصَةَ لا يَنْدَمْ.",
              "tr": "man yastaġilla l-furṣata lā yandam.",
              "nl": "Wie de kans grijpt, krijgt geen spijt.",
              "review": {
                "status": "onzeker",
                "note": "Majzūm van verdubbeld vorm X (يَسْتَغِلَّ) controleren."
              }
            },
            {
              "ar": "إِنْ أَرَدْتَ نَصيحَتي فَاسْتَشِرْ أُسْتاذَكَ.",
              "tr": "in aradta naṣīḥatī fa-stašir ustāḏak.",
              "nl": "Als je mijn advies wilt: raadpleeg je docent."
            },
            {
              "ar": "أَيْنَما تَذْهَبْ تَجِدْ أَصْدِقاءَ.",
              "tr": "aynamā taḏhab tajid aṣdiqāʾ.",
              "nl": "Waar je ook gaat, je vindt vrienden."
            },
            {
              "ar": "إِذا ضَيَّعْتَ الفُرْصَةَ، فَلَنْ تَعودَ.",
              "tr": "iḏā ḍayyaʿta l-furṣata, fa-lan taʿūd.",
              "nl": "Als je de kans laat lopen, komt ze niet terug."
            }
          ]
        }
      ]
    }
  ],
