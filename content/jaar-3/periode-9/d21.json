              "nl": "Wat heb ik nodig om mijn kaart te vernieuwen?",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "كيخصك جوج تصاور والطامبر.",
              "tr": "kayxəṣṣək žūž tṣāwəṛ w-ṭṭāmbər.",
              "nl": "Je hebt twee foto's en een zegel nodig.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "سني هنا عافاك.",
              "tr": "sənni hna ʿāfāk.",
              "nl": "Teken hier alstublieft.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "الوراق ماشي مسالين، رجع غدا.",
              "tr": "lwṛāq māši msālyīn, ṛjəʿ ġədda.",
              "nl": "De papieren zijn niet klaar, kom morgen terug.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            }
          ]
