              "تَحْتاجُ إِلى",
              "كيخصك|kayxəṣṣək"
            ],
            [
              "teken hier",
              "وَقِّعْ هُنا",
              "سني هنا|sənni hna"
            ]
          ],
          "arKolommen": [
            1,
            2
          ]
        },
        {
          "type": "waarom",
          "md": "Bij de Marokkaanse administratie hoor je veel Franse woorden ({ar|الطامبر}، {ar|سني}), omdat officiële documenten lang in het Frans waren. Formulieren zijn nu vaak tweetalig (Arabisch-Frans)."
        },
        {
          "type": "letop",
          "md": "{ar|كيخصك} (*het is nodig voor jou*) is een onpersoonlijke constructie, net als Fusha {ar|يَجِبُ عَلَيْكَ}: {ar|كيخصك البطاقة الوطنية} = je hebt je identiteitskaart nodig."
        }
      ]
    },
    {
      "titel": "Aan het loket",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "شنو كيخصني باش نجدد البطاقة؟",
