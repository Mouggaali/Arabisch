              "لَمّا وَصَلْتُ، …"
            ],
            [
              "كُلَّما … (+ māḍī)",
              "telkens wanneer",
              "كُلَّما زُرْتُها فَرِحَتْ"
            ],
            [
              "بَيْنَما",
              "terwijl",
              "بَيْنَما كُنْتُ أَقْرَأُ، …"
            ],
            [
              "بَعْدَما / بَعْدَ أَنْ",
              "nadat",
              "بَعْدَما أَكَلْنا، …"
            ],
            [
              "مُنْذُ أَنْ",
              "sinds",
              "مُنْذُ أَنْ وَصَلْتُ، …"
            ],
            [
              "ما إِنْ … حَتّى",
              "nauwelijks … of",
              "ما إِنْ وَصَلْتُ حَتّى بَدَأَ المَطَرُ"
            ]
          ],
          "arKolommen": [
            0,
            2
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom de māḍī na {ar|كُلَّما} en {ar|لَمّا}, ook bij gewoonten? Net als na {ar|إِذا} stel je je de handeling voor als **afgerond** op het moment dat het gevolg intreedt: *telkens als ik haar bezocht had, was ze blij*. Het gevolg krijgt ook de māḍī."
        },
        {
          "type": "letop",
          "md": "{ar|لَمّا} + **māḍī** = *toen*. {ar|لَمّا} + **majzūm** = *nog niet* ({ar|لَمّا يَصِلْ} = hij is nog niet aangekomen). De vorm van het werkwoord beslist."
        }
      ]
    },
    {
      "titel": "Herinneringen",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "عِنْدَما كُنْتُ طِفْلًا، كُنْتُ أَقْضي العُطْلَةَ في بَيْتِ جَدّي.",
              "tr": "ʿindamā kuntu ṭiflan, kuntu aqḍi l-ʿuṭlata fī bayti jaddī.",
              "nl": "Toen ik een kind was, bracht ik de vakantie door in het huis van mijn opa."
            },
            {
              "ar": "كُلَّما شَمَمْتُ رائِحَةَ النَّعْناعِ، تَذَكَّرْتُ جَدَّتي.",
              "tr": "kullamā šamamtu rāʾiḥata n-naʿnāʿ, taḏakkartu jaddatī.",
              "nl": "Telkens als ik de geur van munt ruik, denk ik aan mijn oma."
            },
            {
              "ar": "لَمّا كَبِرْتُ، اِنْتَقَلْنا إِلى المَدينَةِ.",
              "tr": "lammā kabirtu, intaqalnā ila l-madīna.",
              "nl": "Toen ik ouder werd, verhuisden we naar de stad."
            },
            {
              "ar": "ما إِنْ وَصَلْنا حَتّى بَدَأَ المَطَرُ.",
              "tr": "mā in waṣalnā ḥattā badaʾa l-maṭar.",
              "nl": "We waren nauwelijks aangekomen of het begon te regenen."
            },
            {
              "ar": "مُنْذُ أَنْ تَرَكْتُ القَرْيَةَ، أَحِنُّ إِلَيْها.",
              "tr": "munḏu an taraktu l-qaryata, aḥinnu ilayhā.",
              "nl": "Sinds ik het dorp verliet, verlang ik ernaar terug."
            }
          ]
        }
      ]
    }
  ],
