    {
      "titel": "Tegenstelling: بَلْ en أَمّا … فَـ",
      "blokken": [
        {
          "type": "tekst",
          "md": "{ar|بَلْ} corrigeert na een ontkenning: {ar|لَيْسَ سَهْلًا بَلْ صَعْبًا} (het is niet makkelijk, maar juist moeilijk). {ar|أَمّا … فَـ} zet een nieuw onderwerp tegenover het vorige: {ar|أَمّا أَنا فَأُفَضِّلُ الشّايَ} (ik daarentegen geef de voorkeur aan thee)."
        },
        {
          "type": "letop",
          "md": "Na {ar|أَمّا X} komt **altijd** {ar|فَـ} voor het gezegde: {ar|أَمّا الحَلُّ فَبَسيطٌ}. Vergeet die {ar|فَـ} niet."
        },
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "رَغْمَ أَنَّ الفِكْرَةَ جَيِّدَةٌ، فَهِيَ صَعْبَةُ التَّنْفيذِ.",
              "tr": "raġma anna l-fikrata jayyidatun, fa-hiya ṣaʿbatu t-tanfīḏ.",
              "nl": "Hoewel het idee goed is, is het moeilijk uit te voeren."
            },
            {
              "ar": "المُشْكِلَةُ لَيْسَتْ في المالِ، بَلْ في الوَقْتِ.",
              "tr": "al-muškilatu laysat fi l-māli, bal fi l-waqt.",
              "nl": "Het probleem zit niet in het geld, maar juist in de tijd."
            },
            {
              "ar": "أَمّا المُعارِضونَ فَيَقولونَ إِنَّ الخُطَّةَ مُكْلِفَةٌ.",
              "tr": "ammā l-muʿāriḍūna fa-yaqūlūna inna l-ḫuṭṭata mukallifa.",
              "nl": "De tegenstanders daarentegen zeggen dat het plan duur is."
            },
            {
              "ar": "في حينِ أَنَّ المُؤَيِّدينَ يَرَوْنَها ضَرورِيَّةً.",
              "tr": "fī ḥīni anna l-muʾayyidīna yarawnahā ḍarūriyya.",
              "nl": "Terwijl de voorstanders het noodzakelijk vinden.",
              "review": {
                "status": "onzeker",
                "note": "يَرَوْنَ (defectief + hamza) controleren."
              }
            },
            {
              "ar": "خَرَجْنا رَغْمَ المَطَرِ.",
              "tr": "ḫarajnā raġma l-maṭar.",
              "nl": "We gingen naar buiten ondanks de regen."
            }
          ]
        }
      ]
    }
