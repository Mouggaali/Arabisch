  "grammatica": [
    {
      "titel": "Bij de dokter in het Darija",
      "blokken": [
        {
          "type": "tekst",
          "md": "Pijn zeg je met {ar|كيضرني} + lichaamsdeel met suffix: {ar|كيضرني راسي} (ik heb hoofdpijn), {ar|كتضرني كرشي} (ik heb buikpijn). Het werkwoord congrueert met het lichaamsdeel."
        },
        {
          "type": "tabel",
          "kop": [
            "",
            "Fusha",
            "Darija"
          ],
          "rijen": [
            [
              "ik heb hoofdpijn",
              "عِنْدي صُداعٌ",
              "كيضرني راسي|kayḍəṛṛni ṛāsi"
            ],
            [
              "koorts",
              "حَرارَةٌ / حُمّى",
              "السخانة|ssxāna"
            ],
            [
              "medicijn",
              "دَواءٌ",
              "الدوا|ddwa"
            ],
            [
              "beterschap",
              "شِفاءً عاجِلًا",
              "الله يشافيك|aḷḷāh yšāfīk"
            ]
          ],
          "arKolommen": [
            1,
            2
          ]
        },
        {
          "type": "waarom",
          "md": "{ar|السخانة} betekent in het Darija zowel *hitte* als *koorts* (D13): de context beslist. Medische vaktermen komen in Marokko vaak uit het Frans ({ar|الفرمسيان}), omdat de geneeskunde-opleiding grotendeels Franstalig is."
        }
      ]
    },
    {
      "titel": "Bij de apotheek",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "عندي السخانة وكيضرني راسي.",
              "tr": "ʿəndi ssxāna w-kayḍəṛṛni ṛāsi.",
              "nl": "Ik heb koorts en hoofdpijn.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "خود هاد الدوا مرتين ف النهار قبل الماكلة.",
              "tr": "xūd hād ddwa mərrtayn f-nnhāṛ qbəl lmākla.",
              "nl": "Neem dit medicijn twee keer per dag voor het eten.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "عندك الورقة ديال الطبيب؟",
              "tr": "ʿəndək lwərqa dyāl ṭṭbīb?",
              "nl": "Heb je het recept van de dokter?",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "الله يشافيك!",
              "tr": "aḷḷāh yšāfīk!",
              "nl": "Beterschap!",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            }
          ]
        }
      ]
    }
  ],
