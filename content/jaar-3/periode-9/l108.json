    {
      "titel": "Een debat over sociale media",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "أ: مِنْ وِجْهَةِ نَظَري، وَسائِلُ التَّواصُلِ مُفيدَةٌ لِلشَّبابِ.",
              "tr": "min wijhati naẓarī, wasāʾilu t-tawāṣuli mufīdatun li-š-šabāb.",
              "nl": "A: Volgens mij zijn sociale media nuttig voor jongeren."
            },
            {
              "ar": "ب: هٰذا صَحيحٌ، لٰكِنَّها قَدْ تُسَبِّبُ الإِدْمانَ.",
              "tr": "hāḏā ṣaḥīḥ, lākinnahā qad tusabbibu l-idmān.",
              "nl": "B: Dat klopt, maar ze kunnen verslaving veroorzaken."
            },
            {
              "ar": "أ: ماذا تَقْصِدُ بِالإِدْمانِ؟",
              "tr": "māḏā taqṣidu bi-l-idmān?",
              "nl": "A: Wat bedoel je met verslaving?"
            },
            {
              "ar": "ب: بِعِبارَةٍ أُخْرى، يَقْضي الشَّبابُ ساعاتٍ طَويلَةً أَمامَ الشّاشَةِ.",
              "tr": "bi-ʿibāratin uḫrā, yaqḍi š-šabābu sāʿātin ṭawīlatan amāma š-šāša.",
              "nl": "B: Met andere woorden: jongeren brengen lange uren voor het scherm door."
            },
            {
              "ar": "ج: اِسْمَحوا لي، أَوَدُّ أَنْ أُضيفَ أَنَّ الحَلَّ هُوَ التَّوازُنُ.",
              "tr": "ismaḥū lī, awaddu an uḍīfa anna l-ḥalla huwa t-tawāzun.",
              "nl": "C: Staat u mij toe, ik wil toevoegen dat evenwicht de oplossing is."
            }
          ]
        }
      ]
