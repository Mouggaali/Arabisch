  "grammatica": [
    {
      "titel": "Een verhaal vertellen in het Darija",
      "blokken": [
        {
          "type": "tekst",
          "md": "Verhalen beginnen vaak met {ar|كان واحد …} (er was eens …) of {ar|واحد النهار} (op een dag). Gewoontes in het verleden maak je met {ar|كان} + كا-vorm, net als Fusha {ar|كانَ} + muḍāriʿ: {ar|كان كيخدم} (hij werkte altijd)."
        },
        {
          "type": "tabel",
          "kop": [
            "",
            "Fusha",
            "Darija"
          ],
          "rijen": [
            [
              "er was eens",
              "كانَ يا ما كانَ",
              "كان واحد …|kān wāḥəd …"
            ],
            [
              "toen",
              "عِنْدَما",
              "ملي|mlli"
            ],
            [
              "hij vond",
              "وَجَدَ",
              "لقا|lqa"
            ],
            [
              "hij deed",
              "فَعَلَ",
              "دار|dāṛ"
            ],
            [
              "kortom",
              "بِاخْتِصارٍ",
              "الحاصول|lḥāṣūl"
            ]
          ],
          "arKolommen": [
            1,
            2
          ]
        },
        {
          "type": "waarom",
          "md": "De parallel met het Fusha is groot: {ar|كان} + tegenwoordige tijd voor gewoonte, māḍī voor afzonderlijke gebeurtenissen. Wat verschilt, zijn vooral de woorden ({ar|لقا}، {ar|دار}، {ar|ملي})."
        }
      ]
    },
    {
      "titel": "Een kort verhaal",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "كان واحد الراجل كيسكن ف واحد القرية.",
              "tr": "kān wāḥəd ṛṛājəl kayskən f-wāḥəd lqarya.",
              "nl": "Er was eens een man die in een dorp woonde.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "واحد النهار مشى للسوق ولقا واحد الصندوق.",
              "tr": "wāḥəd nnhāṛ mša l-ssūq w-lqa wāḥəd ṣṣndūq.",
              "nl": "Op een dag ging hij naar de markt en vond een kist.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "ملي حلو، لقا فيه الدهب!",
              "tr": "mlli ḥəllu, lqa fīh ddhəb!",
              "nl": "Toen hij hem opendeed, vond hij er goud in!",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "الحاصول، رجع غني.",
              "tr": "lḥāṣūl, ṛjəʿ ġni.",
              "nl": "Kortom, hij werd rijk.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            }
          ]
        }
      ]
    }
  ],
