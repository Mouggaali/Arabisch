  "grammatica": [
    {
      "titel": "De ḥāl als zin (jumla ḥāliyya)",
      "blokken": [
        {
          "type": "tekst",
          "md": [
            "Een ḥāl kan ook een **hele zin** zijn, meestal ingeleid door {ar|وَ} (*terwijl*): {ar|دَخَلَ وَهُوَ يَبْتَسِمُ} (hij kwam binnen, glimlachend / terwijl hij glimlachte).",
            "Mogelijke vormen: {ar|وَ} + voornaamwoord + muḍāriʿ of naamwoord ({ar|وَهُوَ مُتْعَبٌ}), of een muḍāriʿ zonder {ar|وَ} ({ar|جاءَ يَرْكُضُ}), of {ar|وَقَدْ} + māḍī ({ar|رَجَعَ وَقَدْ تَغَيَّرَ} = hij kwam terug, (inmiddels) veranderd)."
          ]
        },
        {
          "type": "tabel",
          "kop": [
            "Type ḥāl",
            "Voorbeeld",
            "Betekenis"
          ],
          "rijen": [
            [
              "enkelvoudig (les 79)",
              "دَخَلَ مُبْتَسِمًا",
              "hij kwam glimlachend binnen"
            ],
            [
              "وَ + nominale zin",
              "دَخَلَ وَهُوَ مُبْتَسِمٌ",
              "hij kwam binnen terwijl hij glimlachte"
            ],
            [
              "muḍāriʿ",
              "جاءَ يَرْكُضُ",
              "hij kwam rennend"
            ],
            [
              "وَقَدْ + māḍī",
              "رَجَعَ وَقَدْ كَبِرَ",
              "hij kwam terug, inmiddels volwassen"
            ]
          ],
          "arKolommen": [
            1
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom {ar|وَ} als *terwijl*? Hier is {ar|وَ} niet *en* maar een **toestandsmarkering** ({ar|واوُ الحالِ}). Je herkent het doordat er direct een voornaamwoord ({ar|وَهُوَ}، {ar|وَهِيَ}) of {ar|قَدْ} volgt. Verhalen gebruiken dit heel vaak om scènes levendig te maken."
        }
      ]
    },
    {
      "titel": "Een verhaal",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "في لَيْلَةٍ مُظْلِمَةٍ طَرَقَ غَريبٌ البابَ وَهُوَ يَرْتَجِفُ مِنَ البَرْدِ.",
              "tr": "fī laylatin muẓlimatin ṭaraqa ġarībun l-bāba wa-huwa yartajifu mina l-bard.",
              "nl": "Op een donkere avond klopte een vreemdeling op de deur, bibberend van de kou.",
              "review": {
                "status": "onzeker",
                "note": "يَرْتَجِفُ (vorm VIII, bibberen) is nieuw; controleren."
              }
            },
            {
              "ar": "فَتَحَتِ العَجوزُ البابَ مُتَرَدِّدَةً.",
              "tr": "fataḥati l-ʿajūzu l-bāba mutaraddidatan.",
              "nl": "De oude vrouw deed aarzelend de deur open."
            },
            {
              "ar": "دَخَلَ الرَّجُلُ حامِلًا عَصًا قَديمَةً.",
              "tr": "daḫala r-rajulu ḥāmilan ʿaṣan qadīma.",
              "nl": "De man kwam binnen met (dragend) een oude stok."
            },
            {
              "ar": "جَلَسَ صامِتًا وَعَيْناهُ تَنْظُرانِ إِلى النّارِ.",
              "tr": "jalasa ṣāmitan wa-ʿaynāhu tanẓurāni ila n-nār.",
              "nl": "Hij ging zwijgend zitten, zijn ogen gericht op het vuur."
            },
            {
              "ar": "ثُمَّ هَمَسَ وَقَدِ ابْتَسَمَ: «شُكْرًا.»",
              "tr": "ṯumma hamasa wa-qadi btasama: šukran.",
              "nl": "Toen fluisterde hij met een glimlach: 'Dank je.'"
            }
          ]
        }
      ]
    }
  ],
