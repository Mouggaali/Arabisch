  "grammatica": [
    {
      "titel": "Het absolute object (mafʿūl muṭlaq)",
      "blokken": [
        {
          "type": "tekst",
          "md": "Het **mafʿūl muṭlaq** is de **maṣdar van hetzelfde werkwoord** in de accusatief. Het versterkt het werkwoord of beschrijft hoe iets gebeurde: {ar|تَدَرَّبَ تَدَرُّبًا} (hij trainde echt hard), {ar|نَجَحَ نَجاحًا كَبيرًا} (hij slaagde met groot succes)."
        },
        {
          "type": "tabel",
          "kop": [
            "Werkwoord",
            "Mafʿūl muṭlaq",
            "Betekenis"
          ],
          "rijen": [
            [
              "فَرِحَ",
              "فَرِحَ فَرَحًا شَديدًا",
              "hij was enorm blij"
            ],
            [
              "ضَحِكَ",
              "ضَحِكْنا ضَحِكًا",
              "we lachten (hard)"
            ],
            [
              "اِحْتَرَمَ",
              "أَحْتَرِمُهُ اِحْتِرامًا كَبيرًا",
              "ik respecteer hem zeer"
            ]
          ],
          "arKolommen": [
            1
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom de maṣdar herhalen? Het Arabisch gebruikt het als **versterking**, zoals het Nederlandse *hij lachte en lachte*. Met een bijvoeglijk naamwoord erbij ({ar|نَجاحًا كَبيرًا}) vervangt het een bijwoord: *met groot succes*."
        }
      ]
    },
    {
      "titel": "Het object van reden (mafʿūl li-ajlihi)",
      "blokken": [
        {
          "type": "tekst",
          "md": "Een **maṣdar in de accusatief** kan ook de **reden** geven: {ar|سافَرَ رَغْبَةً في التَّعَلُّمِ} (hij reisde uit verlangen om te leren). Het is een compacte vervanging van {ar|لِأَنَّهُ يَرْغَبُ في …}."
        },
        {
          "type": "letop",
          "md": "Herken het verschil: mafʿūl muṭlaq = **zelfde** wortel als het werkwoord ({ar|نَجَحَ نَجاحًا}); mafʿūl li-ajlihi = **andere** wortel, geeft een reden ({ar|تَدَرَّبَ حُبًّا في الرِّياضَةِ})."
        },
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "فازَتِ العَدّاءَةُ بِالمَيْدالِيَّةِ الذَّهَبِيَّةِ فَوْزًا مُسْتَحَقًّا.",
              "tr": "fāzati l-ʿaddāʾatu bi-l-maydāliyyati ḏ-ḏahabiyyati fawzan mustaḥaqqan.",
              "nl": "De hardloopster won verdiend de gouden medaille."
            },
            {
              "ar": "تَدَرَّبَ البَطَلُ تَدَرُّبًا يَوْمِيًّا.",
              "tr": "tadarraba l-baṭalu tadarruban yawmiyyan.",
              "nl": "De kampioen trainde dagelijks."
            },
            {
              "ar": "دَرَسَتِ الطِّبَّ حُبًّا في مُساعَدَةِ النّاسِ.",
              "tr": "darasati ṭ-ṭibba ḥubban fī musāʿadati n-nās.",
              "nl": "Ze studeerde geneeskunde uit liefde om mensen te helpen."
            },
            {
              "ar": "وَقَفَ الجُمْهورُ اِحْتِرامًا لِلّاعِبِ.",
              "tr": "waqafa l-jumhūru iḥtirāman li-l-lāʿib.",
              "nl": "Het publiek stond op uit respect voor de speler."
            },
            {
              "ar": "نَحْنُ فَخورونَ بِإِنْجازاتِكَ.",
              "tr": "naḥnu faḫūrūna bi-injāzātik.",
              "nl": "We zijn trots op je prestaties."
            }
          ]
        }
      ]
    }
  ],
