  "grammatica": [
    {
      "titel": "Op vakantie in Marokko",
      "blokken": [
        {
          "type": "tabel",
          "kop": [
            "",
            "Fusha",
            "Darija"
          ],
          "rijen": [
            [
              "strand",
              "شاطِئٌ",
              "الشط|ššəṭṭ"
            ],
            [
              "hitte",
              "حَرارَةٌ / حَرٌّ",
              "الصهد|ṣṣhəḍ"
            ],
            [
              "dorp",
              "قَرْيَةٌ",
              "الدوار|ddwwāṛ"
            ],
            [
              "rondwandelen",
              "تَجَوَّلَ",
              "تسارا|tsāṛa"
            ],
            [
              "de zomer doorbrengen",
              "قَضى الصَّيْفَ",
              "صيف|ṣyyəf"
            ]
          ],
          "arKolommen": [
            1,
            2
          ]
        },
        {
          "type": "waarom",
          "md": "Veel Marokkanen in Europa gaan 's zomers 'naar huis' ({ar|العطلة ف البلاد}). Darija maakt van zelfstandige naamwoorden gemakkelijk werkwoorden: {ar|الصيف} (zomer) → {ar|صيف} (de zomer doorbrengen). Het Fusha heeft daar een omschrijving voor nodig ({ar|قَضى الصَّيْفَ})."
        },
        {
          "type": "letop",
          "md": "{ar|الدوار} betekent oorspronkelijk *kring* (van tenten). Nu is het het woord voor een dorp op het platteland, vaak het dorp waar de familie vandaan komt."
        }
      ]
    },
    {
      "titel": "Dialoog: hoe was je zomer?",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "فين صيفتو هاد العام؟",
              "tr": "fīn ṣyyəftu hād lʿām?",
              "nl": "Waar hebben jullie dit jaar de zomer doorgebracht?",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "صيفنا ف أكادير، كنا كل نهار ف الشط.",
              "tr": "ṣyyəfna f-agādīr, kunna kull nhāṛ f-ššəṭṭ.",
              "nl": "We waren in Agadir, we zaten elke dag op het strand.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "والصهد؟",
              "tr": "w-ṣṣhəḍ?",
              "nl": "En de hitte?",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "الصهد كان بزاف، ولكن البحر زوين.",
              "tr": "ṣṣhəḍ kān bəzzāf, walākin lbəḥṛ zwīn.",
              "nl": "Het was erg heet, maar de zee is mooi.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "ومن بعد مشينا للدوار عند جدي.",
              "tr": "w-mən bəʿd mšīna l-ddwwāṛ ʿənd jəddi.",
              "nl": "En daarna gingen we naar het dorp, naar mijn opa.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "إن شاء الله نرجعو العام الجاي.",
              "tr": "in šāʾ ļļāh nəṛjʿu lʿām jjāy.",
              "nl": "Als God het wil komen we volgend jaar terug.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            }
          ]
        }
      ]
    }
  ],
