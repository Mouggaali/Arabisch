  "grammatica": [
    {
      "titel": "Eindopdracht: vertel over jezelf",
      "blokken": [
        {
          "type": "tekst",
          "md": "Dit is de afsluitende opdracht van het Darija-spoor. Vertel in het Darija over jezelf: waar je geboren en opgegroeid bent, je familie, wat je nu doet, wat je mist en wat je plannen zijn. Gebruik alle tijden die je kent: verleden ({ar|تزاديت، كبرت}), heden ({ar|كنقرا}), toekomst en wensen ({ar|غادي، بغيت نولي})."
        },
        {
          "type": "tabel",
          "kop": [
            "Onderdeel",
            "Darija",
            "Fusha"
          ],
          "rijen": [
            [
              "geboren in",
              "تزاديت ف|tzādīt f",
              "وُلِدْتُ في"
            ],
            [
              "opgegroeid in",
              "كبرت ف|kbərt f",
              "نَشَأْتُ في"
            ],
            [
              "ik wil … worden",
              "بغيت نولي|bġīt nwəlli",
              "أُريدُ أَنْ أُصْبِحَ"
            ],
            [
              "ik mis",
              "كنتوحش|kantwəḥḥəš",
              "أَشْتاقُ إِلى"
            ],
            [
              "ooit",
              "شي نهار|ši nhāṛ",
              "يَوْمًا ما"
            ]
          ],
          "arKolommen": [
            1,
            2
          ]
        },
        {
          "type": "waarom",
          "md": "{ar|تزاديت} komt van {ar|زاد} (*toenemen*): een kind *komt erbij* in de familie. Het Fusha gebruikt de lijdende vorm {ar|وُلِدْتُ}. Zulke verschillen laten zien dat Darija een eigen beeldspraak heeft, ook al zijn de wortels vaak Arabisch."
        }
      ]
    },
    {
      "titel": "Voorbeeldtekst: Sara vertelt",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "سميتي سارة، تزاديت ف أوتريخت وكبرت تما.",
              "tr": "smiyti sāṛa, tzādīt f-ūtrəxt w-kbərt təmma.",
              "nl": "Ik heet Sara, ik ben geboren in Utrecht en daar opgegroeid.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "الوالدين ديالي من الريف، وكنمشيو للبلاد كل صيف.",
              "tr": "lwālidīn dyāli mn rrīf, w-kanmšīw l-lblād kull ṣīf.",
              "nl": "Mijn ouders komen uit de Rif, en we gaan elke zomer naar Marokko.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "من الصغر كنهضر الدارجة مع جدتي.",
              "tr": "mn ṣṣġəṛ kanhḍəṛ ddārija mʿa jəddti.",
              "nl": "Van jongs af aan spreek ik Darija met mijn oma.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "دابا كنقرا العربية حيت بغيت نولي مترجمة.",
              "tr": "dāba kanqṛa lʿarabiya ḥīt bġīt nwəlli mtərjma.",
              "nl": "Nu studeer ik Arabisch, omdat ik vertaalster wil worden.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "كنتوحش البلاد بزاف ملي كنكون ف الغربة.",
              "tr": "kantwəḥḥəš lblād bəzzāf mlli kankūn f-lġurba.",
              "nl": "Ik mis Marokko erg als ik ver van huis ben.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "إن شاء الله نستقر ف المغرب شي نهار.",
              "tr": "in šāʾ ļļāh nstəqəṛṛ f-lməġrib ši nhāṛ.",
              "nl": "Als God het wil, vestig ik me ooit in Marokko.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            }
          ]
        }
      ]
    }
  ],
