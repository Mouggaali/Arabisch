        {
          "type": "waarom",
          "md": "{ar|فَإِذا بِـ} is de Arabische manier om **spanning** te maken: *ik deed de koffer open, en opeens: een brief!* Het naamwoord na {ar|بِـ} staat in de genitief; er volgt vaak een ḥāl of een zin die beschrijft wat je ziet."
        },
        {
          "type": "letop",
          "md": "{ar|لَمْ يَكَدْ … حَتّى} (*nauwelijks … of*) heeft na {ar|يَكَدْ} een muḍāriʿ en na {ar|حَتّى} een māḍī: {ar|لَمْ نَكَدْ نَصِلُ حَتّى بَدَأَ المَطَرُ}."
        }
      ]
    },
    {
      "titel": "Het geheim op zolder",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "كانَ المَطَرُ يَنْهَمِرُ عِنْدَما صَعِدْتُ إِلى العُلِّيَّةِ.",
              "tr": "kāna l-maṭaru yanhamiru ʿindamā ṣaʿidtu ila l-ʿulliyya.",
              "nl": "Het regende pijpenstelen toen ik naar de zolder ging."
            },
            {
              "ar": "فَتَحْتُ حَقيبَةً قَديمَةً، فَإِذا بِرِسالَةٍ مَنْسِيَّةٍ.",
              "tr": "fataḥtu ḥaqībatan qadīmatan, fa-iḏā bi-risālatin mansiyya.",
              "nl": "Ik opende een oude koffer, en opeens: een vergeten brief."
            },
            {
              "ar": "كانَتْ جَدَّتي قَدْ كَتَبَتْها قَبْلَ خَمْسينَ سَنَةً.",
              "tr": "kānat jaddatī qad katabathā qabla ḫamsīna sana.",
              "nl": "Mijn oma had hem vijftig jaar eerder geschreven."
            },
            {
              "ar": "لَمْ أَكَدْ أَقْرَأُ السَّطْرَ الأَوَّلَ حَتّى سالَتْ دُموعي.",
              "tr": "lam akad aqraʾu s-saṭra l-awwala ḥattā sālat dumūʿī.",
              "nl": "Ik had nauwelijks de eerste regel gelezen of de tranen stroomden."
            },
            {
              "ar": "في تِلْكَ اللَّحْظَةِ فَهِمْتُ سِرَّ العائِلَةِ.",
              "tr": "fī tilka l-laḥẓati fahimtu sirra l-ʿāʾila.",
              "nl": "Op dat moment begreep ik het familiegeheim."
            },
            {
              "ar": "وَمُنْذُ ذٰلِكَ الحينِ أَحْتَفِظُ بِالرِّسالَةِ في دُرْجِ مَكْتَبي.",
              "tr": "wa-munḏu ḏālika l-ḥīni aḥtafiẓu bi-r-risālati fī durji maktabī.",
              "nl": "En sindsdien bewaar ik de brief in de la van mijn bureau."
            }
          ]
        }
      ]
    }
  ],
