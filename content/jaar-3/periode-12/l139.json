      ]
    },
    {
      "titel": "Modelbetoog: in het buitenland studeren",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "يَحْلُمُ كَثيرٌ مِنَ الشَّبابِ بِالدِّراسَةِ في الخارِجِ، وَأَرى أَنَّها تَجْرِبَةٌ مُفيدَةٌ جِدًّا.",
              "tr": "yaḥlumu kaṯīrun mina š-šabābi bi-d-dirāsati fi l-ḫārij, wa-arā annahā tajribatun mufīdatun jiddan.",
              "nl": "Veel jongeren dromen van studeren in het buitenland, en ik vind het een zeer nuttige ervaring."
            },
            {
              "ar": "في المَقامِ الأَوَّلِ، يَتَعَلَّمُ الطّالِبُ أَنْ يَكونَ مُسْتَقِلًّا.",
              "tr": "fi l-maqāmi l-awwal, yataʿallamu ṭ-ṭālibu an yakūna mustaqillan.",
              "nl": "In de eerste plaats leert de student zelfstandig te zijn."
            },
            {
              "ar": "عَلاوَةً عَلى ذٰلِكَ، تُوَسِّعُ الدِّراسَةُ في الخارِجِ آفاقَهُ.",
              "tr": "ʿalāwatan ʿalā ḏālik, tuwassiʿu d-dirāsatu fi l-ḫāriji āfāqah.",
              "nl": "Bovendien verbreedt studeren in het buitenland zijn horizon."
            },
            {
              "ar": "لا يُمْكِنُ إِنْكارُ أَنَّ تَكاليفَ المَعيشَةِ مُرْتَفِعَةٌ، لٰكِنَّ المِنَحَ الدِّراسِيَّةَ كَثيرَةٌ.",
              "tr": "lā yumkinu inkāru anna takālīfa l-maʿīšati murtafiʿa, lākinna l-minaḥa d-dirāsiyyata kaṯīra.",
              "nl": "Het valt niet te ontkennen dat de kosten van levensonderhoud hoog zijn, maar er zijn veel studiebeurzen."
            },
            {
              "ar": "خُلاصَةُ القَوْلِ، إِنَّ الدِّراسَةَ في الخارِجِ تَجْرِبَةٌ لا تُنْسى تَسْتَحِقُّ الجُهْدَ.",
              "tr": "ḫulāṣatu l-qawl, inna d-dirāsata fi l-ḫāriji tajribatun lā tunsā tastaḥiqqu l-juhd.",
              "nl": "Kortom: studeren in het buitenland is een onvergetelijke ervaring die de moeite waard is."
            }
          ]
        }
      ]
    }
