  "grammatica": [
    {
      "titel": "Het luisterexamen",
      "blokken": [
        {
          "type": "tabel",
          "kop": [
            "Stap",
            "Wat je doet"
          ],
          "rijen": [
            [
              "vóór het luisteren",
              "lees de vragen en onderstreep de vraagwoorden (wie, wat, waarom, wanneer)"
            ],
            [
              "1e keer luisteren",
              "luister naar het geheel: wie praat er, waarover, met welke toon?"
            ],
            [
              "2e keer luisteren",
              "vul de details in: getallen, tijden, namen"
            ],
            [
              "na het luisteren",
              "kies; twijfel je, kies dan het antwoord dat bij de toon past"
            ]
          ],
          "arKolommen": []
        },
        {
          "type": "waarom",
          "md": "Bij een B1-luisterexamen hoor je het fragment meestal **twee keer** ({ar|مَرَّتَيْنِ}). Gebruik de eerste keer voor de grote lijn en de tweede voor details. Vragen naar de **toon** ({ar|نَبْرَةٌ}) of het **doel** van een gesprek kun je alleen beantwoorden als je het geheel begrijpt."
        },
        {
          "type": "letop",
          "md": "Sommige vragen gaan over een verandering: *de vergadering is verplaatst* ({ar|أُجِّلَ}), *in plaats van dinsdag* ({ar|بَدَلًا مِنَ الثُّلاثاءِ}). Let op het **nieuwe** gegeven, niet het oude."
        }
      ]
    },
    {
      "titel": "De toon van de spreker",
      "blokken": [
        {
          "type": "tabel",
          "kop": [
            "Toon",
            "Woord",
            "Typisch zinnetje"
          ],
          "rijen": [
            [
              "optimistisch",
              "مُتَفائِلٌ",
              "أَنا مُتَأَكِّدٌ أَنَّ كُلَّ شَيْءٍ سَيَكونُ بِخَيْرٍ"
            ],
            [
              "pessimistisch",
              "مُتَشائِمٌ",
              "لا أَظُنُّ أَنَّ هٰذا سَيَنْجَحُ"
            ],
            [
              "geïrriteerd",
              "مُنْزَعِجٌ",
              "هٰذِهِ ثالِثُ مَرَّةٍ!"
            ],
            [
              "bezorgd",
              "قَلِقٌ",
              "أَخْشى أَنْ …"
            ],
            [
              "sarcastisch",
              "ساخِرٌ",
              "يا لَها مِنْ فِكْرَةٍ عَبْقَرِيَّةٍ!"
            ]
          ],
          "arKolommen": [
            1,
            2
          ]
        },
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "أَهْلًا، أَتَّصِلُ لِأُخْبِرَكَ أَنَّ الاِجْتِماعَ أُجِّلَ إِلى يَوْمِ الخَميسِ بَدَلًا مِنَ الثُّلاثاءِ.",
              "tr": "ahlan, attaṣilu li-uḫbiraka anna l-ijtimāʿa ujjila ilā yawmi l-ḫamīsi badalan mina ṯ-ṯulāṯāʾ.",
              "nl": "Hallo, ik bel om je te zeggen dat de vergadering verzet is naar donderdag in plaats van dinsdag."
            },
            {
              "ar": "هٰذِهِ ثالِثُ مَرَّةٍ يَتَأَخَّرُ فيها القِطارُ هٰذا الأُسْبوعَ!",
              "tr": "hāḏihi ṯāliṯu marratin yataʾaḫḫaru fīha l-qiṭāru hāḏa l-usbūʿ!",
              "nl": "Dit is de derde keer deze week dat de trein te laat is!"
            },
            {
              "ar": "أَخْشى أَلّا نَجِدَ مَكانًا في الفُنْدُقِ.",
              "tr": "aḫšā allā najida makānan fi l-funduq.",
              "nl": "Ik ben bang dat we geen plaats in het hotel vinden."
            }
          ]
        }
      ]
