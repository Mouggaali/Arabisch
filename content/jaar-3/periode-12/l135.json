          ]
        },
        {
          "type": "waarom",
          "md": "In een maatschappelijk debat wil je laten zien dat je **beide kanten** ziet. Deze constructies doen precies dat: {ar|سَواءٌ … أَمْ} zegt dat iets voor beide groepen geldt, {ar|لَيْسَ فَقَطْ … بَلْ} voegt een tweede, sterker punt toe."
        },
        {
          "type": "letop",
          "md": "Na {ar|سَواءٌ} staat vaak de vraagpartikel {ar|أَ} en daarna {ar|أَمْ} (niet {ar|أَوْ}): {ar|سَواءٌ أَكانَ … أَمْ …}."
        }
      ]
    },
    {
      "titel": "Debat: het Darija op school?",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "أَصْبَحَتْ قَضِيَّةُ تَدْريسِ الدّارِجَةِ مُثيرَةً لِلْجَدَلِ في المَغْرِبِ.",
              "tr": "aṣbaḥat qaḍiyyatu tadrīsi d-dārijati muṯīratan li-l-jadali fi l-maġrib.",
              "nl": "De kwestie of het Darija onderwezen moet worden is in Marokko omstreden geraakt."
            },
            {
              "ar": "يَرى بَعْضُهُمْ أَنَّ الدّارِجَةَ لَيْسَتْ لُغَةَ البَيْتِ فَقَطْ، بَلْ هِيَ أَيْضًا جُزْءٌ مِنَ الهُوِيَّةِ.",
              "tr": "yarā baʿḍuhum anna d-dārijata laysat luġata l-bayti faqaṭ, bal hiya ayḍan juzʾun mina l-huwiyya.",
              "nl": "Sommigen vinden dat het Darija niet alleen de taal van thuis is, maar ook een deel van de identiteit."
            },
            {
              "ar": "وَيَخْشى التَّيّارُ المُحافِظُ أَنْ تُهَدِّدَ الدّارِجَةُ مَكانَةَ الفُصْحى.",
              "tr": "wa-yaḫša t-tayyāru l-muḥāfiẓu an tuhaddida d-dārijatu makānata l-fuṣḥā.",
              "nl": "De conservatieve stroming vreest dat het Darija de positie van het Fusha bedreigt."
            },
            {
              "ar": "سَواءٌ أَكُنْتَ مُؤَيِّدًا أَمْ مُعارِضًا، فَالحِوارُ ضَرورِيٌّ.",
              "tr": "sawāʾun a-kunta muʾayyidan am muʿāriḍan, fa-l-ḥiwāru ḍarūriyy.",
              "nl": "Of je nu voor of tegen bent: dialoog is noodzakelijk."
            },
            {
              "ar": "لا المُعَلِّمونَ وَلا الأُسَرُ يَتَّفِقونَ عَلى حَلٍّ واحِدٍ.",
              "tr": "lā l-muʿallimūna wa-la l-usaru yattafiqūna ʿalā ḥallin wāḥid.",
              "nl": "Noch de leraren, noch de gezinnen zijn het eens over één oplossing."
            }
          ]
        }
      ]
    }
  ],
