            ],
            [
              "leenwoorden",
              "Frans en Spaans",
              "الطوموبيل، البلاصة، الكابين"
            ]
          ],
          "arKolommen": [
            1,
            2
          ]
        },
        {
          "type": "waarom",
          "md": "Met dertig Darija-lessen heb je een **A2-basis**: je kunt in Marokko boodschappen doen, de weg vragen, met familie praten en over jezelf vertellen. Omdat Darija geen vaste spelling heeft, blijft **luisteren naar echte sprekers** de beste manier om verder te komen."
        },
        {
          "type": "letop",
          "md": "Alle Darija-inhoud in deze cursus is gemarkeerd voor controle door een moedertaalspreker. Uitspraak en woordkeus verschillen per regio (Noord, Rif, Souss, Casablanca …)."
        }
      ]
    },
    {
      "titel": "Afscheid van de cursus",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "تعلمت بزاف ديال الحوايج ف هاد الكورس.",
              "tr": "tʿəlləmt bəzzāf dyāl lḥwāyəj f-hād lkūṛ.",
              "nl": "Ik heb veel dingen geleerd in deze cursus.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "الدارجة ماشي صعيبة، بشوية بشوية كتولي ساهلة.",
              "tr": "ddārija māši ṣʿība, b-šwiya b-šwiya katwəlli sāhla.",
              "nl": "Darija is niet moeilijk; beetje bij beetje wordt het makkelijk.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "إلا ما فهمتيش شي حاجة، قول ليهم: عاود عافاك.",
              "tr": "ila ma fhəmtīš ši ḥāja, qūl līhum: ʿāwəd ʿāfāk.",
              "nl": "Als je iets niet begrijpt, zeg dan: herhaal het alsjeblieft.",
              "review": {
                "status": "onzeker",
                "note": "Darija-zin laten nakijken."
              }
            },
            {
              "ar": "سالينا! الله يوفقك وبالتوفيق ف الامتحان.",
