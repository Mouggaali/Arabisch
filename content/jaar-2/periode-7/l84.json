  "grammatica": [
    {
      "titel": "Verbindingswoorden van tijd",
      "blokken": [
        {
          "type": "tabel",
          "kop": [
            "Woord",
            "Betekenis",
            "Werkwoord erna",
            "Voorbeeld"
          ],
          "rijen": [
            [
              "عِنْدَما",
              "toen / wanneer",
              "māḍī of muḍāriʿ",
              "عِنْدَما وَصَلْتُ، …"
            ],
            [
              "بَيْنَما",
              "terwijl",
              "meestal muḍāriʿ of nominale zin",
              "بَيْنَما كُنْتُ أَنْتَظِرُ، …"
            ],
            [
              "بَعْدَ أَنْ",
              "nadat",
              "māḍī",
              "بَعْدَ أَنْ أَكَلْنا، …"
            ],
            [
              "قَبْلَ أَنْ",
              "voordat",
              "muḍāriʿ (manṣūb)",
              "قَبْلَ أَنْ أَنامَ، …"
            ]
          ],
          "arKolommen": [
            0,
            3
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom {ar|قَبْلَ أَنْ} + muḍāriʿ maar {ar|بَعْدَ أَنْ} + māḍī? *Voordat* verwijst naar iets wat **nog niet** gebeurd was (dus muḍāriʿ, zoals na {ar|أَنْ}); *nadat* naar iets wat **al** gebeurd is (māḍī). De logica van de tijd bepaalt de vorm, niet de tijd van het verhaal."
        },
        {
          "type": "letop",
          "md": "{ar|قَبْلَ} en {ar|بَعْدَ} kunnen ook gewoon met een maṣdar: {ar|قَبْلَ النَّوْمِ} (voor het slapen), {ar|بَعْدَ الأَكْلِ} (na het eten)."
        }
      ]
    },
    {
      "titel": "Het verhaal: de handtas",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "ذاتَ يَوْمٍ، بَيْنَما كانَتْ سارَةُ تَنْتَظِرُ الحافِلَةَ، اِقْتَرَبَ مِنْها رَجُلٌ.",
              "tr": "ḏāta yawmin, baynamā kānat Sāratu tantaẓiru l-ḥāfila, iqtaraba minhā rajul.",
              "nl": "Op een dag, terwijl Sara op de bus wachtte, kwam er een man naar haar toe."
            },
            {
              "ar": "فَجْأَةً سَرَقَ حَقيبَةَ يَدِها وَرَكَضَ.",
              "tr": "fajʾatan saraqa ḥaqībata yadihā wa-rakaḍ.",
              "nl": "Plotseling stal hij haar handtas en rende weg."
            },
            {
              "ar": "صَرَخَتْ سارَةُ: «لِصٌّ! لِصٌّ!»",
              "tr": "ṣaraḫat Sāratu: liṣṣ! liṣṣ!",
              "nl": "Sara schreeuwde: 'Een dief! Een dief!'"
            },
            {
              "ar": "رَكَضَ شُرْطِيٌّ وَراءَهُ وَأَمْسَكَ بِهِ بَعْدَ أَنْ عَبَرَ الشّارِعَ.",
              "tr": "rakaḍa šurṭiyyun warāʾahu wa-amsaka bihi baʿda an ʿabara š-šāriʿ.",
              "nl": "Een agent rende hem achterna en greep hem nadat hij de straat was overgestoken."
            },
            {
              "ar": "في النِّهايَةِ شَكَرَتْ سارَةُ الشُّرْطِيَّ قَبْلَ أَنْ تَرْكَبَ الحافِلَةَ.",
              "tr": "fi n-nihāyati šakarat Sāratu š-šurṭiyya qabla an tarkaba l-ḥāfila.",
              "nl": "Uiteindelijk bedankte Sara de agent voordat ze in de bus stapte."
            }
          ]
        }
      ]
    }
  ],
