  "grammatica": [
    {
      "titel": "Het passief deelwoord",
      "blokken": [
        {
          "type": "tekst",
          "md": [
            "Vorm I: **مَفْعول** ({ar|كَتَبَ} → {ar|مَكْتوبٌ}, geschreven). Afgeleide vormen: zoals het actief deelwoord, maar met **a** voor de laatste letter ({ar|مُسْتَخْدِمٌ} gebruiker ↔ {ar|مُسْتَخْدَمٌ} gebruikt).",
            "Het passief deelwoord beschrijft het **resultaat** van een handeling: iets is geschreven, gesloten, gereserveerd."
          ]
        },
        {
          "type": "tabel",
          "kop": [
            "Vorm",
            "Actief (wie doet)",
            "Passief (wat gedaan is)"
          ],
          "arKolommen": [
            1,
            2
          ],
          "rijen": [
            [
              "I",
              "كاتِبٌ",
              "مَكْتوبٌ"
            ],
            [
              "II",
              "مُرَتِّبٌ",
              "مُرَتَّبٌ"
            ],
            [
              "IV",
              "مُغْلِقٌ",
              "مُغْلَقٌ"
            ],
            [
              "VIII",
              "مُنْتَظِرٌ",
              "مُنْتَظَرٌ"
            ],
            [
              "X",
              "مُسْتَعْمِلٌ",
              "مُسْتَعْمَلٌ"
            ]
          ]
        },
        {
          "type": "waarom",
          "md": "Bij afgeleide vormen verschilt actief en passief maar in **één klinker**: *i* (actief) of *a* (passief) vóór de laatste letter. Zonder harakat zien {ar|مستعمل} (gebruiker) en {ar|مستعمل} (gebruikt) er hetzelfde uit; de context beslist. Dat is een van de redenen waarom je harakat leert lezen."
        },
        {
          "type": "letop",
          "md": "Bordjes gebruiken vaak een **maṣdar** of **passief deelwoord** zonder werkwoord: {ar|الدُّخولُ مَجّانًا} (toegang gratis), {ar|التَّدْخينُ مَمْنوعٌ} (roken verboden), {ar|مُغْلَقٌ} (gesloten)."
        }
      ]
