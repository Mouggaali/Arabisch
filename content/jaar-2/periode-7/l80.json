  "grammatica": [
    {
      "titel": "أَنْ of أَنَّ?",
      "blokken": [
        {
          "type": "tekst",
          "md": [
            "Beide betekenen *dat*, maar ze werken heel anders:",
            "**أَنْ** + **werkwoord** (manṣūb): {ar|أُريدُ أَنْ أَعْمَلَ} (ik wil werken). **أَنَّ** + **naamwoord/suffix** (accusatief) + gezegde: {ar|أَعْرِفُ أَنَّ العَمَلَ صَعْبٌ} (ik weet dat het werk moeilijk is)."
          ]
        },
        {
          "type": "tabel",
          "kop": [
            "",
            "أَنْ",
            "أَنَّ"
          ],
          "rijen": [
            [
              "wat volgt",
              "muḍāriʿ (manṣūb) of māḍī",
              "naamwoord in de accusatief of suffix"
            ],
            [
              "na werkwoorden van",
              "willen, kunnen, proberen, hopen, besluiten",
              "weten, denken, horen, zeggen (أَنَّ / إِنَّ)"
            ],
            [
              "voorbeeld",
              "أُحاوِلُ أَنْ أَفْهَمَ",
              "أَظُنُّ أَنَّها مُحِقَّةٌ"
            ]
          ],
          "arKolommen": [
            1,
            2
          ]
        },
        {
          "type": "waarom",
          "md": "Vuistregel: *willen / moeten / proberen* richten zich op een **handeling** → {ar|أَنْ} + werkwoord. *Weten / denken / horen* gaan over een **feit** → {ar|أَنَّ} + zin. Je kunt {ar|أَنْ} + werkwoord vaak vertalen met *te* (ik probeer **te** begrijpen); {ar|أَنَّ} nooit."
        },
        {
          "type": "letop",
          "md": "Na {ar|قالَ} gebruik je {ar|إِنَّ}, niet {ar|أَنَّ}: {ar|قالَ إِنَّهُ مَشْغولٌ}."
        }
      ]
    },
    {
      "titel": "Het sollicitatiegesprek",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "تَقَدَّمْتُ لِوَظيفَةٍ في شَرِكَةٍ كَبيرَةٍ.",
              "tr": "taqaddamtu li-waẓīfatin fī šarikatin kabīra.",
              "nl": "Ik heb gesolliciteerd naar een baan bij een groot bedrijf."
            },
            {
              "ar": "أُريدُ أَنْ أَعْمَلَ في فَريقٍ.",
              "tr": "urīdu an aʿmala fī farīq.",
              "nl": "Ik wil in een team werken."
            },
            {
              "ar": "أَعْتَقِدُ أَنَّ خِبْرَتي مُناسِبَةٌ لِهٰذِهِ الوَظيفَةِ.",
              "tr": "aʿtaqidu anna ḫibratī munāsibatun li-hāḏihi l-waẓīfa.",
              "nl": "Ik denk dat mijn ervaring past bij deze baan."
            },
            {
              "ar": "سَمِعْتُ أَنَّ الشَّرِكَةَ تَبْحَثُ عَنْ مُهَنْدِسينَ.",
              "tr": "samiʿtu anna š-šarikata tabḥaṯu ʿan muhandisīn.",
              "nl": "Ik hoorde dat het bedrijf ingenieurs zoekt."
            },
            {
              "ar": "أَتَمَنّى أَنْ يَنْجَحَ طَلَبي.",
              "tr": "atamannā an yanjaḥa ṭalabī.",
              "nl": "Ik hoop dat mijn sollicitatie slaagt."
            }
          ]
        }
      ]
    }
