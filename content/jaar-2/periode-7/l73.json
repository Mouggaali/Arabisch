  "grammatica": [
    {
      "titel": "De overtreffende trap: أَفْعَلُ + iḍāfa",
      "blokken": [
        {
          "type": "tekst",
          "md": [
            "Zet {ar|أَفْعَلُ} vóór een **onbepaald enkelvoud** in de genitief: {ar|أَكْبَرُ مَدينَةٍ} = de grootste stad. Of vóór een **bepaald meervoud**: {ar|أَكْبَرُ المُدُنِ} = de grootste van de steden.",
            "{ar|أَفْعَلُ} blijft ook hier onveranderd, ook bij vrouwelijke woorden: {ar|أَجْمَلُ مَدينَةٍ}."
          ]
        },
        {
          "type": "tabel",
          "kop": [
            "Constructie",
            "Voorbeeld",
            "Betekenis"
          ],
          "arKolommen": [
            1
          ],
          "rijen": [
            [
              "أَفْعَلُ + onbepaald enkelvoud",
              "أَكْبَرُ مَدينَةٍ في المَغْرِبِ",
              "de grootste stad van Marokko"
            ],
            [
              "أَفْعَلُ + bepaald meervoud",
              "أَقْدَمُ المُدُنِ",
              "de oudste van de steden"
            ],
            [
              "الأَفْعَلُ (m) als bijv. nw",
              "البُرْجُ الأَعْلى",
              "de hoogste toren"
            ],
            [
              "الفُعْلى (v) als bijv. nw",
              "المَدينَةُ الكُبْرى",
              "de grootste stad"
            ]
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom een iḍāfa? Letterlijk zeg je *de grootste van (een) stad*: {ar|أَكْبَرُ} is het 'hoofd' van de iḍāfa. De vrouwelijke vorm {ar|الكُبْرى} bestaat alleen voor een paar veelgebruikte woorden ({ar|الكُبْرى}، {ar|الصُّغْرى}، {ar|العُلْيا}، {ar|الأولى}); bij de meeste woorden gebruik je gewoon de iḍāfa."
        },
        {
          "type": "letop",
          "md": "{ar|أَعْلى} eindigt op ى (zwakke wortel ع-ل-و), zoals {ar|أَغْلى} in les 45. Ook {ar|أَكْثَرُ} + accusatief (tamyīz) kan: {ar|أَكْثَرُ المُدُنِ سُكّانًا} = de stad met de meeste inwoners."
        }
      ]
    },
    {
      "titel": "Steden vergelijken",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "الدّارُ البَيْضاءُ أَكْبَرُ مَدينَةٍ في المَغْرِبِ.",
              "tr": "ad-dāru l-bayḍāʾu akbaru madīnatin fi l-Maġrib.",
              "nl": "Casablanca is de grootste stad van Marokko."
            },
            {
              "ar": "فاسُ مِنْ أَقْدَمِ المُدُنِ العَرَبِيَّةِ.",
              "tr": "Fāsu min aqdami l-mudani l-ʿarabiyya.",
              "nl": "Fez is een van de oudste Arabische steden."
            },
            {
              "ar": "بُرْجُ خَليفَةَ أَعْلى بِناءٍ في العالَمِ.",
              "tr": "burju Ḫalīfata aʿlā bināʾin fi l-ʿālam.",
              "nl": "De Burj Khalifa is het hoogste gebouw ter wereld."
            },
            {
              "ar": "القاهِرَةُ أَكْثَرُ المُدُنِ العَرَبِيَّةِ سُكّانًا.",
              "tr": "al-Qāhiratu akṯaru l-mudani l-ʿarabiyyati sukkānan.",
              "nl": "Caïro is de Arabische stad met de meeste inwoners."
            },
            {
              "ar": "مَرّاكُشُ مَشْهورَةٌ بِساحَةِ جامِعِ الفَنا.",
