              "nl": "De kinderen slapen in de auto."
            },
            {
              "ar": "آسِفٌ، أَنا مُسْتَعْجِلٌ.",
              "tr": "āsifun, ana mustaʿjil.",
              "nl": "Sorry, ik heb haast."
            }
          ]
        }
      ]
    }
