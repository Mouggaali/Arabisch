  "grammatica": [
    {
      "titel": "Het actief deelwoord",
      "blokken": [
        {
          "type": "tekst",
          "md": [
            "Vorm I: **فاعِل** ({ar|ذاهِبٌ}، {ar|جالِسٌ}). Afgeleide vormen: **مُـ + muḍāriʿ-stam** ({ar|مُنْتَظِرٌ}، {ar|مُسْتَعْجِلٌ}).",
            "Het deelwoord is een **naamwoord**: het verbuigt naar naamval, geslacht en getal ({ar|ذاهِبَةٌ}، {ar|ذاهِبونَ})."
          ]
        },
        {
          "type": "tabel",
          "kop": [
            "Gebruik",
            "Voorbeeld",
            "Betekenis"
          ],
          "arKolommen": [
            1
          ],
          "rijen": [
            [
              "zelfstandig naamwoord",
              "الرّاكِبُ",
              "de passagier"
            ],
            [
              "bijvoeglijk naamwoord",
              "رَجُلٌ واقِفٌ",
              "een staande man"
            ],
            [
              "werkwoordelijk (nu bezig)",
              "أَنا ذاهِبٌ إِلى العَمَلِ.",
              "ik ben op weg naar mijn werk"
            ],
            [
              "werkwoordelijk (resultaat)",
              "هُوَ راجِعٌ مِنَ السَّفَرِ.",
              "hij is terug van reis"
            ]
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom een deelwoord in plaats van een werkwoord? Bij werkwoorden van **beweging en houding** ({ar|ذاهِبٌ}، {ar|جالِسٌ}، {ar|نائِمٌ}) beschrijft het deelwoord een **toestand nu**, zoals het Nederlandse *ik ben op weg*. {ar|أَذْهَبُ} betekent eerder *ik ga (gewoonlijk)*. Daarom hoor je in gesprekken vaak {ar|أَنا ذاهِبٌ}."
        },
        {
          "type": "letop",
          "md": "Bij **holle** werkwoorden wordt de middelste letter **ئ**: {ar|نامَ} → {ar|نائِمٌ}، {ar|قالَ} → {ar|قائِلٌ}. Bij **defectieve** valt de laatste weg: {ar|ماشٍ} (met lidwoord {ar|الماشي})."
        }
      ]
    },
    {
      "titel": "Onderweg",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "أَنا في الطَّريقِ، أَنا قادِمٌ!",
              "tr": "ana fi ṭ-ṭarīq, ana qādim!",
              "nl": "Ik ben onderweg, ik kom eraan!"
            },
            {
              "ar": "كانَ الرُّكّابُ واقِفينَ في الحافِلَةِ.",
              "tr": "kāna r-rukkābu wāqifīna fi l-ḥāfila.",
              "nl": "De passagiers stonden in de bus."
            },
            {
              "ar": "هَلْ أَنْتِ ذاهِبَةٌ إِلى المَحَطَّةِ؟",
              "tr": "hal anti ḏāhibatun ila l-maḥaṭṭa?",
              "nl": "Ga jij (v) naar het station?"
