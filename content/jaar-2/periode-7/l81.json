  "grammatica": [
    {
      "titel": "Tamyīz: specificatie in de accusatief",
      "blokken": [
        {
          "type": "tekst",
          "md": "Een **tamyīz** legt uit *waarin* iets geldt. Het staat als onbepaald naamwoord in de **accusatief** na een maat, een getal of een vergelijking: {ar|عِشْرونَ لِتْرًا} (twintig liter), {ar|أَكْثَرُ تَلَوُّثًا} (meer vervuild, letterlijk: meer qua vervuiling), {ar|اِمْتَلَأَ الكَأْسُ ماءً} (het glas raakte vol met water)."
        },
        {
          "type": "tabel",
          "kop": [
            "Na …",
            "Voorbeeld",
            "Betekenis"
          ],
          "rijen": [
            [
              "getal 11–99",
              "ثَلاثونَ نَوْعًا",
              "dertig soorten"
            ],
            [
              "أَفْعَلُ (vergelijking)",
              "المُدُنُ أَكْثَرُ تَلَوُّثًا",
              "steden zijn meer vervuild"
            ],
            [
              "كَمْ (vraag)",
              "كَمْ لِتْرًا؟",
              "hoeveel liter?"
            ],
            [
              "maat",
              "كيلو لَحْمًا",
              "een kilo vlees"
            ]
          ],
          "arKolommen": [
            1
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom accusatief? De tamyīz verduidelijkt een woord dat op zichzelf **vaag** is (*hoeveel? meer waarvan?*). Net als de ḥāl en tijdsbepalingen is het een 'extra' bij de zin, en die staan in de accusatief."
        },
        {
          "type": "letop",
          "md": "{ar|كَمْ} als **vraag** + accusatief enkelvoud ({ar|كَمْ طالِبًا؟}); {ar|كَمْ} als **uitroep** (*hoeveel …!*) + genitief ({ar|كَمْ مِنْ مَرَّةٍ قُلْتُ لَكَ!} = hoe vaak heb ik je niet gezegd!)."
        }
      ]
    },
    {
      "titel": "Het milieu",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "تَسْتَهْلِكُ العائِلَةُ مِئَتَيْ لِتْرٍ مِنَ الماءِ يَوْمِيًّا.",
              "tr": "tastahliku l-ʿāʾilatu miʾatay litrin mina l-māʾi yawmiyyan.",
              "nl": "Het gezin verbruikt dagelijks tweehonderd liter water."
            },
            {
              "ar": "المُدُنُ الكَبيرَةُ أَكْثَرُ تَلَوُّثًا مِنَ القُرى.",
              "tr": "al-mudunu l-kabīratu akṯaru talawwuṯan mina l-qurā.",
              "nl": "Grote steden zijn meer vervuild dan dorpen."
            },
            {
              "ar": "كَمْ طُنًّا مِنَ النُّفاياتِ نُنْتِجُ كُلَّ سَنَةٍ؟",
              "tr": "kam ṭunnan mina n-nufāyāti nuntiju kulla sana?",
              "nl": "Hoeveel ton afval produceren we elk jaar?"
            },
            {
              "ar": "يَجِبُ أَنْ نُحافِظَ عَلى البيئَةِ.",
              "tr": "yajibu an nuḥāfiẓa ʿala l-bīʾa.",
              "nl": "We moeten het milieu beschermen."
            },
            {
              "ar": "في الغابَةِ أَكْثَرُ مِنْ مِئَةِ نَوْعٍ مِنَ الطُّيورِ.",
              "tr": "fi l-ġābati akṯaru min miʾati nawʿin mina ṭ-ṭuyūr.",
              "nl": "In het bos leven meer dan honderd soorten vogels."
            }
          ]
        }
      ]
    }
  ],
