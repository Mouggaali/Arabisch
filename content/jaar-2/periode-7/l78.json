  "grammatica": [
    {
      "titel": "Gewoonte en duur in het verleden: كانَ + muḍāriʿ",
      "blokken": [
        {
          "type": "tekst",
          "md": "{ar|كانَ} + muḍāriʿ beschrijft wat je **vroeger gewoonlijk deed** of **aan het doen was**: {ar|كُنْتُ أَلْعَبُ في الشّارِعِ} (ik speelde altijd op straat). {ar|كانَ} wordt vervoegd, het muḍāriʿ ook."
        },
        {
          "type": "tabel",
          "kop": [
            "Vorm",
            "Voorbeeld",
            "Betekenis"
          ],
          "rijen": [
            [
              "māḍī",
              "لَعِبْتُ",
              "ik speelde (één keer)"
            ],
            [
              "كانَ + muḍāriʿ",
              "كُنْتُ أَلْعَبُ",
              "ik speelde (altijd), ik was aan het spelen"
            ],
            [
              "قَدْ + māḍī",
              "قَدْ لَعِبْتُ",
              "ik heb al gespeeld"
            ],
            [
              "لَنْ + manṣūb",
              "لَنْ أَلْعَبَ",
              "ik zal niet spelen"
            ]
          ],
          "arKolommen": [
            1
          ]
        },
        {
          "type": "waarom",
          "md": "Het Arabisch heeft maar twee echte tijden. Fijnere betekenissen maak je met hulpwoorden: {ar|كانَ} schuift de muḍāriʿ naar het verleden (zoals de Nederlandse *onvoltooid verleden tijd*), {ar|قَدْ} benadrukt dat iets **al gebeurd** is."
        }
      ]
    },
    {
      "titel": "Mijn jeugd",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "في صِغَري كُنْتُ أَسْكُنُ في حَيٍّ شَعْبِيٍّ.",
              "tr": "fī ṣiġarī kuntu askunu fī ḥayyin šaʿbiyy.",
              "nl": "Toen ik klein was, woonde ik in een volkswijk."
            },
            {
              "ar": "كانَتْ جَدَّتي تَحْكي لَنا حِكاياتٍ كُلَّ لَيْلَةٍ.",
              "tr": "kānat jaddatī taḥkī lanā ḥikāyātin kulla layla.",
              "nl": "Mijn oma vertelde ons elke avond verhalen."
            },
            {
              "ar": "كُنّا نَلْعَبُ الكُرَةَ في الشّارِعِ.",
              "tr": "kunnā nalʿabu l-kurata fi š-šāriʿ.",
              "nl": "We voetbalden altijd op straat."
            },
            {
              "ar": "قَدْ كَبِرْتُ، لٰكِنّي ما زِلْتُ أَتَذَكَّرُ تِلْكَ الأَيّامَ.",
              "tr": "qad kabirtu, lākinnī mā ziltu ataḏakkaru tilka l-ayyām.",
              "nl": "Ik ben inmiddels volwassen, maar ik herinner me die dagen nog."
            },
            {
              "ar": "لَنْ أَنْسى طُفولَتي.",
              "tr": "lan ansā ṭufūlatī.",
              "nl": "Ik zal mijn kindertijd nooit vergeten."
            }
          ]
        },
        {
          "type": "letop",
          "md": "{ar|قَدْ} + **muḍāriʿ** betekent iets anders: *misschien, soms* ({ar|قَدْ يَتَأَخَّرُ} = hij komt misschien te laat)."
        }
      ]
    }
  ],
