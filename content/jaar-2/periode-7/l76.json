              "اللَّتانِ"
            ],
            [
              "dualis (acc./gen.)",
              "اللَّذَيْنِ",
              "اللَّتَيْنِ"
            ],
            [
              "meervoud (personen)",
              "الَّذينَ",
              "اللَّواتي / اللّاتي"
            ]
          ]
        },
        {
          "type": "tekst",
          "md": "Je gebruikt deze woorden alleen na een **bepaald** woord: {ar|الرَّجُلُ الَّذي …} (de man die …). Ze volgen het geslacht en getal van dat woord. Niet-menselijke meervouden krijgen {ar|الَّتي}."
        },
        {
          "type": "waarom",
          "md": "Waarom een **terugverwijzend voornaamwoord** ({ar|عائِدٌ})? In het Arabisch is de bijzin een volledige zin die naar het hoofdwoord terugwijst: {ar|الرَّجُلُ الَّذي رَأَيْتُهُ} = *de man die ik zag-hem*. In het Nederlands laat je dat *hem* weg; in het Arabisch is het verplicht, behalve als het hoofdwoord zelf het onderwerp van de bijzin is ({ar|الرَّجُلُ الَّذي يَسْكُنُ هُنا})."
        }
      ]
    },
    {
      "titel": "Met en zonder ʿāʾid",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "الرَّجُلُ الَّذي يَسْكُنُ بِجانِبِنا طَبيبٌ.",
              "tr": "ar-rajulu llaḏī yaskunu bi-jānibinā ṭabīb.",
              "nl": "De man die naast ons woont is arts."
            },
            {
              "ar": "المَرْأَةُ الَّتي قابَلْتُها أَمْسِ لَطيفَةٌ جِدًّا.",
              "tr": "al-marʾatu llatī qābaltuhā amsi laṭīfatun jiddan.",
              "nl": "De vrouw die ik gisteren ontmoette is erg aardig."
            },
            {
              "ar": "الطُّلّابُ الَّذينَ نَجَحوا سَعَداءُ.",
              "tr": "aṭ-ṭullābu llaḏīna najaḥū suʿadāʾ.",
              "nl": "De studenten die geslaagd zijn, zijn blij."
            },
            {
              "ar": "هٰذا هُوَ الكِتابُ الَّذي حَدَّثْتُكَ عَنْهُ.",
              "tr": "hāḏā huwa l-kitābu llaḏī ḥaddaṯtuka ʿanh.",
              "nl": "Dit is het boek waarover ik je vertelde."
            },
            {
              "ar": "أُحِبُّ النّاسَ الَّذينَ يَضْحَكونَ كَثيرًا.",
              "tr": "uḥibbu n-nāsa llaḏīna yaḍḥakūna kaṯīran.",
              "nl": "Ik houd van mensen die veel lachen."
            }
          ]
        },
        {
          "type": "letop",
          "md": "In {ar|الكِتابُ الَّذي حَدَّثْتُكَ عَنْهُ} hangt de ʿāʾid aan het voorzetsel: {ar|عَنْهُ} (*waarover*, letterlijk *over hem*). Zo vertaal je *waarin*, *waarmee*, *met wie* …"
        }
      ]
    }
  ],
