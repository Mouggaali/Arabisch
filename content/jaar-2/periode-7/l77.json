  "grammatica": [
    {
      "titel": "De bijzin na een onbepaald woord",
      "blokken": [
        {
          "type": "tekst",
          "md": [
            "Staat het hoofdwoord **onbepaald**, dan gebruik je **geen** {ar|الَّذي}: de bijzin volgt direct, als een bijvoeglijk naamwoord: {ar|أَبْحَثُ عَنْ شَقَّةٍ تَكونُ قَريبَةً مِنَ العَمَلِ} (ik zoek een appartement dat dicht bij het werk ligt).",
            "De ʿāʾid blijft wel nodig: {ar|بَيْتٌ سَكَنْتُ فيهِ} = een huis waarin ik woonde."
          ]
        },
        {
          "type": "tabel",
          "kop": [
            "Hoofdwoord",
            "Voorbeeld",
            "Betekenis"
          ],
          "rijen": [
            [
              "bepaald → الَّذي",
              "الشَّقَّةُ الَّتي رَأَيْتُها",
              "het appartement dat ik zag"
            ],
            [
              "onbepaald → niets",
              "شَقَّةٌ رَأَيْتُها",
              "een appartement dat ik zag"
            ]
          ],
          "arKolommen": [
            1
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom geen {ar|الَّذي}? {ar|الَّذي} bevat zelf het lidwoord ال en moet dus bij een **bepaald** woord staan, net zoals een bijvoeglijk naamwoord met ال alleen bij een bepaald woord past ({ar|البَيْتُ الكَبيرُ} tegenover {ar|بَيْتٌ كَبيرٌ})."
        }
      ]
    },
    {
      "titel": "ما en مَنْ als betrekkelijk voornaamwoord",
      "blokken": [
        {
          "type": "tekst",
          "md": "Zonder hoofdwoord gebruik je {ar|ما} (*wat*) en {ar|مَنْ} (*wie*): {ar|لَمْ أَفْهَمْ ما قالَ} (ik begreep niet wat hij zei), {ar|مَنْ يَسْكُنُ هُنا؟} kan ook een vraag zijn; de context beslist."
        },
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "أَبْحَثُ عَنْ شَقَّةٍ فيها شُرْفَةٌ.",
              "tr": "abḥaṯu ʿan šaqqatin fīhā šurfa.",
              "nl": "Ik zoek een appartement met (waarin is) een balkon."
            },
            {
              "ar": "وَجَدْنا بَيْتًا يَقَعُ قُرْبَ البَحْرِ.",
              "tr": "wajadnā baytan yaqaʿu qurba l-baḥr.",
              "nl": "We vonden een huis dat bij zee ligt."
            },
            {
              "ar": "الإيجارُ أَغْلى مِمّا تَوَقَّعْتُ.",
              "tr": "al-ījāru aġlā mimmā tawaqqaʿt.",
              "nl": "De huur is hoger dan ik verwachtte."
            },
            {
              "ar": "مَنْ يَبْحَثُ يَجِدْ.",
              "tr": "man yabḥaṯ yajid.",
              "nl": "Wie zoekt, die vindt.",
              "review": {
                "status": "onzeker",
                "note": "Voorwaardelijke majzūm (les 99); spreekwoordelijk."
              }
            },
            {
              "ar": "هَلْ هٰذا كُلُّ ما عِنْدَكُمْ؟",
              "tr": "hal hāḏā kullu mā ʿindakum?",
              "nl": "Is dit alles wat jullie hebben?"
            }
          ]
        },
        {
          "type": "letop",
          "md": "{ar|مِمّا} = {ar|مِنْ} + {ar|ما}: *dan wat*. Zo ook {ar|عَمّا} = {ar|عَنْ} + {ar|ما}."
        }
      ]
    }
  ],
