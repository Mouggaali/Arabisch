  "grammatica": [
    {
      "titel": "Vorm VI: تَفاعَلَ / يَتَفاعَلُ",
      "blokken": [
        {
          "type": "tekst",
          "md": [
            "Vorm VI = **تَـ + vorm III**: {ar|قابَلَ} (iemand ontmoeten) → {ar|تَقابَلَ} (elkaar ontmoeten).",
            "Muḍāriʿ: voorvoegsel met **a**, stam met **a**: {ar|يَتَقابَلُ}، {ar|نَتَبادَلُ}."
          ]
        },
        {
          "type": "tabel",
          "kop": [
            "Persoon",
            "Māḍī",
            "Muḍāriʿ"
          ],
          "arKolommen": [
            1,
            2
          ],
          "rijen": [
            [
              "wij",
              "تَقابَلْنا",
              "نَتَقابَلُ"
            ],
            [
              "jullie (m)",
              "تَقابَلْتُمْ",
              "تَتَقابَلونَ"
            ],
            [
              "zij (m mv)",
              "تَقابَلوا",
              "يَتَقابَلونَ"
            ],
            [
              "zij twee (m)",
              "تَقابَلا",
              "يَتَقابَلانِ"
            ]
          ]
        },
        {
          "type": "waarom",
          "md": "Vorm VI is **wederkerig**: de handeling gaat over en weer. Daarom staat het onderwerp bijna altijd in het **meervoud of de dualis**: twee of meer mensen die elkaar iets aandoen. {ar|قابَلْتُ سَميرًا} (ik ontmoette Samir) ↔ {ar|تَقابَلْنا} (we ontmoetten elkaar)."
        },
        {
          "type": "letop",
          "md": "Wil je met een werkwoord dat geen vorm VI heeft toch *elkaar* zeggen, gebruik dan {ar|بَعْضُهُمْ بَعْضًا}: {ar|يُساعِدُ بَعْضُهُمْ بَعْضًا} (ze helpen elkaar)."
        }
      ]
    },
    {
      "titel": "Hoe we elkaar leerden kennen",
      "blokken": [
        {
          "type": "tekst",
          "md": "**Maṣdar**: **تَفاعُل** ({ar|تَعارُفٌ}، {ar|تَعاوُنٌ}، {ar|تَفاهُمٌ}). **Deelwoord**: **مُتَفاعِل** (actief), **مُتَفاعَل** (passief: {ar|مُتَبادَلٌ})."
        },
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "تَقابَلْنا صُدْفَةً في حَفْلَةٍ عِنْدَ صَديقٍ.",
              "tr": "taqābalnā ṣudfatan fī ḥaflatin ʿinda ṣadīq.",
              "nl": "We ontmoetten elkaar toevallig op een feest bij een vriend."
            },
            {
              "ar": "تَبادَلْنا أَرْقامَ الهاتِفِ.",
              "tr": "tabādalnā arqāma l-hātif.",
              "nl": "We wisselden telefoonnummers uit."
            },
            {
              "ar": "ثُمَّ تَراسَلْنا كُلَّ يَوْمٍ.",
              "tr": "ṯumma tarāsalnā kulla yawm.",
              "nl": "Daarna stuurden we elkaar elke dag berichten."
            },
            {
              "ar": "بَيْنَنا تَفاهُمٌ كَبيرٌ.",
              "tr": "baynanā tafāhumun kabīr.",
              "nl": "Er is veel begrip tussen ons."
            },
            {
              "ar": "الاِحْتِرامُ المُتَبادَلُ أَساسُ الصَّداقَةِ.",
              "tr": "al-iḥtirāmu l-mutabādalu asāsu ṣ-ṣadāqa.",
              "nl": "Wederzijds respect is de basis van vriendschap."
            }
          ]
        }
      ]
    }
