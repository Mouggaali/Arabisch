  "grammatica": [
    {
      "titel": "De gebiedende wijs (vorm I)",
      "blokken": [
        {
          "type": "tekst",
          "md": [
            "Neem de **majzūm** van de 2e persoon en haal de {ar|تَـ} vooraan weg: {ar|تَكْتُبْ} → *ktub*. Omdat een Arabisch woord niet met twee medeklinkers kan beginnen, komt er een **alif** met een hulpklinker voor: {ar|اُكْتُبْ}.",
            "De hulpklinker volgt de stamklinker: is die **u**, dan **اُ**; is die **a** of **i**, dan **اِ**."
          ]
        },
        {
          "type": "tabel",
          "kop": [
            "Muḍāriʿ",
            "Stamklinker",
            "Gebiedende wijs (m)"
          ],
          "arKolommen": [
            0,
            2
          ],
          "rijen": [
            [
              "يَكْتُبُ",
              "u",
              "اُكْتُبْ|uktub"
            ],
            [
              "يَسْكُبُ",
              "u",
              "اُسْكُبْ|uskub"
            ],
            [
              "يَشْرَبُ",
              "a",
              "اِشْرَبْ|išrab"
            ],
            [
              "يَقْطَعُ",
              "a",
              "اِقْطَعْ|iqṭaʿ"
            ],
            [
              "يَجْلِسُ",
              "i",
              "اِجْلِسْ|ijlis"
            ],
            [
              "يَخْلِطُ",
              "i",
              "اِخْلِطْ|iḫliṭ"
            ]
          ]
        },
        {
          "type": "tabel",
          "kop": [
            "Tegen",
            "Vorm",
            "Uitgang"
          ],
          "arKolommen": [
            1
          ],
          "rijen": [
            [
              "een man",
              "اُكْتُبْ",
              "sukūn"
            ],
            [
              "een vrouw",
              "اُكْتُبي",
              "ـي"
            ],
            [
              "twee personen",
              "اُكْتُبا",
              "ـا"
            ],
            [
              "mannen / gemengd",
              "اُكْتُبوا",
              "ـوا (stille alif)"
            ],
            [
              "vrouwen",
              "اُكْتُبْنَ",
              "ـْنَ"
            ]
          ]
        },
        {
          "type": "waarom",
          "md": "De uitgangen zijn precies die van de majzūm ({ar|تَكْتُبي}، {ar|تَكْتُبوا} …). Ken je de majzūm, dan ken je de gebiedende wijs: alleen het begin verandert. Ontkennen gaat met de majzūm zelf: {ar|اُكْتُبْ} ↔ {ar|لا تَكْتُبْ}."
        },
        {
          "type": "letop",
          "md": "Recepten in kranten en op verpakkingen gebruiken vaak de **maṣdar** in plaats van de gebiedende wijs: {ar|تَقْطيعُ البَصَلِ} (*het snijden van de ui*). Herken die vorm; je leert de maṣdar van afgeleide vormen in les 60."
        }
      ]
    },
    {
      "titel": "Een recept: tomatensaus",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "اِغْسِلِ الطَّماطِمَ وَاقْطَعْها قِطَعًا صَغيرَةً.",
              "tr": "iġsili ṭ-ṭamāṭima wa-qṭaʿhā qiṭaʿan ṣaġīra.",
              "nl": "Was de tomaten en snijd ze in kleine stukjes."
            },
            {
              "ar": "اُسْكُبْ زَيْتَ الزَّيْتونِ في القِدْرِ.",
              "tr": "uskub zayta z-zaytūni fi l-qidr.",
              "nl": "Giet olijfolie in de pan."
            },
            {
              "ar": "اِخْلِطِ الطَّماطِمَ مَعَ الثّومِ وَالبَهاراتِ.",
              "tr": "iḫliṭi ṭ-ṭamāṭima maʿa ṯ-ṯūmi wa-l-bahārāt.",
              "nl": "Meng de tomaten met de knoflook en de specerijen."
            },
            {
              "ar": "اُطْبُخْها عَلى نارٍ هادِئَةٍ عِشْرينَ دَقيقَةً.",
              "tr": "uṭbuḫhā ʿalā nārin hādiʾatin ʿišrīna daqīqa.",
              "nl": "Laat het twintig minuten op laag vuur koken."
            },
            {
              "ar": "لا تَفْتَحِ الفُرْنَ قَبْلَ أَنْ يَنْضَجَ الخُبْزُ!",
              "tr": "lā taftaḥi l-furna qabla an yanḍaja l-ḫubz!",
              "nl": "Doe de oven niet open voordat het brood gaar is!"
            }
          ]
        }
      ]
    }
