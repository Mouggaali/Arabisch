  "grammatica": [
    {
      "titel": "Vorm III: فاعَلَ / يُفاعِلُ",
      "blokken": [
        { "type": "tekst", "md": [
          "Vorm III zet een **lange ā** na de eerste wortelletter: {ar|قَبِلَ} (aannemen) → {ar|قابَلَ} (ontmoeten).",
          "Muḍāriʿ: voorvoegsel met **u**, stam met **i**, net als in vorm II: {ar|يُقابِلُ}، {ar|أُساعِدُ}، {ar|نُشارِكُ}."
        ] },
        { "type": "waarom", "md": "Vorm III drukt vaak een handeling uit die **op een ander gericht is** of die je **met een ander** doet: {ar|كَتَبَ} (schrijven) → {ar|كاتَبَ} (corresponderen met); {ar|قَتَلَ} (doden) → {ar|قاتَلَ} (vechten tegen). Daarom heeft vorm III bijna altijd een lijdend voorwerp: je ontmoet *iemand*, je helpt *iemand*." },
        { "type": "tabel", "kop": ["Persoon", "Māḍī", "Muḍāriʿ"], "arKolommen": [1, 2], "rijen": [
          ["ik", "ساعَدْتُ", "أُساعِدُ"],
          ["jij (v)", "ساعَدْتِ", "تُساعِدينَ"],
          ["hij", "ساعَدَ", "يُساعِدُ"],
          ["wij", "ساعَدْنا", "نُساعِدُ"],
          ["zij (m mv)", "ساعَدوا", "يُساعِدونَ"]
        ] }
      ]
    },
    {
      "titel": "Maṣdar en deelwoord",
      "blokken": [
        { "type": "tekst", "md": "**Maṣdar**: meestal **مُفاعَلَة** ({ar|مُساعَدَةٌ}، {ar|مُشارَكَةٌ}، {ar|مُناقَشَةٌ}), soms **فِعال** ({ar|دِفاعٌ}). **Actief deelwoord**: **مُفاعِل** ({ar|مُهاجِمٌ}، {ar|مُدافِعٌ})." },
        { "type": "voorbeelden", "items": [
          { "ar": "شارَكَ فَريقُنا في البُطولَةِ.", "tr": "šāraka farīqunā fi l-buṭūla.", "nl": "Ons team deed mee aan het toernooi." },
          { "ar": "هاجَمَ المُهاجِمُ وَسَجَّلَ هَدَفًا في الشَّوْطِ الأَوَّلِ.", "tr": "hājama l-muhājimu wa-sajjala hadafan fi š-šawṭi l-awwal.", "nl": "De spits viel aan en scoorde in de eerste helft." },
          { "ar": "دافَعَ الفَريقُ جَيِّدًا، لٰكِنَّهُ خَسِرَ.", "tr": "dāfaʿa l-farīqu jayyidan, lākinnahu ḫasir.", "nl": "Het team verdedigde goed, maar verloor." },
          { "ar": "شُكْرًا عَلى مُساعَدَتِكَ!", "tr": "šukran ʿalā musāʿadatik!", "nl": "Bedankt voor je hulp!" },
          { "ar": "قابَلْتُ اللّاعِبَ بَعْدَ المُباراةِ.", "tr": "qābaltu l-lāʿiba baʿda l-mubārāh.", "nl": "Ik heb de speler na de wedstrijd ontmoet." }
        ] }
      ]
    }
  ],

