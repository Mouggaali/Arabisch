  "grammatica": [
    {
      "titel": "Uitroepen: ما أَفْعَلَ …!",
      "blokken": [
        {
          "type": "tekst",
          "md": [
            "Bewondering of verbazing uit je met {ar|ما} + **أَفْعَلَ** (met -a) + een naamwoord in de **accusatief**: {ar|ما أَجْمَلَ الحَفْلَةَ!} (wat een mooi feest!), {ar|ما أَطْيَبَ الطَّعامَ!} (wat is het eten lekker!).",
            "Een andere vaste uitroep: {ar|يا لَهُ مِنْ …!} + genitief: {ar|يا لَها مِنْ مُفاجَأَةٍ!} (wat een verrassing!)."
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom {ar|أَفْعَلَ} met -a en een accusatief erna? Het is oorspronkelijk een **werkwoord** van vorm IV: *wat heeft het feest mooi gemaakt!* Het woord na {ar|ما أَفْعَلَ} is dus een lijdend voorwerp. Het verschilt van de vergrotende trap {ar|أَجْمَلُ} (met -u)."
        },
        {
          "type": "letop",
          "md": "{ar|ما أَجْمَلَ} (uitroep) ≠ {ar|ما أَجْمَلُ؟} (vraag: wat is het mooiste?). Let op de eindklinker en de toon."
        }
      ]
    },
    {
      "titel": "Ja en jawel: نَعَمْ en بَلى",
      "blokken": [
        {
          "type": "tabel",
          "kop": [
            "Vraag",
            "Antwoord",
            "Betekenis"
          ],
          "rijen": [
            [
              "هَلْ سَتَأْتي؟ (kom je?)",
              "نَعَمْ",
              "ja, ik kom"
            ],
            [
              "أَلا تَأْتي؟ (kom je niet?)",
              "بَلى",
              "jawel, ik kom wél"
            ],
            [
              "أَلا تَأْتي؟",
              "نَعَمْ",
              "nee inderdaad, ik kom niet"
            ]
          ],
          "arKolommen": [
            0,
            1
          ]
        },
        {
          "type": "waarom",
          "md": "{ar|بَلى} spreekt een **ontkennende** vraag tegen, zoals het Nederlandse *jawel* of het Franse *si*. Met {ar|نَعَمْ} bevestig je juist de ontkenning."
        },
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "نَدْعوكُمْ إِلى حَفْلِ زِفافِ ابْنَتِنا.",
              "tr": "nadʿūkum ilā ḥafli zifāfi bnatinā.",
              "nl": "We nodigen jullie uit voor het huwelijksfeest van onze dochter."
            },
            {
              "ar": "بِكُلِّ سُرورٍ، سَنَأْتي!",
              "tr": "bi-kulli surūrin, sa-naʾtī!",
              "nl": "Met alle plezier, we komen!"
            },
            {
              "ar": "لِلْأَسَفِ، أَعْتَذِرُ عَنِ الحُضورِ.",
              "tr": "li-l-asaf, aʿtaḏiru ʿani l-ḥuḍūr.",
              "nl": "Helaas moet ik afzeggen."
            },
            {
              "ar": "ما أَطْيَبَ هٰذِهِ الكَعْكَةَ!",
              "tr": "mā aṭyaba hāḏihi l-kaʿka!",
              "nl": "Wat is deze taart lekker!"
            },
            {
              "ar": "أَلَمْ تَقْرَأِ الدَّعْوَةَ؟ — بَلى، قَرَأْتُها!",
              "tr": "a-lam taqraʾi d-daʿwa? — balā, qaraʾtuhā!",
              "nl": "Heb je de uitnodiging niet gelezen? — Jawel, ik heb hem gelezen!"
            }
          ]
        }
      ]
    }
  ],
