              "كُلُّ شَخْصٍ / كُلُّ النّاسِ",
              "ieder / alle"
            ],
            [
              "بَعْضُ",
              "+ bepaald mv",
              "بَعْضُ الطُّلّابِ",
              "sommige"
            ],
            [
              "جَميعُ",
              "+ bepaald mv",
              "جَميعُ الطُّلّابِ",
              "alle (allemaal)"
            ],
            [
              "مُعْظَمُ",
              "+ bepaald mv / ev",
              "مُعْظَمُ النّاسِ",
              "de meeste"
            ],
            [
              "كِلا / كِلْتا",
              "+ bepaalde dualis (genitief)",
              "كِلا الحِسابَيْنِ",
              "beide"
            ]
          ],
          "arKolommen": [
            2
          ]
        },
        {
          "type": "waarom",
          "md": "Al deze woorden zijn het **eerste lid van een iḍāfa**: het woord erna staat in de genitief. Ze krijgen zelf de naamval van hun plaats in de zin ({ar|دَفَعْتُ كُلَّ الدُّيونِ}: lijdend voorwerp → {ar|كُلَّ})."
        },
        {
          "type": "letop",
          "md": "{ar|كِلا} / {ar|كِلْتا} worden gevolgd door een **dualis in de genitief** ({ar|كِلا الحِسابَيْنِ}). Het werkwoord of gezegde erbij staat in het **enkelvoud**: {ar|كِلا الحِسابَيْنِ مَفْتوحٌ}."
        }
      ]
    },
    {
