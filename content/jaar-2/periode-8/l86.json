            {
              "ar": "لَنْ أَرْسُبَ هٰذِهِ المَرَّةَ!",
              "tr": "lan arsuba hāḏihi l-marra!",
              "nl": "Deze keer zak ik niet!"
            },
            {
              "ar": "الاِمْتِحانُ لَيْسَ صَعْبًا، لٰكِنَّهُ طَويلٌ.",
