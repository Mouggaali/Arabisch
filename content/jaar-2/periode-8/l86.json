  "grammatica": [
    {
      "titel": "Alle ontkenningen op een rij",
      "blokken": [
        {
          "type": "tabel",
          "kop": [
            "Ontkenning",
            "Wanneer",
            "Voorbeeld"
          ],
          "rijen": [
            [
              "لا + muḍāriʿ",
              "heden / algemeen",
              "لا أَفْهَمُ"
            ],
            [
              "لا + majzūm",
              "verbod",
              "لا تَتَأَخَّرْ"
            ],
            [
              "لَمْ + majzūm",
              "verleden (formeel)",
              "لَمْ أَفْهَمْ"
            ],
            [
              "ما + māḍī",
              "verleden (minder formeel)",
              "ما فَهِمْتُ"
            ],
            [
              "لَنْ + manṣūb",
              "toekomst",
              "لَنْ أَفْهَمَ"
            ],
            [
              "لَيْسَ + accusatief",
              "zin zonder werkwoord",
              "لَيْسَ صَعْبًا"
            ],
            [
              "غَيْرُ + genitief",
              "on-, niet- (bij naamwoord)",
              "غَيْرُ صَعْبٍ"
            ],
            [
              "لا + naamwoord (accusatief, zonder tanwīn)",
              "er is geen enkel …",
              "لا شَكَّ"
            ]
          ],
          "arKolommen": [
            0,
            2
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom zoveel? Elke ontkenning past bij een ander soort zin of tijd. De keuze hangt af van **twee vragen**: is er een werkwoord? En zo ja, welke tijd? Zonder werkwoord: {ar|لَيْسَ} of {ar|غَيْرُ}. Met werkwoord: {ar|لا} (heden), {ar|لَمْ}/{ar|ما} (verleden), {ar|لَنْ} (toekomst)."
        },
        {
          "type": "letop",
          "md": "{ar|غَيْرُ} staat altijd in een **iḍāfa**: {ar|غَيْرُ مُمْكِنٍ} (onmogelijk), {ar|طالِبٌ غَيْرُ مُجْتَهِدٍ} (een niet-ijverige student). {ar|غَيْرُ} zelf krijgt de naamval van het woord dat het vervangt."
        }
      ]
    },
    {
      "titel": "Onderwijs",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "التَّعْليمُ إِلْزامِيٌّ حَتّى سِنِّ السّادِسَةَ عَشْرَةَ.",
