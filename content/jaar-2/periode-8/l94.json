  "grammatica": [
    {
      "titel": "Een dialoog beluisteren",
      "blokken": [
        {
          "type": "tekst",
          "md": "Speel elke zin af en probeer hem eerst **zonder** de tekst te verstaan. Let op de werkwoordsvormen: ze verraden wie wat doet."
        },
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "أَحْمَدُ: هَلْ يُمْكِنُ أَنْ نُؤَجِّلَ الاِجْتِماعَ إِلى الغَدِ؟",
              "tr": "aḥmadu: hal yumkinu an nuʾajjila l-ijtimāʿa ila l-ġad?",
              "nl": "Ahmed: Kunnen we de vergadering uitstellen tot morgen?"
            },
            {
              "ar": "سَلْمى: لا بَأْسَ. في الحَقيقَةِ أَنا مَشْغولَةٌ اليَوْمَ.",
              "tr": "salmā: lā baʾsa. fi l-ḥaqīqati ana mašġūlatun al-yawm.",
              "nl": "Salma: Geen probleem. Eigenlijk heb ik het vandaag druk."
            },
            {
              "ar": "أَحْمَدُ: أَقْتَرِحُ السّاعَةَ العاشِرَةَ صَباحًا.",
              "tr": "aḥmadu: aqtariḥu s-sāʿata l-ʿāširata ṣabāḥan.",
              "nl": "Ahmed: Ik stel tien uur 's ochtends voor."
            },
            {
              "ar": "سَلْمى: أُوافِقُ. عَلى فِكْرَةٍ، هَلْ أَلْغَيْتَ الحَجْزَ في المَطْعَمِ؟",
              "tr": "salmā: uwāfiqu. ʿalā fikratin, hal alġayta l-ḥajza fi l-maṭʿam?",
              "nl": "Salma: Akkoord. Trouwens, heb je de reservering in het restaurant geannuleerd?"
            },
            {
              "ar": "أَحْمَدُ: بِالتَّأْكيدِ، تَأَكَّدْتُ مِنْ ذٰلِكَ أَمْسِ.",
              "tr": "aḥmadu: bi-t-taʾkīd, taʾakkadtu min ḏālika ams.",
              "nl": "Ahmed: Zeker, dat heb ik gisteren gecontroleerd."
            }
          ]
        },
