  "grammatica": [
    {
      "titel": "Gebiedende wijs van afgeleide vormen",
      "blokken": [
        {
          "type": "tabel",
          "kop": [
            "Vorm",
            "Muḍāriʿ",
            "Gebiedende wijs (m)",
            "Betekenis"
          ],
          "rijen": [
            [
              "II",
              "تُفَتِّشُ",
              "فَتِّشْ",
              "controleer!"
            ],
            [
              "III",
              "تُساعِدُ",
              "ساعِدْ",
              "help!"
            ],
            [
              "IV",
              "تُرْسِلُ",
              "أَرْسِلْ",
              "stuur!"
            ],
            [
              "V",
              "تَتَفَضَّلُ",
              "تَفَضَّلْ",
              "alstublieft / kom binnen"
            ],
            [
              "VIII",
              "تَنْتَظِرُ",
              "اِنْتَظِرْ",
              "wacht!"
            ],
            [
              "X",
              "تَسْتَعْمِلُ",
              "اِسْتَعْمِلْ",
              "gebruik!"
            ]
          ],
          "arKolommen": [
            1,
            2
          ]
        },
        {
          "type": "waarom",
          "md": "Dezelfde regel als bij vorm I: neem de majzūm van de jij-vorm en haal {ar|تُـ / تَـ} weg. Begint wat overblijft met een klinker of een stam die uitspreekbaar is (II, III, V), dan is er geen hulpalif. Vorm IV krijgt de hamza {ar|أَ} terug ({ar|أَرْسِلْ}); vorm VII–X krijgen {ar|اِ}."
        },
        {
          "type": "letop",
          "md": "Zwakke werkwoorden verkorten: {ar|قُلْ} (zeg), {ar|نَمْ} (slaap), {ar|اِمْشِ} (loop), {ar|خُذْ} (neem), {ar|قِفْ} (stop). {ar|تَعالَ} (kom) is een vaste, onregelmatige vorm."
        }
      ]
    },
    {
      "titel": "Op het vliegveld",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "تَفَضَّلْ، أَرِني جَوازَ السَّفَرِ مِنْ فَضْلِكَ.",
              "tr": "tafaḍḍal, arinī jawāza s-safari min faḍlik.",
              "nl": "Alstublieft, laat me uw paspoort zien."
            },
            {
              "ar": "ضَعْ أَمْتِعَتَكَ هُنا وَانْتَظِرْ.",
              "tr": "ḍaʿ amtiʿataka hunā wa-ntaẓir.",
              "nl": "Zet uw bagage hier en wacht."
            },
            {
              "ar": "اِسْتَعْمِلْ هٰذا الكيسَ لِلسَّوائِلِ.",
              "tr": "istaʿmil hāḏa l-kīsa li-s-sawāʾil.",
              "nl": "Gebruik dit zakje voor vloeistoffen."
            },
            {
              "ar": "تَعالَوْا، الطّائِرَةُ جاهِزَةٌ!",
              "tr": "taʿālaw, aṭ-ṭāʾiratu jāhiza!",
              "nl": "Kom, het vliegtuig is klaar!"
            },
            {
              "ar": "لا تَنْسَ بِطاقَةَ الصُّعودِ!",
              "tr": "lā tansa biṭāqata ṣ-ṣuʿūd!",
              "nl": "Vergeet je instapkaart niet!"
            }
          ]
        }
      ]
    }
