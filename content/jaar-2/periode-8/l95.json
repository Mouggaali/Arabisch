        {
          "type": "waarom",
          "md": "Een Arabische betoogtekst lijkt op een Nederlandse: standpunt, argumenten, tegenargument, conclusie. De **verbindingswoorden** maken de structuur zichtbaar. Gebruik er genoeg; een tekst zonder {ar|لِذٰلِكَ} en {ar|مَعَ ذٰلِكَ} leest als een rijtje losse zinnen."
        }
      ]
    },
    {
      "titel": "Voorbeeldtekst: thuiswerken",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "في رَأْيي، لِلْعَمَلِ عَنْ بُعْدٍ فَوائِدُ كَثيرَةٌ.",
              "tr": "fī raʾyī, li-l-ʿamali ʿan buʿdin fawāʾidu kaṯīra.",
              "nl": "Naar mijn mening heeft thuiswerken veel voordelen."
            },
            {
              "ar": "أَوَّلًا، نُوَفِّرُ الوَقْتَ وَالمالَ.",
              "tr": "awwalan, nuwaffiru l-waqta wa-l-māl.",
              "nl": "Ten eerste besparen we tijd en geld."
            },
            {
              "ar": "ثانِيًا، نَسْتَطيعُ أَنْ نُنَظِّمَ يَوْمَنا بِحُرِّيَّةٍ.",
              "tr": "ṯāniyan, nastaṭīʿu an nunaẓẓima yawmanā bi-ḥurriyya.",
              "nl": "Ten tweede kunnen we onze dag vrij indelen."
            },
            {
              "ar": "مَعَ ذٰلِكَ، لِلْعَمَلِ عَنْ بُعْدٍ عُيوبٌ، مِثْلُ الوَحْدَةِ.",
              "tr": "maʿa ḏālika, li-l-ʿamali ʿan buʿdin ʿuyūbun, miṯlu l-waḥda.",
              "nl": "Toch heeft thuiswerken ook nadelen, zoals eenzaamheid."
            },
            {
              "ar": "لِذٰلِكَ أَقْتَرِحُ يَوْمَيْنِ في المَكْتَبِ وَثَلاثَةَ أَيّامٍ في البَيْتِ.",
              "tr": "li-ḏālika aqtariḥu yawmayni fi l-maktabi wa-ṯalāṯata ayyāmin fi l-bayt.",
              "nl": "Daarom stel ik twee dagen op kantoor en drie dagen thuis voor."
            }
          ]
        },
        {
          "type": "letop",
          "md": "{ar|لِلْعَمَلِ … فَوائِدُ} = *het werk heeft voordelen* (letterlijk: voor het werk zijn er voordelen). Het onderwerp {ar|فَوائِدُ} staat achteraan omdat het onbepaald is; de bepaling met {ar|لِـ} staat vooraan."
        }
      ]
    }
