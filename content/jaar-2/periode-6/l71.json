  "grammatica": [
    {
      "titel": "Assimilerende werkwoorden: و vooraan",
      "blokken": [
        {
          "type": "tekst",
          "md": [
            "Begint de wortel met **و** en heeft de muḍāriʿ een **i**, dan valt de و in de muḍāriʿ weg: {ar|وَصَلَ} → {ar|يَصِلُ}، {ar|وَجَدَ} → {ar|يَجِدُ}.",
            "De māḍī is gewoon regelmatig ({ar|وَصَلْتُ}). De gebiedende wijs is heel kort: {ar|صِلْ}، {ar|قِفْ}، {ar|ضَعْ}."
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom valt de و weg? In *yawṣilu* vormt de و samen met de a een tweeklank die in deze positie wegvalt. Daardoor lijkt {ar|يَصِلُ} een tweeletterig werkwoord. Ken je deze werkwoorden, dan begrijp je ook {ar|صِلَةٌ} (verbinding) en {ar|جِهَةٌ} (kant)."
        }
      ]
    },
    {
      "titel": "Verdubbelde werkwoorden: 2e = 3e letter",
      "blokken": [
        {
          "type": "tabel",
          "kop": [
            "Persoon",
            "Māḍī",
            "Muḍāriʿ"
          ],
          "arKolommen": [
            1,
            2
          ],
          "rijen": [
            [
              "hij",
              "مَرَّ",
              "يَمُرُّ"
            ],
            [
              "zij (ev)",
              "مَرَّتْ",
              "تَمُرُّ"
            ],
            [
              "zij (m mv)",
              "مَرّوا",
              "يَمُرّونَ"
            ],
            [
              "ik",
              "مَرَرْتُ",
              "أَمُرُّ"
            ],
            [
              "wij",
              "مَرَرْنا",
              "نَمُرُّ"
            ],
            [
              "zij (v mv)",
              "مَرَرْنَ",
              "يَمْرُرْنَ"
            ]
          ]
        },
        {
          "type": "waarom",
          "md": "Bij een **klinker-uitgang** smelten de twee gelijke letters samen tot één met shadda ({ar|مَرَّ}، {ar|مَرّوا}). Bij een **medeklinker-uitgang** kan dat niet, en komen ze weer los ({ar|مَرَرْتُ}). Hetzelfde patroon zag je al bij {ar|ظَلَّ} → {ar|ظَلِلْتُ}."
        },
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "وَصَلَتِ الطّائِرَةُ مُتَأَخِّرَةً.",
              "tr": "waṣalati ṭ-ṭāʾiratu mutaʾaḫḫira.",
              "nl": "Het vliegtuig kwam te laat aan."
            },
            {
              "ar": "لَمْ أَجِدْ حَقيبَتي!",
              "tr": "lam ajid ḥaqībatī!",
              "nl": "Ik heb mijn koffer niet gevonden!"
            },
            {
              "ar": "مَرَرْنا بِالجَمارِكِ بِسُرْعَةٍ.",
              "tr": "mararnā bi-l-jamāriki bi-surʿa.",
              "nl": "We kwamen snel door de douane."
            },
            {
              "ar": "ضَعْ أَمْتِعَتَكَ هُنا، مِنْ فَضْلِكَ.",
              "tr": "ḍaʿ amtiʿataka hunā, min faḍlik.",
              "nl": "Zet uw bagage hier, alstublieft."
            },
            {
              "ar": "وَعَدْتُكَ أَنْ أَزورَكَ.",
              "tr": "waʿadtuka an azūrak.",
              "nl": "Ik heb je beloofd je te bezoeken."
            }
          ]
        }
      ]
    }
