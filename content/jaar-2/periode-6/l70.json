  "grammatica": [
    {
      "titel": "Drie typen defectieve werkwoorden",
      "blokken": [
        {
          "type": "tekst",
          "md": "Bij een **defectief** werkwoord is de **laatste** wortelletter een و of ي. Die letter verschijnt als lange klinker (ā, ī, ū) of verdwijnt. Er zijn drie hoofdtypen."
        },
        {
          "type": "tabel",
          "kop": [
            "Persoon",
            "مَشى / يَمْشي",
            "دَعا / يَدْعو",
            "نَسِيَ / يَنْسى"
          ],
          "arKolommen": [
            1,
            2,
            3
          ],
          "rijen": [
            [
              "hij (māḍī)",
              "مَشى",
              "دَعا",
              "نَسِيَ"
            ],
            [
              "zij (ev)",
              "مَشَتْ",
              "دَعَتْ",
              "نَسِيَتْ"
            ],
            [
              "ik",
              "مَشَيْتُ",
              "دَعَوْتُ",
              "نَسيتُ"
            ],
            [
              "zij (m mv)",
              "مَشَوْا",
              "دَعَوْا",
              "نَسُوا"
            ],
            [
              "hij (muḍāriʿ)",
              "يَمْشي",
              "يَدْعو",
              "يَنْسى"
            ],
            [
              "zij (m mv)",
              "يَمْشونَ",
              "يَدْعونَ",
              "يَنْسَوْنَ"
            ],
            [
              "na لَمْ (hij)",
              "لَمْ يَمْشِ",
              "لَمْ يَدْعُ",
              "لَمْ يَنْسَ"
            ],
            [
              "gebiedende wijs",
              "اِمْشِ",
              "اُدْعُ",
              "اِنْسَ"
            ]
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom verdwijnt de laatste letter? De zwakke و/ي versmelt met de klinker ervoor tot een lange klinker ({ar|يَمْشي}). In de majzūm wordt die lange klinker **kort** in plaats van dat er een sukūn komt: {ar|يَمْشي} → {ar|لَمْ يَمْشِ}. Dat is precies de 'verkorting' die je ook bij holle werkwoorden zag."
        },
        {
          "type": "letop",
          "md": "Herken het type aan de muḍāriʿ: **-ī** ({ar|يَمْشي}), **-ū** ({ar|يَدْعو}) of **-ā** ({ar|يَنْسى}). De māḍī op **-ā** schrijf je met ى als de wortel op ي eindigt ({ar|مَشى}) en met ا als hij op و eindigt ({ar|دَعا})."
        }
      ]
    },
    {
      "titel": "Gevoelens",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "بَكَتِ الطِّفْلَةُ ثُمَّ ضَحِكَتْ.",
              "tr": "bakati ṭ-ṭiflatu ṯumma ḍaḥikat.",
              "nl": "Het meisje huilde en lachte toen."
            },
            {
              "ar": "دَعَوْنا أَصْدِقاءَنا إِلى العَشاءِ.",
              "tr": "daʿawnā aṣdiqāʾanā ila l-ʿašāʾ.",
              "nl": "We hebben onze vrienden uitgenodigd voor het avondeten."
            },
            {
              "ar": "لا تَنْسَ أَنْ تَتَّصِلَ بِأُمِّكَ!",
              "tr": "lā tansa an tattaṣila bi-ummik!",
              "nl": "Vergeet niet je moeder te bellen!"
            },
            {
              "ar": "كانَ بَيْنَهُما خِلافٌ، لٰكِنَّهُما تَصالَحا.",
              "tr": "kāna baynahumā ḫilāfun, lākinnahumā taṣālaḥā.",
              "nl": "Ze hadden ruzie, maar ze hebben het bijgelegd."
            },
            {
              "ar": "أَشْتاقُ إِلى عائِلَتي في المَغْرِبِ.",
              "tr": "aštāqu ilā ʿāʾilatī fi l-Maġrib.",
              "nl": "Ik mis mijn familie in Marokko."
            }
          ]
        }
      ]
    }
