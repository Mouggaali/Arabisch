  "grammatica": [
    {
      "titel": "Kāna en zusters",
      "blokken": [
        {
          "type": "tekst",
          "md": "Een groep werkwoorden gedraagt zich als {ar|كانَ}: het onderwerp blijft **marfūʿ** (-u), het gezegde wordt **manṣūb** (-a). Ze voegen een tijd, verandering of duur toe aan een nominale zin."
        },
        {
          "type": "tabel",
          "kop": [
            "Werkwoord",
            "Betekenis",
            "Voorbeeld"
          ],
          "arKolommen": [
            0,
            2
          ],
          "rijen": [
            [
              "كانَ",
              "was",
              "كانَ الجَوُّ بارِدًا.|kāna l-jawwu bāridan."
            ],
            [
              "أَصْبَحَ",
              "werd (vooral: 's ochtends, of plots)",
              "أَصْبَحَ الطَّريقُ مُزْدَحِمًا.|aṣbaḥa ṭ-ṭarīqu muzdaḥiman."
            ],
            [
              "صارَ",
              "werd (geleidelijk)",
              "صارَتِ المَدينَةُ كَبيرَةً.|ṣārati l-madīnatu kabīra."
            ],
            [
              "لَيْسَ",
              "is niet",
              "لَيْسَ البَيْتُ قَديمًا.|laysa l-baytu qadīman."
            ],
            [
              "ما زالَ",
              "is nog steeds",
              "ما زالَ جَدّي نَشيطًا.|mā zāla jaddī našīṭan."
            ],
            [
              "ظَلَّ",
              "bleef (de hele tijd)",
              "ظَلَّ الجَوُّ حارًّا طولَ اليَوْمِ.|ẓalla l-jawwu ḥārran ṭūla l-yawm."
            ]
          ]
        },
        {
          "type": "waarom",
          "md": "Waarom accusatief? Je kent het al van {ar|كانَ} (les 28): deze werkwoorden zijn 'onvolledig' (*nāqiṣ*); ze hebben een gezegde nodig om de zin af te maken, en dat gezegde staat in de accusatief, net als een lijdend voorwerp. Zo zie je meteen welk woord het gezegde is."
        },
        {
          "type": "letop",
          "md": "{ar|ما زالَ} is een ontkenning (*ما*) + *ophouden*: letterlijk *hij hield niet op*. Daarom betekent het **nog steeds**. In de muḍāriʿ: {ar|لا يَزالُ}."
        }
      ]
    },
    {
      "titel": "Vroeger en nu",
      "blokken": [
        {
          "type": "voorbeelden",
          "items": [
            {
              "ar": "في الماضي كانَتْ قَرْيَتُنا فَقيرَةً.",
              "tr": "fi l-māḍī kānat qaryatunā faqīra.",
              "nl": "Vroeger was ons dorp arm."
            },
            {
              "ar": "حالِيًّا صارَتْ مُزْدَهِرَةً.",
              "tr": "ḥāliyyan ṣārat muzdahira.",
              "nl": "Nu is het welvarend geworden."
            },
            {
              "ar": "تَغَيَّرَ كُلُّ شَيْءٍ، لٰكِنَّ السّوقَ ما زالَ تَقْليدِيًّا.",
              "tr": "taġayyara kullu šayʾ, lākinna s-sūqa mā zāla taqlīdiyyan.",
              "nl": "Alles is veranderd, maar de markt is nog steeds traditioneel."
            },
            {
              "ar": "ظَلَّ جَدّي في الرّيفِ طولَ حَياتِهِ.",
              "tr": "ẓalla jaddī fi r-rīfi ṭūla ḥayātih.",
              "nl": "Mijn opa bleef zijn hele leven op het platteland."
            },
            {
              "ar": "عِنْدي حَنينٌ إِلى أَيّامِ الطُّفولَةِ.",
              "tr": "ʿindī ḥanīnun ilā ayyāmi ṭ-ṭufūla.",
              "nl": "Ik verlang terug naar mijn kindertijd."
            }
          ]
        }
      ]
    }
  ],
